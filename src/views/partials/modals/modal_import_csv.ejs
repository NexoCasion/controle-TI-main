<div class="modal fade" id="modalImportCsv" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-body">
        <div class="modal-form-shell text-center">
            <div class="d-flex align-items-center justify-content-start mb-4">
              <button type="button" class="btn btn-back" data-bs-dismiss="modal" aria-label="Fechar">
                <i class="fas fa-arrow-left"></i>
              </button>
              <div class="mx-auto text-center">
                <h2 class="card-title mb-1">Importar Computador Estruturado</h2>
                <small class="text-muted">Processador, memória e armazenamento serão lançados como materiais em uso.</small>
              </div>
            </div>

            <div class="alert alert-light border text-start mb-4">
              <strong>Padrão do arquivo:</strong> <code>patrimonio-setor.csv</code> ou <code>patrimonio-setor-fonte.csv</code><br>
              <small class="text-muted">Exemplos: <code>0003-TESTESETOR.csv</code> ou <code>0003-TESTESETOR-ATX250W.csv</code>. A empresa continua vindo do campo abaixo.</small>
            </div>

            <div class="alert import-download-alert text-start mb-4">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <strong>Precisa gerar o CSV?</strong><br>
                  <small>Baixe a ferramenta de inventario para gerar o arquivo antes da importacao.</small>
                </div>
                <a class="btn btn-primary btn-sm" href="/downloads/Inventario2.0.exe" download>
                  Baixar Inventario 2.0
                </a>
              </div>
            </div>

            <form action="/importar-csv" method="post" enctype="multipart/form-data">
              <div class="row g-3">
                <div class="col-12">
                  <label for="empresaImport" class="form-label">Empresa</label>
                  <select class="form-select" name="empresaId" id="empresaImport" required>
                    <% (empresas || []).forEach(function(empresa) { %>
                    <option value="<%= empresa.id %>"><%= empresa.nome %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-12">
                  <label for="csvFileModal" class="form-label">Arquivo CSV do HWiNFO</label>
                  <input type="file" class="form-control" name="csvFile" id="csvFileModal" accept=".csv" required>
                </div>

                <div class="col-12">
                  <label for="fonteImport" class="form-label">Indique a fonte da maquina</label>
                  <input type="text" class="form-control" name="fonte" id="fonteImport" placeholder="Ex: ATX 500W, Micro ATX 300W ou Dell proprietaria">
                  <small class="text-muted">Opcional. Se a fonte vier no nome do arquivo, este campo pode ficar em branco.</small>
                </div>

                <div class="col-12">
                  <div class="small text-muted">
                    O sistema vai:
                    1. criar o computador com patrimônio e setor pelo nome do arquivo
                    2. marcar a máquina como estruturada
                    3. registrar CPU, memória, armazenamento e fonte como materiais em uso quando informados
                  </div>
                </div>
              </div>

              <hr class="my-4">

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-switch-from="modalImportCsv" data-switch-to="modalRegisterStructuredPc">
                  Cadastro manual
                </button>
                <button type="submit" class="btn btn-primary px-4">Importar</button>
              </div>
            </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__switchBootstrapModal = window.__switchBootstrapModal || function(fromId, toId, beforeOpen) {
    const fromEl = document.getElementById(fromId);
    const toEl = document.getElementById(toId);
    if (!fromEl || !toEl || !window.bootstrap) return;

    const fromInst = bootstrap.Modal.getInstance(fromEl) || new bootstrap.Modal(fromEl);
    const toInst = bootstrap.Modal.getOrCreateInstance(toEl);

    fromEl.addEventListener('hidden.bs.modal', function() {
      if (typeof beforeOpen === 'function') beforeOpen();
      toInst.show();
    }, { once: true });

    fromInst.hide();
  };

  document.addEventListener('click', function(ev) {
    const btn = ev.target.closest('[data-switch-from][data-switch-to]');
    if (!btn) return;
    window.__switchBootstrapModal(btn.getAttribute('data-switch-from'), btn.getAttribute('data-switch-to'));
  });
</script>
