<%
  const _maintenanceDescriptionTemplates =
    Array.isArray(maintenanceDescriptionTemplates)
      ? maintenanceDescriptionTemplates
          .map((item) => String(item || '').trim())
          .filter(Boolean)
      : [
          'Limpeza preventiva',
          'Erro de funcionamento',
          'Lentidao ou travamento',
          'Maquina sem ligar',
          'Formatacao ou reinstalacao do sistema',
          'Sem acesso a rede ou internet',
        ];
%>

<div class="modal fade" id="modalRegisterManutencao" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex align-items-center gap-3 w-100">
          <button type="button" class="btn btn-back" data-bs-dismiss="modal" aria-label="Fechar">
            <i class="fas fa-arrow-left"></i>
          </button>
          <h5 class="modal-title mb-0">Cadastro de Manutencao</h5>
        </div>
      </div>

      <div class="modal-body">
        <div class="alert alert-warning d-none" id="manutencaoModalAlert" role="alert"></div>

        <form id="manutencaoFormModal" action="/register-manutencao" method="post">
          <div class="mb-3">
            <label for="empresaModal" class="form-label">Selecione a Empresa</label>
            <select class="form-control" id="empresaModal" name="empresa">
              <option value="" selected disabled>Selecione a Empresa</option>
            </select>
          </div>

          <div class="mb-3 d-none" id="computadorGroupModal">
            <label for="computadorFiltroModal" class="form-label">Selecione o Computador</label>
            <input type="hidden" id="computadorModal" name="computadorId">
            <div class="position-relative manutencao-autocomplete-shell">
              <input
                type="search"
                class="form-control manutencao-autocomplete-input"
                id="computadorFiltroModal"
                placeholder="Pesquisar por ID, patrimonio ou setor"
                autocomplete="off">
              <div
                class="list-group position-absolute w-100 shadow-sm d-none manutencao-autocomplete-menu"
                id="computadorSugestoesModal"
                style="z-index: 1057; max-height: 260px; overflow-y: auto;">
              </div>
            </div>
            <small class="text-muted d-block mt-2" id="computadorResumoModal">Selecione uma empresa para carregar as maquinas.</small>
          </div>

          <div class="mb-3">
            <label for="descricaoPresetModal" class="form-label">Descricao pronta</label>
            <select class="form-control" id="descricaoPresetModal">
              <option value="" selected>Selecionar sugestao...</option>
              <% _maintenanceDescriptionTemplates.forEach(function(item) { %>
              <option value="<%= item %>"><%= item %></option>
              <% }) %>
            </select>
            <small class="text-muted d-block mt-2">
              Ao selecionar uma opcao, o campo descricao abaixo sera preenchido e podera ser ajustado.
            </small>
          </div>

          <div class="mb-0">
            <label for="descricaoModal" class="form-label">Descricao</label>
            <textarea id="descricaoModal" placeholder="Informe a queixa do usuario e as suspeitas do problema" class="form-control" rows="10" name="descricao" required></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" form="manutencaoFormModal" class="btn btn-primary">Enviar</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modalEl = document.getElementById("modalRegisterManutencao");
    const empresaSelect = document.getElementById("empresaModal");
    const computadorInput = document.getElementById("computadorModal");
    const computadorFiltro = document.getElementById("computadorFiltroModal");
    const computadorSugestoes = document.getElementById("computadorSugestoesModal");
    const computadorResumo = document.getElementById("computadorResumoModal");
    const computadorGroup = document.getElementById("computadorGroupModal");
    const alertBox = document.getElementById("manutencaoModalAlert");
    const descricaoPresetSelect = document.getElementById("descricaoPresetModal");
    const descricaoTextarea = document.getElementById("descricaoModal");
    const form = document.getElementById("manutencaoFormModal");

    if (
      !modalEl ||
      !empresaSelect ||
      !computadorInput ||
      !computadorFiltro ||
      !computadorSugestoes ||
      !computadorResumo ||
      !computadorGroup ||
      !alertBox ||
      !descricaoPresetSelect ||
      !descricaoTextarea ||
      !form
    ) return;

    if (modalEl.dataset.enhanced === "true") return;
    modalEl.dataset.enhanced = "true";

    let computadoresEmManutencao = new Set();
    let computadoresDisponiveis = [];
    let computadoresFiltrados = [];
    let highlightedIndex = -1;

    function showAlert(message) {
      alertBox.textContent = message;
      alertBox.classList.remove("d-none");
    }

    function hideAlert() {
      alertBox.textContent = "";
      alertBox.classList.add("d-none");
    }

    function resetComputadores() {
      computadoresFiltrados = [];
      highlightedIndex = -1;
      computadorInput.value = "";
      computadorResumo.textContent = "Selecione uma empresa para carregar as maquinas.";
      computadorSugestoes.innerHTML = "";
      computadorSugestoes.classList.add("d-none");
    }

    function resetEmpresas() {
      empresaSelect.innerHTML = "";
      empresaSelect.append(new Option("Selecione a Empresa", "", true, true));
      empresaSelect.options[0].disabled = true;
    }

    function showComputadorGroup(show) {
      computadorGroup.classList.toggle("d-none", !show);
    }

    function aplicarDescricaoPreset() {
      const valor = String(descricaoPresetSelect.value || "").trim();
      if (!valor) return;

      descricaoTextarea.value = valor;
      descricaoTextarea.focus();
      descricaoTextarea.setSelectionRange(descricaoTextarea.value.length, descricaoTextarea.value.length);
    }

    function formatarTextoComputador(computador) {
      return [
        computador.id,
        computador.patrimonio || "-",
        computador.setor || "-",
      ].join(" - ");
    }

    function atualizarResumo(total, visiveis) {
      computadorResumo.textContent = `${visiveis} de ${total} computadores disponiveis para manutencao.`;
    }

    function atualizarSelecao(computador = null, updateSearch = false) {
      computadorInput.value = computador ? String(computador.id) : "";

      if (computador && updateSearch) {
        computadorFiltro.value = formatarTextoComputador(computador);
      }
    }

    function hideSugestoes() {
      computadorSugestoes.classList.add("d-none");
    }

    function selecionarComputador(computador, updateSearch = true) {
      atualizarSelecao(computador, updateSearch);
      hideSugestoes();
      highlightedIndex = -1;
    }

    function renderSugestoes() {
      computadorSugestoes.innerHTML = "";

      if (!computadoresFiltrados.length) {
        hideSugestoes();
        return;
      }

      computadoresFiltrados.forEach((computador, index) => {
        const item = document.createElement("button");
        item.type = "button";
        item.className = `list-group-item list-group-item-action${index === highlightedIndex ? " active" : ""}`;
        item.textContent = formatarTextoComputador(computador);
        item.addEventListener("mousedown", (event) => {
          event.preventDefault();
          selecionarComputador(computador);
        });
        computadorSugestoes.appendChild(item);
      });

      computadorSugestoes.classList.remove("d-none");
    }

    function preencherComputadores(lista, pref = null) {
      const termo = String(computadorFiltro.value || "").trim().toLowerCase();
      const disponiveis = (lista || []).filter((computador) => !computadoresEmManutencao.has(Number(computador.id)));

      computadoresFiltrados = !termo
        ? disponiveis
        : disponiveis.filter((computador) =>
            formatarTextoComputador(computador).toLowerCase().includes(termo)
          );

      highlightedIndex = computadoresFiltrados.length ? 0 : -1;
      atualizarResumo(disponiveis.length, computadoresFiltrados.length);

      if (!computadoresFiltrados.length) {
        atualizarSelecao(null);
        computadorResumo.textContent = disponiveis.length
          ? "Nenhuma maquina encontrada com esse filtro."
          : "Nenhuma maquina disponivel para nova manutencao.";
        hideSugestoes();
      } else {
        renderSugestoes();
      }

      if (pref && pref.computadorId !== undefined && pref.computadorId !== null && pref.computadorId !== "") {
        const idPreferido = Number(pref.computadorId);
        if (computadoresEmManutencao.has(idPreferido)) {
          showAlert("Este computador ja possui uma manutencao em aberto. Feche a manutencao atual antes de abrir outra.");
        } else {
          const computadorPreferido =
            disponiveis.find((computador) => Number(computador.id) === idPreferido) ||
            null;

          if (computadorPreferido) {
            selecionarComputador(computadorPreferido, true);
          }
        }
        window.__prefManutencao = null;
      }

      showComputadorGroup(true);
    }

    async function getJson(url) {
      const response = await fetch(url, {
        headers: { Accept: "application/json" },
        credentials: "same-origin",
      });

      if (!response.ok) {
        throw new Error("Falha ao carregar dados do formulario de manutencao.");
      }

      return response.json();
    }

    async function carregarComputadoresDisponiveis(empresaId, pref = null) {
      resetComputadores();

      if (empresaId === undefined || empresaId === null || empresaId === "") {
        showComputadorGroup(false);
        return;
      }

      computadorResumo.textContent = "Carregando computadores...";

      const [resultado, manutencoesAbertas] = await Promise.all([
        getJson(`/computadores-by-empresa?empresaId=${encodeURIComponent(empresaId)}&limit=all&sortBy=patrimonio&sortDir=ASC`),
        getJson("/manutencoes-open"),
      ]);

      const lista = Array.isArray(resultado?.rows) ? resultado.rows : (Array.isArray(resultado) ? resultado : []);
      const manutencoes = Array.isArray(manutencoesAbertas) ? manutencoesAbertas : [];

      computadoresEmManutencao = new Set(
        manutencoes
          .map((manutencao) => Number(manutencao.computadorId))
          .filter((id) => Number.isFinite(id))
      );

      computadoresDisponiveis = lista;
      preencherComputadores(computadoresDisponiveis, pref);
    }

    async function carregarEmpresas(pref = null) {
      resetEmpresas();
      const empresas = await getJson("/get-empresas");

      (Array.isArray(empresas) ? empresas : []).forEach((empresa) => {
        empresaSelect.append(new Option(empresa.nome, String(empresa.id)));
      });

      if (pref && pref.empresaId !== undefined && pref.empresaId !== null && pref.empresaId !== "") {
        empresaSelect.value = String(pref.empresaId);
        await carregarComputadoresDisponiveis(pref.empresaId, pref);
      } else {
        showComputadorGroup(false);
      }
    }

    empresaSelect.addEventListener("change", async () => {
      hideAlert();
      computadorFiltro.value = "";
      try {
        await carregarComputadoresDisponiveis(empresaSelect.value);
      } catch (error) {
        showAlert(error.message || "Erro ao carregar os computadores disponiveis.");
        showComputadorGroup(false);
      }
    });

    computadorFiltro.addEventListener("input", () => {
      atualizarSelecao(null);
      preencherComputadores(computadoresDisponiveis);
    });

    computadorFiltro.addEventListener("focus", () => {
      if (computadoresFiltrados.length) {
        renderSugestoes();
      }
    });

    computadorFiltro.addEventListener("keydown", (event) => {
      if (!computadoresFiltrados.length) return;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        highlightedIndex = Math.min(highlightedIndex + 1, computadoresFiltrados.length - 1);
        renderSugestoes();
        return;
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        highlightedIndex = Math.max(highlightedIndex - 1, 0);
        renderSugestoes();
        return;
      }

      if (event.key === "Enter") {
        event.preventDefault();
        selecionarComputador(computadoresFiltrados[Math.max(highlightedIndex, 0)]);
        return;
      }

      if (event.key === "Escape") {
        hideSugestoes();
      }
    });

    computadorFiltro.addEventListener("blur", () => {
      window.setTimeout(() => {
        hideSugestoes();
      }, 120);
    });

    descricaoPresetSelect.addEventListener("change", aplicarDescricaoPreset);

    form.addEventListener("submit", (event) => {
      if (String(computadorInput.value || "").trim()) return;

      event.preventDefault();
      showAlert("Pesquise e selecione um computador antes de registrar a manutencao.");
      computadorFiltro.focus();
    });

    modalEl.addEventListener("shown.bs.modal", async () => {
      hideAlert();
      computadorFiltro.value = "";
      const pref = window.__prefManutencao || null;

      try {
        await carregarEmpresas(pref);
      } catch (error) {
        showAlert(error.message || "Erro ao carregar o formulario de manutencao.");
        showComputadorGroup(false);
      }
    });
  });
</script>
