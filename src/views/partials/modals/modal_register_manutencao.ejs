<div class="modal fade" id="modalRegisterManutencao" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-body">

        <div class="card">
          <div class="card-body text-center">
            <div class="d-flex align-items-center justify-content-start mb-4">
              <button type="button" class="btn btn-back" data-bs-dismiss="modal" aria-label="Fechar">
                <i class="fas fa-arrow-left"></i>
              </button>
              <h2 class="card-title mb-0 mx-auto">Cadastro de Manutenção</h2>
            </div>

            <form id="manutencaoFormModal" action="/register-manutencao" method="post">
              <div class="form-group">
                <label for="empresaModal">Selecione a Empresa</label>
                <select class="form-control" id="empresaModal" name="empresa">
                  <option value="" selected disabled>Selecione a Empresa</option>
                </select>
              </div>

              <div class="form-group" id="computadorGroupModal" style="display: none;">
                <label for="computadorModal">Selecione o Computador</label>
                <select class="form-control" id="computadorModal" name="computadorId" required>
                  <option value="" selected disabled>Selecione o Computador</option>
                </select>
              </div>

              <div class="form-group">
                <label for="descricao">Descrição</label>
                <textarea placeholder="Informe a queixa do usuário e as suspeitas do problema" class="form-control" rows="10" name="descricao" required></textarea>
              </div>

              <hr>

              <div class="text-center">
                <button type="submit" class="btn btn-primary">Enviar</button>
              </div>
            </form>
          </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
          document.addEventListener("shown.bs.modal", function(ev) {
            if (ev.target.id !== "modalRegisterManutencao") return;

            const pref = window.__prefManutencao || null;
            let computadoresEmManutencao = new Set();

            function preencherComputadores(lista) {
              const disponiveis = (lista || []).filter((computador) => !computadoresEmManutencao.has(Number(computador.id)));

              $('#computadorModal').empty().append('<option value="" selected disabled>Selecione o Computador</option>');

              if (!disponiveis.length) {
                $('#computadorModal').append($('<option>', {
                  value: '',
                  text: 'Nenhum computador disponivel para nova manutencao'
                }).prop('disabled', true));
              } else {
                disponiveis.forEach(function(computador) {
                  $('#computadorModal').append($('<option>', {
                    value: computador.id,
                    text: `${computador.id} - ${computador.patrimonio}`
                  }));
                });
              }

              if (pref && pref.computadorId !== undefined && pref.computadorId !== null && pref.computadorId !== '') {
                const idPreferido = Number(pref.computadorId);
                if (computadoresEmManutencao.has(idPreferido)) {
                  alert('Este computador ja possui uma manutencao em aberto. Feche a manutencao atual antes de abrir outra.');
                } else {
                  $('#computadorModal').val(String(pref.computadorId));
                }
                window.__prefManutencao = null;
              }

              $('#computadorGroupModal').show();
            }

            function carregarComputadoresDisponiveis(empresaId) {
              $('#computadorModal').empty().append('<option value="" selected disabled>Selecione o Computador</option>');

              if (empresaId === undefined || empresaId === null || empresaId === '') {
                $('#computadorGroupModal').hide();
                return;
              }

              $.when(
                $.get("/computadores-by-empresa?empresaId=" + empresaId),
                $.get("/manutencoes-open")
              ).done(function(computadoresResp, manutencoesResp) {
                const resultado = computadoresResp[0];
                const manutencoesAbertas = Array.isArray(manutencoesResp[0]) ? manutencoesResp[0] : [];
                const lista = Array.isArray(resultado?.rows) ? resultado.rows : (Array.isArray(resultado) ? resultado : []);

                computadoresEmManutencao = new Set(
                  manutencoesAbertas
                    .map((manutencao) => Number(manutencao.computadorId))
                    .filter((id) => Number.isFinite(id))
                );

                preencherComputadores(lista);
              });
            }

            $.get("/get-empresas", function(data) {
              $('#empresaModal').empty().append('<option value="" selected disabled>Selecione a Empresa</option>');

              data.forEach(function(empresa) {
                $('#empresaModal').append($('<option>', {
                  value: empresa.id,
                  text: empresa.nome
                }));
              });

              if (pref && pref.empresaId !== undefined && pref.empresaId !== null && pref.empresaId !== '') {
                $('#empresaModal').val(String(pref.empresaId)).trigger('change');
              } else {
                $('#computadorModal').empty().append('<option value="" selected disabled>Selecione o Computador</option>');
                $('#computadorGroupModal').hide();
              }
            });

            $('#empresaModal').off('change').on('change', function() {
              var empresaId = $(this).val();
              carregarComputadoresDisponiveis(empresaId);
            });
          });
        </script>

      </div>
    </div>
  </div>
</div>
