    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-navbar-menu {
    min-width: 220px;
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 16px;
    padding: 8px;
    margin-top: 10px !important;
    background: var(--dropdown-surface, #ffffff);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.12);
