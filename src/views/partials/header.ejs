<script>
  (function() {
    const csrfToken = <%- JSON.stringify(csrfToken || '') %>;
    window.__csrfToken = csrfToken;

    function injectCsrfIntoForms(root = document) {
      if (!csrfToken || !root || typeof root.querySelectorAll !== 'function') return;

      root.querySelectorAll('form').forEach((form) => {
        if (form.dataset.csrf === 'off') return;

        let input = form.querySelector('input[name="_csrf"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = '_csrf';
          form.appendChild(input);
        }

        input.value = csrfToken;

        const enctype = String(form.getAttribute('enctype') || form.enctype || '').toLowerCase();
        if (enctype.includes('multipart/form-data')) {
          try {
            const actionUrl = new URL(form.getAttribute('action') || window.location.href, window.location.origin);
            actionUrl.searchParams.set('_csrf', csrfToken);
            form.setAttribute('action', `${actionUrl.pathname}${actionUrl.search}${actionUrl.hash}`);
          } catch (error) {}
        }
      });
    }

    function patchFetch() {
      if (!window.fetch || window.__csrfFetchPatched || !csrfToken) return;

      const originalFetch = window.fetch.bind(window);
      window.__csrfFetchPatched = true;

      window.fetch = function(input, init = {}) {
        const method = String(
          init.method || (input instanceof Request ? input.method : 'GET') || 'GET'
        ).toUpperCase();

        if (['GET', 'HEAD', 'OPTIONS'].includes(method)) {
          return originalFetch(input, init);
        }

        let isSameOrigin = true;
        try {
          const requestUrl = new URL(
            input instanceof Request ? input.url : String(input),
            window.location.origin
          );
          isSameOrigin = requestUrl.origin === window.location.origin;
        } catch (error) {}

        if (!isSameOrigin) {
          return originalFetch(input, init);
        }

        const headers = new Headers(input instanceof Request ? input.headers : undefined);
        if (init.headers) {
          new Headers(init.headers).forEach((value, key) => headers.set(key, value));
        }
        headers.set('x-csrf-token', csrfToken);

        return originalFetch(input, { ...init, headers });
      };
    }

    document.addEventListener('DOMContentLoaded', function() {
      injectCsrfIntoForms(document);
      patchFetch();
    });

    window.addEventListener('app:forms-added', function() {
      injectCsrfIntoForms(document);
    });
  })();
</script>

<style>
  .app-navbar {
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  .app-navbar-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .app-navbar-left,
  .app-navbar-right {
    display: flex;
    align-items: center;
  }

  .app-navbar-left {
    min-width: 0;
  }

  .app-navbar-right {
    margin-left: auto;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .app-navbar-brand {
    display: inline-flex;
    align-items: center;
    margin: 0;
  }

  .app-navbar-brand-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 8px 12px;
    border-radius: 18px;
    background: transparent;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .app-navbar-brand-logo::before {
    content: "";
    position: absolute;
    inset: 6px 10px;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(ellipse at 50% 52%, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.15) 28%, rgba(255, 255, 255, 0.06) 46%, rgba(255, 255, 255, 0) 72%),
      radial-gradient(ellipse at 34% 50%, rgba(96, 165, 250, 0.16) 0%, rgba(96, 165, 250, 0.08) 24%, rgba(96, 165, 250, 0) 56%);
    transition:
      opacity var(--theme-transition-duration) var(--theme-transition-easing),
      transform var(--theme-transition-duration) var(--theme-transition-easing);
  }

  .app-navbar-brand img {
    position: relative;
    z-index: 1;
    width: auto;
    height: 52px;
    max-width: 100%;
    object-fit: contain;
  }

  .app-navbar-home,
  .app-navbar-user-btn,
  .app-navbar-theme-btn {
    border-radius: 999px !important;
    padding: 9px 14px !important;
    border: 1px solid var(--navbar-chip-border, rgba(17, 24, 39, 0.14)) !important;
    background: var(--navbar-chip-bg, rgba(17, 24, 39, 0.03)) !important;
