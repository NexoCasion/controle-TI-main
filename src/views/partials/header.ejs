<header>
  <nav class="navbar navbar-expand-lg navbar-light bg-light app-navbar">
    <div class="container app-navbar-shell">
      <div class="app-navbar-left">
        <a class="navbar-brand app-navbar-brand" href="/">
          <span class="app-navbar-brand-logo">
            <img src="/logo_universo_motos_transparente.png" alt="Honda Universo" height="40">
          </span>
        </a>
      </div>

      <div class="app-navbar-right">
        <a class="btn app-navbar-home" href="/">
          <i class="fas fa-home"></i>
          <span>Home</span>
        </a>

        <button
          type="button"
          class="btn app-navbar-theme-btn"
          id="themeToggleBtn"
          aria-label="Alternar tema"
          title="Alternar tema">
          <i class="fas fa-moon"></i>
        </button>

        <% if (currentUser) { %>
        <div class="dropdown app-navbar-user">
          <button
            class="btn app-navbar-user-btn dropdown-toggle"
            type="button"
            id="userDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            <span class="app-navbar-user-avatar">
              <%= String(currentUser.nome || '?').trim().charAt(0).toUpperCase() %>
            </span>
            <span class="app-navbar-user-name"><%= currentUser.nome %></span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end app-navbar-menu" aria-labelledby="userDropdown">
            <li>
              <a class="dropdown-item app-navbar-menu-item" href="/perfil">
                <i class="fas fa-user-circle"></i>
                <span>Perfil</span>
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="post" class="app-navbar-logout-form">
                <button type="submit" class="dropdown-item app-navbar-menu-item app-navbar-logout-btn">
                  <i class="fas fa-sign-out-alt"></i>
                  <span>Sair</span>
                </button>
              </form>
            </li>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
  </nav>
</header>

<script>
  (function() {
    const root = document.documentElement;
    const btn = document.getElementById('themeToggleBtn');

    function applyButtonState() {
      if (!btn) return;
      const isDark = window.__appTheme && window.__appTheme.getTheme() === 'dark';
      const icon = btn.querySelector('i');
      if (!icon) return;

      icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
      btn.setAttribute('aria-label', isDark ? 'Ativar tema claro' : 'Ativar tema escuro');
      btn.setAttribute('title', isDark ? 'Ativar tema claro' : 'Ativar tema escuro');
    }

    if (btn) {
      btn.addEventListener('click', (ev) => {
        if (window.__appTheme) {
          window.__appTheme.toggleTheme(ev);
        }
      });
    }

    window.addEventListener('app-theme-changed', applyButtonState);

    applyButtonState();
  })();
</script>
