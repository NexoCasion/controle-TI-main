  .app-navbar-home i {
    font-size: 0.92rem;
    line-height: 1;
  }

  .app-navbar-theme-btn {
    justify-content: center;
    min-width: 46px;
    padding-inline: 0 !important;
  }

  .app-navbar-theme-btn i {
    font-size: 1rem;
    line-height: 1;
  }

  .app-navbar-user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--brand, #d6001c);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .app-navbar-user-name {
    max-width: 180px;
