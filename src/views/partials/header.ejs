  }

  html[data-theme='dark'] .app-navbar-brand-logo {
    background:
      radial-gradient(circle at 18% 22%, rgba(59, 130, 246, 0.18) 0%, rgba(59, 130, 246, 0) 34%),
      radial-gradient(circle at 82% 18%, rgba(125, 211, 252, 0.14) 0%, rgba(125, 211, 252, 0) 34%),
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 90%, #1e3a5f 10%) 0%, color-mix(in srgb, var(--surface-soft) 82%, #0f172a 18%) 52%, color-mix(in srgb, var(--surface) 88%, #1b2a41 12%) 100%);
    border: 1px solid color-mix(in srgb, var(--border-color) 72%, #93c5fd 12%);
    box-shadow:
      0 18px 34px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  html[data-theme='dark'] .app-navbar-brand-logo::before {
    opacity: 1;
    transform: scale(1.04);
  }

  @media (max-width: 767.98px) {
    .app-navbar-shell {
      padding: 14px 14px !important;
      align-items: flex-start;
    }

    .app-navbar-brand img {
      height: 40px;
      max-width: 100%;
    }

    .app-navbar-brand-logo {
      padding: 7px 10px;
    }

    .app-navbar-right {
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
    }

