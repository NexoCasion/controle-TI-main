  .app-navbar-user-btn:hover,
  .app-navbar-theme-btn:hover,
  .app-navbar-user.show .app-navbar-user-btn {
    background: var(--navbar-chip-bg-hover, rgba(17, 24, 39, 0.07)) !important;
    border-color: var(--navbar-chip-border-hover, rgba(17, 24, 39, 0.18)) !important;
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft, 0 10px 20px rgba(0, 0, 0, 0.08));
