<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Informações do Computador</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>
  <header class="headerComponent">
    <%- include("./../partials/header.ejs") %>
  </header>
  <main>
    <div class="container mt-4">
      <a href="javascript:history.back()" class="btn btn-back">
        <i class="fas fa-arrow-left"></i>
      </a>

      <div class="text-center align-items-center">
        <h1 class="mt-4 mb-4">Lista de Computadores</h1>
        <button type="button" id="btnAddStructuredPc" style="font-size: .75rem;" class="btn btn-secondary btn-lg btn-block mb-2 btn-add-computador">
          <i class="fas fa-plus-circle me-1"></i>
          Adicionar Computador
        </button>

        <div class="mt-3 mb-2">
          <small class="text-muted" id="totalComputadores">Computadores exibidos: 0 / Total: 0</small>
        </div>

        <div class="mb-3 text-start">
          <label for="selectEmpresa" class="form-label">Filtrar por Empresa:</label>
          <select id="selectEmpresa" class="form-select">
            <option value="">Todas as Empresas</option>
            <% empresas.forEach(function(empresa) { %>
            <option value="<%= empresa.id %>"><%= empresa.nome %></option>
            <% }); %>
          </select>
        </div>

        <div class="row g-3 mb-3 text-start">
          <div class="col-md-8">
            <label for="searchInput" class="form-label">Pesquisar:</label>
            <input id="searchInput" class="form-control" type="text" placeholder="Digite patrimônio, especificações, setor ou empresa...">
          </div>
          <div class="col-md-4">
            <label for="pageSizeSelect" class="form-label">Máximo por página:</label>
            <select id="pageSizeSelect" class="form-select">
              <option value="10">10</option>
              <option value="20" selected>20</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <th scope="col" style="cursor:pointer" onclick="ordenarPor('patrimonio')" data-sort-col="0">
                Patrimônio <span class="sort-indicator"></span>
              </th>
              <th scope="col" style="cursor:pointer" onclick="ordenarPor('specs')" data-sort-col="1">
                Especificações <span class="sort-indicator"></span>
              </th>
              <th scope="col" style="cursor:pointer" onclick="ordenarPor('setor')" data-sort-col="2">
                Setor <span class="sort-indicator"></span>
              </th>
              <th scope="col" style="cursor:pointer" onclick="ordenarPor('empresa')" data-sort-col="3">
                Empresa <span class="sort-indicator"></span>
              </th>
              <th scope="col" class="text-center">Ações</th>
            </thead>

            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
          <small class="text-muted" id="pageInfo">Página 1 de 1</small>
          <div class="d-flex align-items-center gap-2 flex-wrap" id="paginationControls"></div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
  <%- include("../partials/modals/modal_edit_pc") %>
  <%- include("../partials/modals/modal_register_manutencao") %>
  <%- include("../partials/modals/modal_transfer_pc", { empresas: empresas }) %>
  <%- include("../partials/modals/modal_import_csv_computadores", { empresas: empresas }) %>
  <%- include("../partials/modals/modal_import_csv_batch_computadores", { empresas: empresas }) %>
  <%- include("../partials/modals/modal_register_structured_pc", {
    empresas: empresas,
    csvTargetModal: 'modalImportCsvComputadores',
    csvEmpresaTargetId: 'empresaImportComputadores',
    batchTargetModal: 'modalImportCsvBatchComputadores'
  }) %>
  <% if (importCsvBatchResult) { %>
  <div class="modal fade" id="modalImportCsvBatchResultado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Resumo da importacao em lote</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body text-start">
          <div class="alert <%= importCsvBatchResult.falhas ? 'alert-warning' : 'alert-success' %> mb-3">
            <div>Total de arquivos: <strong><%= importCsvBatchResult.totalArquivos || 0 %></strong></div>
            <div>Importados com sucesso: <strong><%= importCsvBatchResult.importados || 0 %></strong></div>
            <div>Falhas: <strong><%= importCsvBatchResult.falhas || 0 %></strong></div>
          </div>

          <% if ((importCsvBatchResult.detalhes || []).length) { %>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Arquivo</th>
                  <th style="width: 140px;">Status</th>
                  <th>Mensagem</th>
                </tr>
              </thead>
              <tbody>
                <% importCsvBatchResult.detalhes.forEach(function(item) { %>
                <tr>
                  <td><strong><%= item.arquivo %></strong></td>
                  <td>
                    <span class="badge <%= item.status === 'importado' ? 'bg-success' : 'bg-warning text-dark' %>">
                      <%= item.status %>
                    </span>
                  </td>
                  <td><%= item.mensagem || '-' %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const selectEmpresa = document.getElementById("selectEmpresa");
      const searchInput = document.getElementById("searchInput");
      const pageSizeSelect = document.getElementById("pageSizeSelect");
      const tableBody = document.getElementById("tableBody");
      const totalComputadoresEl = document.getElementById("totalComputadores");
      const pageInfoEl = document.getElementById("pageInfo");
      const paginationControls = document.getElementById("paginationControls");
      const addComputerDefaultModal = <%- JSON.stringify(addComputerDefaultModal || "structured") %>;

      if (!selectEmpresa || !searchInput || !pageSizeSelect || !tableBody) {
        console.error("IDs não encontrados. Verifique selectEmpresa/searchInput/pageSizeSelect/tableBody no HTML.");
        return;
      }

      let currentComputadores = [];
      let currentMeta = {
        total: 0,
        page: 1,
        totalPages: 1,
        limit: 20,
      };
      let searchDebounce = null;
      let currentOrder = {
        coluna: null,
        asc: true
      };

      function atualizarContadores(total, visiveis) {
        if (totalComputadoresEl) {
          totalComputadoresEl.textContent = `Computadores exibidos: ${visiveis} / Total: ${total}`;
        }
      }

      function atualizarInfoPaginacao() {
        if (pageInfoEl) {
          pageInfoEl.textContent = `Página ${currentMeta.page} de ${currentMeta.totalPages}`;
        }
      }

      function getTargetModalFromPreference(value) {
        if (value === "batch") return "modalImportCsvBatchComputadores";
        if (value === "single") return "modalImportCsvComputadores";
        return "modalRegisterStructuredPc";
      }

      function sincronizarEmpresaModalComputadores() {
        const empresaId = selectEmpresa.value || "";
        const empresaImport = document.getElementById("empresaImportComputadores");
        const empresaImportBatch = document.getElementById("empresaImportBatchComputadores");
        const empresaManual = document.getElementById("manualEmpresaId");

        if (empresaImport && empresaId) empresaImport.value = empresaId;
        if (empresaImportBatch && empresaId) empresaImportBatch.value = empresaId;
        if (empresaManual && empresaId) empresaManual.value = empresaId;
      }

      function criarBotaoPagina(label, page, disabled = false, active = false) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `btn btn-sm ${active ? 'btn-primary' : 'btn-outline-secondary'}`;
        btn.textContent = label;
        btn.disabled = disabled;
        btn.addEventListener("click", () => {
          if (!disabled) carregarComputadores(page);
        });
        return btn;
      }

      function renderizarPaginacao() {
        paginationControls.innerHTML = "";

        const totalPages = currentMeta.totalPages || 1;
        const currentPage = currentMeta.page || 1;

        paginationControls.appendChild(
          criarBotaoPagina("Anterior", currentPage - 1, currentPage <= 1)
        );

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let page = startPage; page <= endPage; page++) {
          paginationControls.appendChild(
            criarBotaoPagina(String(page), page, false, page === currentPage)
          );
        }

        paginationControls.appendChild(
          criarBotaoPagina("Próxima", currentPage + 1, currentPage >= totalPages)
        );

        atualizarInfoPaginacao();
      }

      const btnAddStructuredPc = document.getElementById("btnAddStructuredPc");
      const btnImportCsvFromStructured = document.getElementById("btnImportCsvFromStructured");
      const btnImportCsvBatchFromStructured = document.getElementById("btnImportCsvBatchFromStructured");
      const btnBackToStructuredFromCsvComputadores = document.getElementById("btnBackToStructuredFromCsvComputadores");
      const btnOpenBatchCsvFromSingleComputadores = document.getElementById("btnOpenBatchCsvFromSingleComputadores");
      const btnBackToManualFromBatchComputadores = document.getElementById("btnBackToManualFromBatchComputadores");
      const btnBackToSingleCsvFromBatchComputadores = document.getElementById("btnBackToSingleCsvFromBatchComputadores");
      const modalImportCsvBatchResultadoEl = document.getElementById("modalImportCsvBatchResultado");

      if (btnAddStructuredPc) {
        btnAddStructuredPc.addEventListener("click", () => {
          sincronizarEmpresaModalComputadores();
          openModal(getTargetModalFromPreference(addComputerDefaultModal));
        });
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function renderSpecsCell(specs) {
        return escapeHtml(specs || "Sem descrição").replace(/\n/g, "<br>");
      }

      async function carregarComputadores(page = 1) {
        try {
          const params = new URLSearchParams({
            empresaId: selectEmpresa.value || "",
            q: searchInput.value || "",
            page: String(page),
            limit: String(pageSizeSelect.value || 20),
            sortBy: currentOrder.coluna === 1 ? "specs" : currentOrder.coluna === 2 ? "setor" : currentOrder.coluna === 3 ? "empresa" : "patrimonio",
            sortDir: currentOrder.asc ? "ASC" : "DESC",
          });

          const response = await fetch(`/computadores-by-empresa?${params.toString()}`);
          const resultado = await response.json();

          currentComputadores = Array.isArray(resultado.rows) ? resultado.rows : [];
          currentMeta = {
            total: Number(resultado.total || 0),
            page: Number(resultado.page || 1),
            totalPages: Number(resultado.totalPages || 1),
            limit: Number(resultado.limit || pageSizeSelect.value || 20),
          };

          renderizarComputadores(currentComputadores);
          atualizarContadores(currentMeta.total, currentComputadores.length);
          renderizarPaginacao();
          atualizarSetasOrdenacaoComputadores();
        } catch (error) {
          console.log(`Erro ao buscar computadores: ${error}`);
        }
      }

      function renderizarComputadores(computadores) {
        tableBody.innerHTML = "";

        computadores.forEach((computador) => {
          const specsExibicao = computador.specs_override || computador.specs;
          const patrimonio = escapeHtml(computador.patrimonio ?? "");
          const setor = escapeHtml(computador.setor ?? "");
          const empresaNome = escapeHtml(computador.empresa?.nome ?? "Sem empresa");
          const specsAttr = escapeHtml((specsExibicao ?? "").toString());
          const specsModoAttr = escapeHtml((computador.specs_modo ?? "LEGADO").toString());
          const row = `
  <tr class="editar-pcs">
    <td>${patrimonio}</td>
    <td class="align-middle text-start"><div style="line-height: 1.35; text-align: left;">${renderSpecsCell(specsExibicao)}</div></td>
    <td>${setor}</td>
    <td>${empresaNome}</td>
    <td>
      <div class="btn-group m-2 align-items-center" role="group">
        <button
          type="button"
          class="btn btn-primary btn-sm btn-edit"
          data-id="${computador.id}"
          data-patrimonio="${patrimonio}"
          data-setor="${setor}"
          data-specs="${specsAttr}"
          data-specs-modo="${specsModoAttr}"
          data-bs-toggle="modal"
          data-bs-target="#modalEditPc"
          data-empresa-id="${computador.empresaId ?? ''}"
        >
          <i class="fas fa-pencil-alt"></i> Editar
        </button>

        <a href="/ver-pc?id=${computador.id}" class="btn m-1 btn-info btn-sm">
          <i class="fas fa-eye"></i> Ver
        </a>
      </div>
    </td>
  </tr>
`;

          tableBody.innerHTML += row;
        });
      }

      function ordenarTabela(colunaIndex) {
        if (currentOrder.coluna === colunaIndex) {
          currentOrder.asc = !currentOrder.asc;
        } else {
          currentOrder.coluna = colunaIndex;
          currentOrder.asc = true;
        }

        carregarComputadores(1);
      }

      function atualizarSetasOrdenacaoComputadores() {
        const ths = document.querySelectorAll("th[data-sort-col]");
        ths.forEach(th => {
          const span = th.querySelector(".sort-indicator");
          if (!span) return;

          span.innerHTML = "";
          const col = parseInt(th.getAttribute("data-sort-col"), 10);

          if (col === currentOrder.coluna) {
            span.innerHTML = currentOrder.asc ?
              '<i class="fas fa-sort-up" style="margin-left:6px;"></i>' :
              '<i class="fas fa-sort-down" style="margin-left:6px;"></i>';
          }
        });
      }

      function ordenarPor(tipo) {
        const map = {
          patrimonio: 0,
          specs: 1,
          setor: 2,
          empresa: 3
        };

        if (map[tipo] !== undefined) ordenarTabela(map[tipo]);
      }

      tableBody.addEventListener("click", (e) => {
        const btn = e.target.closest(".btn-edit");
        if (!btn) return;

        const id = btn.getAttribute("data-id");
        const patrimonio = btn.getAttribute("data-patrimonio") || "";
        const setor = btn.getAttribute("data-setor") || "";
        const specs = btn.getAttribute("data-specs") || "";
        const specsModo = btn.getAttribute("data-specs-modo") || "LEGADO";
        const empresaId = btn.getAttribute("data-empresa-id");
        window.__editPcCtx = {
          computadorId: id,
          empresaId: empresaId
        };

        const form = document.getElementById("formEditPc");
        const inPatrimonio = document.getElementById("editPatrimonio");
        const inSetor = document.getElementById("editSetor");
        const inSpecs = document.getElementById("editSpecs");
        const inSpecsModo = document.getElementById("specsModo");
        const inSpecsHelp = document.getElementById("editSpecsHelp");

        if (!form || !inPatrimonio || !inSetor || !inSpecs) return;

        form.action = `/editar-pc?id=${id}`;
        inPatrimonio.value = patrimonio;
        inSetor.value = setor;
        inSpecs.value = specs;
        inSpecs.readOnly = specsModo === "ESTRUTURADO";
        if (inSpecsModo) inSpecsModo.value = specsModo;
        if (inSpecsHelp) {
          inSpecsHelp.textContent = specsModo === "ESTRUTURADO" ?
            "Este computador esta em modo estruturado. As specs sao recalculadas pelos componentes vinculados." :
            "Edite as specs livremente para computadores no modo legado.";
        }
      });

      const btnAddMan = document.getElementById("btnAddManutencaoFromEdit");
      const btnTransf = document.getElementById("btnTransferirFromEdit");

      function ensureModal(modalId) {
        const el = document.getElementById(modalId);
        if (!el || !window.bootstrap || !bootstrap.Modal) return null;
        return bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
      }

      function openModal(modalId) {
        const inst = ensureModal(modalId);
        if (inst) inst.show();
        return inst;
      }

      if (modalImportCsvBatchResultadoEl) {
        const modalResultado = ensureModal("modalImportCsvBatchResultado");
        if (modalResultado) {
          modalResultado.show();
        }
      }

      function switchModal(fromId, toId, beforeShow) {
        const fromEl = document.getElementById(fromId);
        const fromInst = ensureModal(fromId);

        if (!fromEl || !fromInst) {
          if (typeof beforeShow === "function") beforeShow();
          openModal(toId);
          return;
        }

        fromEl.addEventListener(
          "hidden.bs.modal",
          () => {
            if (typeof beforeShow === "function") beforeShow();
            openModal(toId);
          }, {
            once: true
          }
        );

        fromInst.hide();
      }

      if (btnBackToStructuredFromCsvComputadores) {
        btnBackToStructuredFromCsvComputadores.addEventListener("click", () => {
          switchModal("modalImportCsvComputadores", "modalRegisterStructuredPc", () => {
            const empresaImport = document.getElementById("empresaImportComputadores");
            const empresaManual = document.getElementById("manualEmpresaId");
            if (empresaImport && empresaManual && empresaImport.value) {
              empresaManual.value = empresaImport.value;
            }
          });
        });
      }

      if (btnImportCsvFromStructured) {
        btnImportCsvFromStructured.addEventListener("click", () => {
          switchModal("modalRegisterStructuredPc", "modalImportCsvComputadores", () => {
            const empresaImport = document.getElementById("empresaImportComputadores");
            const empresaManual = document.getElementById("manualEmpresaId");
            if (empresaImport && empresaManual && empresaManual.value) {
              empresaImport.value = empresaManual.value;
            }
          });
        });
      }

      if (btnImportCsvBatchFromStructured) {
        btnImportCsvBatchFromStructured.addEventListener("click", () => {
          switchModal("modalRegisterStructuredPc", "modalImportCsvBatchComputadores", () => {
            const empresaImportBatch = document.getElementById("empresaImportBatchComputadores");
            const empresaManual = document.getElementById("manualEmpresaId");

            if (empresaImportBatch && empresaManual && empresaManual.value) {
              empresaImportBatch.value = empresaManual.value;
            }
          });
        });
      }

      if (btnOpenBatchCsvFromSingleComputadores) {
        btnOpenBatchCsvFromSingleComputadores.addEventListener("click", () => {
          switchModal("modalImportCsvComputadores", "modalImportCsvBatchComputadores", () => {
            const empresaImport = document.getElementById("empresaImportComputadores");
            const empresaImportBatch = document.getElementById("empresaImportBatchComputadores");
            const fonteImport = document.getElementById("fonteImportComputadores");
            const fonteImportBatch = document.getElementById("fonteImportBatchComputadores");

            if (empresaImport && empresaImportBatch && empresaImport.value) {
              empresaImportBatch.value = empresaImport.value;
            }

            if (fonteImport && fonteImportBatch && fonteImport.value) {
              fonteImportBatch.value = fonteImport.value;
            }
          });
        });
      }

      if (btnBackToSingleCsvFromBatchComputadores) {
        btnBackToSingleCsvFromBatchComputadores.addEventListener("click", () => {
          switchModal("modalImportCsvBatchComputadores", "modalImportCsvComputadores", () => {
            const empresaImport = document.getElementById("empresaImportComputadores");
            const empresaImportBatch = document.getElementById("empresaImportBatchComputadores");
            const fonteImport = document.getElementById("fonteImportComputadores");
            const fonteImportBatch = document.getElementById("fonteImportBatchComputadores");

            if (empresaImport && empresaImportBatch && empresaImportBatch.value) {
              empresaImport.value = empresaImportBatch.value;
            }

            if (fonteImport && fonteImportBatch && fonteImportBatch.value) {
              fonteImport.value = fonteImportBatch.value;
            }
          });
        });
      }

      if (btnBackToManualFromBatchComputadores) {
        btnBackToManualFromBatchComputadores.addEventListener("click", () => {
          switchModal("modalImportCsvBatchComputadores", "modalRegisterStructuredPc", () => {
            const empresaImportBatch = document.getElementById("empresaImportBatchComputadores");
            const empresaManual = document.getElementById("manualEmpresaId");
            const fonteImportBatch = document.getElementById("fonteImportBatchComputadores");
            const fonteManual = document.getElementById("manualFonte");

            if (empresaImportBatch && empresaManual && empresaImportBatch.value) {
              empresaManual.value = empresaImportBatch.value;
            }

            if (fonteImportBatch && fonteManual && fonteImportBatch.value) {
              fonteManual.value = fonteImportBatch.value;
            }
          });
        });
      }

      if (btnAddMan) {
        btnAddMan.addEventListener("click", () => {
          if (!window.__editPcCtx || !window.__editPcCtx.computadorId) {
            console.warn("Contexto do PC não encontrado. Clique em EDITAR primeiro.");
            return;
          }

          window.__prefManutencao = {
            empresaId: window.__editPcCtx.empresaId,
            computadorId: window.__editPcCtx.computadorId,
          };

          switchModal("modalEditPc", "modalRegisterManutencao");
        });
      }

      if (btnTransf) {
        btnTransf.addEventListener("click", () => {
          if (!window.__editPcCtx || !window.__editPcCtx.computadorId) {
            console.warn("Contexto do PC não encontrado. Clique em EDITAR primeiro.");
            return;
          }

          switchModal("modalEditPc", "modalTransferPc", () => {
            const inputPc = document.getElementById("transferComputadorId");
            const inputOrigem = document.getElementById("transferEmpOrigemId");
            const selectDestino = document.getElementById("transferEmpDestinoId");

            if (inputPc) inputPc.value = window.__editPcCtx.computadorId;
            if (inputOrigem) inputOrigem.value = window.__editPcCtx.empresaId ?? "";
            if (selectDestino) selectDestino.value = "";
          });
        });
      }

      window.ordenarTabela = ordenarTabela;
      window.ordenarPor = ordenarPor;

      selectEmpresa.addEventListener("change", function() {
        carregarComputadores(1);
      });

      pageSizeSelect.addEventListener("change", function() {
        carregarComputadores(1);
      });

      searchInput.addEventListener("input", function() {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => carregarComputadores(1), 250);
      });

      carregarComputadores(1);
    });
  </script>
</body>

</html>
