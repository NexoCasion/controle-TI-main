<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>
  <header class="headerComponent">
    <%- include("./../partials/header.ejs") %>
  </header>

  <main>
    <div class="container mt-4 home-shell">
      <div class="row g-4">
        <div class="col-12 col-xl-3">
          <div class="home-menu">
            <a href="/computadores" class="home-menu-card">
              <span class="home-menu-icon home-menu-icon-blue"><i class="fas fa-desktop"></i></span>
              <span>Lista de computadores</span>
            </a>

            <a href="/empresas" class="home-menu-card">
              <span class="home-menu-icon home-menu-icon-cyan"><i class="fas fa-city"></i></span>
              <span>Lista de empresas</span>
            </a>

            <a href="/manutencoes" class="home-menu-card">
              <span class="home-menu-icon home-menu-icon-gold"><i class="fas fa-tools"></i></span>
              <span>Lista de manutenções</span>
            </a>

            <a href="/materiais-page" class="home-menu-card">
              <span class="home-menu-icon home-menu-icon-amber"><i class="fas fa-hdd"></i></span>
              <span>Lista de materiais</span>
            </a>
          </div>
        </div>

        <div class="col-md-4 col-xl-3">
          <section class="home-panel home-overview-panel h-100">
            <h2 class="home-panel-title">Visão Geral de Máquinas e Empresas</h2>

            <div class="home-stat-block">
              <span class="home-stat-label">Máquinas Ativas:</span>
              <strong class="home-stat-value"><%= maquinasAtivas %> / <%= maquinasTotal %></strong>
            </div>

            <div class="home-stat-block">
              <span class="home-stat-label">Manutenções em Aberto:</span>
              <strong class="home-stat-value"><%= manutencoesAbertas %></strong>
            </div>

            <div class="home-stat-block">
              <span class="home-stat-label">Empresas Registradas:</span>
              <strong class="home-stat-value"><%= totalEmpresas %></strong>
            </div>

            <div class="home-subpanel">
              <h3 class="home-subpanel-title">Materiais Disponíveis por Tipo</h3>

              <% if ((materiaisDisponiveisPorTipo || []).length) { %>
              <div class="home-type-list">
                <% materiaisDisponiveisPorTipo.forEach(function(item) { %>
                <div class="home-type-row">
                  <span><%= item.tipo %></span>
                  <strong><%= item.total %></strong>
                </div>
                <% }); %>
              </div>
              <% } else { %>
              <div class="home-empty">Nenhum material disponível no momento.</div>
              <% } %>
            </div>
          </section>
        </div>

        <div class="col-md-8 col-xl-6">
          <section class="home-panel h-100" id="homeChartPanel">
            <div class="home-chart-card-inner" id="homeChartCardInner">
              <h2 class="home-panel-title" id="homeChartTitle">Empresas com Mais Manutenções</h2>
              <div class="home-chart-wrap">
                <canvas id="rankingEmpresasChart"></canvas>
              </div>
            </div>

            <div class="home-chart-nav">
              <div class="home-chart-nav-right">
                <button type="button" class="home-filter-btn" id="btnOpenHomeChartFilters" aria-label="Filtrar lojas" title="Filtrar lojas">
                  <i class="fas fa-filter"></i>
                </button>
                <button type="button" class="home-chart-arrow" id="chartPrevBtn" aria-label="Gráfico anterior">
                  <i class="fas fa-chevron-left"></i>
                </button>
                <div class="home-chart-caption" id="homeChartCaption">1 de 3</div>
                <button type="button" class="home-chart-arrow" id="chartNextBtn" aria-label="Próximo gráfico">
                  <i class="fas fa-chevron-right"></i>
                </button>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <div class="modal fade" id="modalHomeChartFilters" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Filtrar lojas dos gráficos</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none mb-3" id="homeChartPreferenceError"></div>
          <div class="alert alert-light border mb-3">
            Escolha quais lojas devem aparecer em cada gráfico de empresas. O gráfico de materiais continua global.
          </div>

          <div class="row g-4">
            <div class="col-md-6">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Empresas com Mais Manutenções</h6>
                  <div class="home-filter-actions">
                    <button type="button" class="btn btn-link btn-sm p-0" data-filter-check-all="ranking">Marcar todas</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-filter-clear-all="ranking">Limpar</button>
                  </div>
                </div>
                <div class="home-filter-list">
                  <% (empresasFiltro || []).forEach(function(empresa) { %>
                  <label class="home-filter-option">
                    <input class="form-check-input me-2" type="checkbox" value="<%= empresa.id %>" data-filter-chart="ranking" <%= (homeDashboardPreferences?.ranking || []).includes(Number(empresa.id)) ? 'checked' : '' %>>
                    <span><%= empresa.nome %></span>
                    <small><%= empresa.nomeCompleto %></small>
                  </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Máquinas Ativas por Empresa</h6>
                  <div class="home-filter-actions">
                    <button type="button" class="btn btn-link btn-sm p-0" data-filter-check-all="maquinas">Marcar todas</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-filter-clear-all="maquinas">Limpar</button>
                  </div>
                </div>
                <div class="home-filter-list">
                  <% (empresasFiltro || []).forEach(function(empresa) { %>
                  <label class="home-filter-option">
                    <input class="form-check-input me-2" type="checkbox" value="<%= empresa.id %>" data-filter-chart="maquinas" <%= (homeDashboardPreferences?.maquinas || []).includes(Number(empresa.id)) ? 'checked' : '' %>>
                    <span><%= empresa.nome %></span>
                    <small><%= empresa.nomeCompleto %></small>
                  </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Ignorar descricoes no ranking de manutencoes</h6>
                </div>
                <p class="text-muted mb-3">
                  Uma linha por termo. Ex.: <code>teste</code>, <code>erro</code>, <code>ajuste temporario</code>.
                </p>
                <textarea
                  class="form-control"
                  id="homeRankingIgnoredDescriptions"
                  rows="4"
                  placeholder="Um termo por linha&#10;teste&#10;erro"></textarea>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Templates de descricao da manutencao</h6>
                </div>
                <p class="text-muted mb-3">
                  Uma linha por template. Essas opcoes aparecem no campo "Descricao pronta" ao abrir uma manutencao.
                </p>
                <textarea
                  class="form-control"
                  id="homeMaintenanceDescriptionTemplates"
                  rows="6"
                  placeholder="Um template por linha&#10;Limpeza preventiva&#10;Erro de funcionamento"></textarea>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Ordem dos gráficos</h6>
                </div>
                <p class="text-muted mb-3">Defina qual gráfico aparece primeiro, segundo e terceiro no carrossel.</p>
                <div class="alert alert-warning d-none mb-3" id="homeChartOrderAlert"></div>
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label" for="homeChartOrderFirst">Primeiro gráfico</label>
                    <select class="form-select" id="homeChartOrderFirst">
                      <option value="ranking">Empresas com Mais Manutenções</option>
                      <option value="maquinas">Máquinas Ativas por Empresa</option>
                      <option value="materiais">Materiais Disponíveis por Tipo</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label" for="homeChartOrderSecond">Segundo gráfico</label>
                    <select class="form-select" id="homeChartOrderSecond">
                      <option value="ranking">Empresas com Mais Manutenções</option>
                      <option value="maquinas">Máquinas Ativas por Empresa</option>
                      <option value="materiais">Materiais Disponíveis por Tipo</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label" for="homeChartOrderThird">Terceiro gráfico</label>
                    <select class="form-select" id="homeChartOrderThird">
                      <option value="ranking">Empresas com Mais Manutenções</option>
                      <option value="maquinas">Máquinas Ativas por Empresa</option>
                      <option value="materiais">Materiais Disponíveis por Tipo</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" id="btnResetHomeChartFilters">Restaurar padrão</button>
          <button type="button" class="btn btn-primary" id="btnApplyHomeChartFilters">Aplicar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const empresasFiltro = <%- JSON.stringify(empresasFiltro || []) %>;
      const rankingEmpresas = <%- JSON.stringify(rankingEmpresas || []) %>;
      const maquinasPorEmpresa = <%- JSON.stringify(maquinasPorEmpresa || []) %>;
      const materiaisDisponiveisPorTipo = <%- JSON.stringify(materiaisDisponiveisPorTipo || []) %>;
      const homeDashboardPreferences = <%- JSON.stringify(homeDashboardPreferences || {}) %>;

      const ctx = document.getElementById('rankingEmpresasChart');
      const titleEl = document.getElementById('homeChartTitle');
      const captionEl = document.getElementById('homeChartCaption');
      const prevBtn = document.getElementById('chartPrevBtn');
      const nextBtn = document.getElementById('chartNextBtn');
      const cardInner = document.getElementById('homeChartCardInner');
      const btnOpenFilters = document.getElementById('btnOpenHomeChartFilters');
      const btnApplyFilters = document.getElementById('btnApplyHomeChartFilters');
      const btnResetFilters = document.getElementById('btnResetHomeChartFilters');
      const modalFiltersEl = document.getElementById('modalHomeChartFilters');
      const orderAlertEl = document.getElementById('homeChartOrderAlert');
      const preferenceErrorEl = document.getElementById('homeChartPreferenceError');
      const rankingIgnoredDescriptionsInput = document.getElementById('homeRankingIgnoredDescriptions');
      const maintenanceDescriptionTemplatesInput = document.getElementById('homeMaintenanceDescriptionTemplates');
      const orderSelects = [
        document.getElementById('homeChartOrderFirst'),
        document.getElementById('homeChartOrderSecond'),
        document.getElementById('homeChartOrderThird'),
      ];
      if (!ctx) return;

      const defaultChartOrder = ['ranking', 'maquinas', 'materiais'];
      const defaultMaintenanceDescriptionTemplates = [
        'Limpeza preventiva',
        'Erro de funcionamento',
        'Lentidao ou travamento',
        'Maquina sem ligar',
        'Formatacao ou reinstalacao do sistema',
        'Sem acesso a rede ou internet',
      ];
      const chartOptionLabels = {
        ranking: 'Empresas com Mais Manutenções',
        maquinas: 'Máquinas Ativas por Empresa',
        materiais: 'Materiais Disponíveis por Tipo',
      };

      function getModalInstance(modalEl) {
        if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return null;
        if (typeof bootstrap.Modal.getOrCreateInstance === 'function') {
          return bootstrap.Modal.getOrCreateInstance(modalEl);
        }
        return bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      }

      function labelQuebrada(texto) {
        const normalizado = String(texto || 'Sem empresa').trim();
        if (normalizado.length <= 12) return normalizado;
        return normalizado.split(/\s+-\s+|\s+/).filter(Boolean);
      }

      function getAllEmpresaIds() {
        return empresasFiltro.map((empresa) => Number(empresa.id));
      }

      function getCheckedIds(chartKey) {
        return Array.from(document.querySelectorAll(`input[data-filter-chart="${chartKey}"]`))
          .filter((input) => input.checked)
          .map((input) => Number(input.value));
      }

      function setCheckedIds(chartKey, ids) {
        const idsSet = new Set((ids || []).map((id) => Number(id)));
        document.querySelectorAll(`input[data-filter-chart="${chartKey}"]`).forEach((input) => {
          input.checked = idsSet.has(Number(input.value));
        });
      }

      function filtrarEmpresas(lista, selectedIds) {
        const ids = Array.isArray(selectedIds) ? selectedIds : [];
        if (!ids.length) return [];

        const idsSet = new Set(ids.map((id) => Number(id)));
        return (lista || []).filter((item) => idsSet.has(Number(item.empresaId)));
      }

      function getDefaultRankingIds() {
        return empresasFiltro
          .filter((empresa) => !empresa.isDeptoTi)
          .map((empresa) => Number(empresa.id));
      }

      function normalizeEmpresaIds(ids, fallback) {
        const allIdsSet = new Set(getAllEmpresaIds());
        const input = Array.isArray(ids) ? ids : [ids];
        const unique = [];

        input
          .map((item) => Number(item))
          .filter((id) => Number.isFinite(id) && allIdsSet.has(id))
          .forEach((id) => {
            if (!unique.includes(id)) unique.push(id);
          });

        return unique.length ? unique : [...fallback];
      }

      function normalizeIgnoredDescriptions(value) {
        const rawItems = Array.isArray(value)
          ? value
          : String(value || '')
              .split(/\r?\n|,|;/)
              .map((item) => item.trim());

        const unique = [];

        rawItems
          .map((item) => String(item || '').trim().toLowerCase())
          .filter(Boolean)
          .forEach((item) => {
            if (!unique.includes(item)) unique.push(item);
          });

        return unique.slice(0, 30);
      }

      function setRankingIgnoredDescriptionsValue(values) {
        if (!rankingIgnoredDescriptionsInput) return;
        rankingIgnoredDescriptionsInput.value = normalizeIgnoredDescriptions(values).join('\n');
      }

      function getRankingIgnoredDescriptionsValue() {
        return normalizeIgnoredDescriptions(rankingIgnoredDescriptionsInput?.value || '');
      }

      function normalizeMaintenanceDescriptionTemplates(value) {
        const rawItems = Array.isArray(value)
          ? value
          : String(value || '')
              .split(/\r?\n|,|;/)
              .map((item) => item.trim());

        const unique = [];
        const dedupeKeys = new Set();

        rawItems
          .map((item) => String(item || '').trim())
          .filter(Boolean)
          .forEach((item) => {
            const dedupeKey = item.toLowerCase();
            if (dedupeKeys.has(dedupeKey)) return;
            dedupeKeys.add(dedupeKey);
            unique.push(item);
          });

        return unique.slice(0, 30);
      }

      function setMaintenanceDescriptionTemplatesValue(values) {
        if (!maintenanceDescriptionTemplatesInput) return;
        maintenanceDescriptionTemplatesInput.value = normalizeMaintenanceDescriptionTemplates(values).join('\n');
      }

      function getMaintenanceDescriptionTemplatesValue() {
        return normalizeMaintenanceDescriptionTemplates(maintenanceDescriptionTemplatesInput?.value || '');
      }

      const filtros = {
        ranking: normalizeEmpresaIds(homeDashboardPreferences.ranking, getDefaultRankingIds()),
        maquinas: normalizeEmpresaIds(homeDashboardPreferences.maquinas, getAllEmpresaIds()),
      };
      let rankingIgnoredDescriptions = normalizeIgnoredDescriptions(
        homeDashboardPreferences.rankingIgnoredDescriptions
      );
      let maintenanceDescriptionTemplates = normalizeMaintenanceDescriptionTemplates(
        homeDashboardPreferences.maintenanceDescriptionTemplates
      );

      function hideOrderAlert() {
        if (!orderAlertEl) return;
        orderAlertEl.textContent = '';
        orderAlertEl.classList.add('d-none');
      }

      function showOrderAlert(message) {
        if (!orderAlertEl) return;
        orderAlertEl.textContent = message;
        orderAlertEl.classList.remove('d-none');
      }

      function normalizeChartOrder(order) {
        const list = Array.isArray(order) ? order.map((item) => String(item || '').trim()) : [];
        const valid = list.filter((item) => defaultChartOrder.includes(item));
        const unique = [];

        valid.forEach((item) => {
          if (!unique.includes(item)) unique.push(item);
        });

        defaultChartOrder.forEach((item) => {
          if (!unique.includes(item)) unique.push(item);
        });

        return unique.slice(0, defaultChartOrder.length);
      }

      function hidePreferenceError() {
        if (!preferenceErrorEl) return;
        preferenceErrorEl.textContent = '';
        preferenceErrorEl.classList.add('d-none');
      }

      function showPreferenceError(message) {
        if (!preferenceErrorEl) return;
        preferenceErrorEl.textContent = message;
        preferenceErrorEl.classList.remove('d-none');
      }

      function buildPreferencePayload(base = {}) {
        return {
          ranking: normalizeEmpresaIds(base.ranking, getDefaultRankingIds()),
          maquinas: normalizeEmpresaIds(base.maquinas, getAllEmpresaIds()),
          rankingIgnoredDescriptions: normalizeIgnoredDescriptions(base.rankingIgnoredDescriptions),
          maintenanceDescriptionTemplates: normalizeMaintenanceDescriptionTemplates(base.maintenanceDescriptionTemplates),
          order: normalizeChartOrder(base.order),
        };
      }

      async function saveHomeDashboardPreferences(preferences) {
        const response = await fetch('/perfil/preferencias/home-dashboard', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            homeRankingEmpresaIds: preferences.ranking,
            homeMaquinasEmpresaIds: preferences.maquinas,
            homeRankingIgnoredDescriptions: preferences.rankingIgnoredDescriptions.join('\n'),
            homeMaintenanceDescriptionTemplates: preferences.maintenanceDescriptionTemplates.join('\n'),
            homeChartOrderFirst: preferences.order[0],
            homeChartOrderSecond: preferences.order[1],
            homeChartOrderThird: preferences.order[2],
          }),
        });

        let payload = null;
        try {
          payload = await response.json();
        } catch (error) {
          payload = null;
        }

        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.error || 'Nao foi possivel salvar as preferencias da home.');
        }
      }

      function setOrderSelectValues(order) {
        const normalized = normalizeChartOrder(order);
        orderSelects.forEach((select, index) => {
          if (select) select.value = normalized[index];
        });
      }

      function getSelectedChartOrder() {
        return orderSelects.map((select) => (select ? select.value : ''));
      }

      function validateSelectedChartOrder() {
        const selected = getSelectedChartOrder();
        const normalized = normalizeChartOrder(selected);
        const allValid = selected.every((item) => defaultChartOrder.includes(item));
        const uniqueCount = new Set(selected).size;

        if (!allValid || uniqueCount !== defaultChartOrder.length) {
          return {
            ok: false,
            message: 'Escolha três gráficos diferentes para definir a ordem.',
          };
        }

        return {
          ok: true,
          order: normalized,
        };
      }

      let chartOrder = normalizeChartOrder(homeDashboardPreferences.order);

      function buildChartConfigs() {
        const rankingFiltrado = filtrarEmpresas(rankingEmpresas, filtros.ranking);
        const maquinasFiltradas = filtrarEmpresas(maquinasPorEmpresa, filtros.maquinas);

        const configsById = {
          ranking: {
            id: 'ranking',
            titulo: 'Empresas com Mais Manutenções',
            legenda: 'Manutenções',
            labels: rankingFiltrado.map((item) => labelQuebrada(item.nome)),
            tooltipLabels: rankingFiltrado.map((item) => item.nomeCompleto || item.nome),
            data: rankingFiltrado.map((item) => Number(item.total || 0)),
          },
          maquinas: {
            id: 'maquinas',
            titulo: 'Máquinas Ativas por Empresa',
            legenda: 'Máquinas ativas',
            labels: maquinasFiltradas.map((item) => labelQuebrada(item.nome)),
            tooltipLabels: maquinasFiltradas.map((item) => item.nomeCompleto || item.nome),
            data: maquinasFiltradas.map((item) => Number(item.total || 0)),
          },
          materiais: {
            id: 'materiais',
            titulo: 'Materiais Disponíveis por Tipo',
            legenda: 'Disponíveis',
            labels: materiaisDisponiveisPorTipo.map((item) => labelQuebrada(item.tipo)),
            tooltipLabels: materiaisDisponiveisPorTipo.map((item) => item.tipo),
            data: materiaisDisponiveisPorTipo.map((item) => Number(item.total || 0)),
          },
        };

        return normalizeChartOrder(chartOrder)
          .map((id) => configsById[id])
          .filter(Boolean);
      }

      const colors = [
        '#2f80ed',
        '#56ccf2',
        '#f2c94c',
        '#27ae60',
        '#eb5757',
        '#9b51e0',
        '#f2994a',
        '#6fcf97',
        '#2d9cdb',
        '#bb6bd9',
      ];

      let chartConfigs = buildChartConfigs();
      let currentIndex = 0;

      const chart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: chartConfigs[0].labels.length ? chartConfigs[0].labels : ['Sem dados'],
          datasets: [{
            label: chartConfigs[0].legenda,
            data: chartConfigs[0].data.length ? chartConfigs[0].data : [0],
            backgroundColor: colors,
            borderRadius: 8,
            maxBarThickness: 42,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false,
            },
            tooltip: {
              callbacks: {
                title(items) {
                  if (!items || !items.length) return '';
                  const index = items[0].dataIndex;
                  const config = chartConfigs[currentIndex];
                  return config.tooltipLabels[index] || '';
                },
              },
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                precision: 0,
              },
            },
            x: {
              ticks: {
                autoSkip: false,
                maxRotation: 90,
                minRotation: 90,
                font: {
                  size: 10,
                },
              },
              grid: {
                display: false,
              }
            },
          },
        },
      });

      function applyChart(index) {
        chartConfigs = buildChartConfigs();
        const safeIndex = Math.min(Math.max(index, 0), Math.max(chartConfigs.length - 1, 0));
        const config = chartConfigs[safeIndex];
        currentIndex = safeIndex;
        if (titleEl) titleEl.textContent = config.titulo;
        if (captionEl) captionEl.textContent = `${safeIndex + 1} de ${chartConfigs.length}`;
        chart.data.labels = config.labels.length ? config.labels : ['Sem dados'];
        chart.data.datasets[0].label = config.legenda;
        chart.data.datasets[0].data = config.data.length ? config.data : [0];
        chart.update();
      }

      function rotateTo(index) {
        if (!cardInner) {
          applyChart(index);
          return;
        }

        cardInner.classList.add('is-flipping');

        window.setTimeout(() => {
          applyChart(index);
          cardInner.classList.remove('is-flipping');
        }, 180);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          const nextIndex = (currentIndex - 1 + chartConfigs.length) % chartConfigs.length;
          rotateTo(nextIndex);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          const nextIndex = (currentIndex + 1) % chartConfigs.length;
          rotateTo(nextIndex);
        });
      }

      document.querySelectorAll('[data-filter-check-all]').forEach((btn) => {
        btn.addEventListener('click', function() {
          const chartKey = this.getAttribute('data-filter-check-all');
          setCheckedIds(chartKey, getAllEmpresaIds());
        });
      });

      document.querySelectorAll('[data-filter-clear-all]').forEach((btn) => {
        btn.addEventListener('click', function() {
          const chartKey = this.getAttribute('data-filter-clear-all');
          setCheckedIds(chartKey, []);
        });
      });

      if (btnOpenFilters) {
        btnOpenFilters.addEventListener('click', function() {
          hideOrderAlert();
          hidePreferenceError();
          setCheckedIds('ranking', filtros.ranking);
          setCheckedIds('maquinas', filtros.maquinas);
          setRankingIgnoredDescriptionsValue(rankingIgnoredDescriptions);
          setMaintenanceDescriptionTemplatesValue(maintenanceDescriptionTemplates);
          setOrderSelectValues(chartOrder);

          const modal = getModalInstance(modalFiltersEl);
          if (modal) modal.show();
        });
      }

      if (btnApplyFilters) {
        btnApplyFilters.addEventListener('click', async function() {
          const orderState = validateSelectedChartOrder();
          if (!orderState.ok) {
            showOrderAlert(orderState.message);
            return;
          }

          hideOrderAlert();
          hidePreferenceError();
          const rankingIds = getCheckedIds('ranking');
          const maquinasIds = getCheckedIds('maquinas');
          const nextIgnoredDescriptions = getRankingIgnoredDescriptionsValue();
          const nextMaintenanceDescriptionTemplates = getMaintenanceDescriptionTemplatesValue();
          const currentChartId = chartConfigs[currentIndex]?.id || chartOrder[0];

          const nextPreferences = buildPreferencePayload({
            ranking: rankingIds,
            maquinas: maquinasIds,
            rankingIgnoredDescriptions: nextIgnoredDescriptions,
            maintenanceDescriptionTemplates: nextMaintenanceDescriptionTemplates,
            order: orderState.order,
          });

          try {
            await saveHomeDashboardPreferences(nextPreferences);
          } catch (error) {
            showPreferenceError(error.message || 'Nao foi possivel salvar as preferencias da home.');
            return;
          }

          filtros.ranking = [...nextPreferences.ranking];
          filtros.maquinas = [...nextPreferences.maquinas];
          const ignoredDescriptionsChanged =
            rankingIgnoredDescriptions.join('|') !== nextPreferences.rankingIgnoredDescriptions.join('|');
          rankingIgnoredDescriptions = [...nextPreferences.rankingIgnoredDescriptions];
          maintenanceDescriptionTemplates = [...nextPreferences.maintenanceDescriptionTemplates];
          chartOrder = [...nextPreferences.order];

          if (ignoredDescriptionsChanged) {
            window.location.reload();
            return;
          }

          chartConfigs = buildChartConfigs();
          const nextIndex = Math.max(chartConfigs.findIndex((config) => config.id === currentChartId), 0);
          rotateTo(nextIndex);

          const modal = getModalInstance(modalFiltersEl);
          if (modal) modal.hide();
        });
      }

      if (btnResetFilters) {
        btnResetFilters.addEventListener('click', async function() {
          const nextPreferences = buildPreferencePayload({
            ranking: getDefaultRankingIds(),
            maquinas: getAllEmpresaIds(),
            rankingIgnoredDescriptions: [],
            maintenanceDescriptionTemplates: defaultMaintenanceDescriptionTemplates,
            order: defaultChartOrder,
          });
          const currentChartId = chartConfigs[currentIndex]?.id || chartOrder[0];

          hideOrderAlert();
          hidePreferenceError();

          try {
            await saveHomeDashboardPreferences(nextPreferences);
          } catch (error) {
            showPreferenceError(error.message || 'Nao foi possivel salvar as preferencias da home.');
            return;
          }

          filtros.ranking = [...nextPreferences.ranking];
          filtros.maquinas = [...nextPreferences.maquinas];
          const ignoredDescriptionsChanged =
            rankingIgnoredDescriptions.join('|') !== nextPreferences.rankingIgnoredDescriptions.join('|');
          rankingIgnoredDescriptions = [...nextPreferences.rankingIgnoredDescriptions];
          maintenanceDescriptionTemplates = [...nextPreferences.maintenanceDescriptionTemplates];
          chartOrder = [...nextPreferences.order];
          setCheckedIds('ranking', nextPreferences.ranking);
          setCheckedIds('maquinas', nextPreferences.maquinas);
          setRankingIgnoredDescriptionsValue(nextPreferences.rankingIgnoredDescriptions);
          setMaintenanceDescriptionTemplatesValue(nextPreferences.maintenanceDescriptionTemplates);
          setOrderSelectValues(chartOrder);
          hideOrderAlert();

          if (ignoredDescriptionsChanged) {
            window.location.reload();
            return;
          }

          chartConfigs = buildChartConfigs();
          const nextIndex = Math.max(chartConfigs.findIndex((config) => config.id === currentChartId), 0);
          rotateTo(nextIndex);
        });
      }

      applyChart(0);
    });
  </script>
</body>

</html>
