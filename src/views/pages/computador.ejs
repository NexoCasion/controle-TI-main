<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Informações do Computador</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>

  <% if (alert) { %>
  <script>
    alert('<%= alert %>');
  </script>
  <% } %>

  <div class="container">
    <a href="javascript:history.back()" class="btn btn-back">
      <i class="fas fa-arrow-left"></i>
    </a>
    <h1 class="mt-4 mb-4">Informações do Computador</h1>

    <div class="card p-3 mb-3" style="border: 0;">
      <h2 class="pc-title mb-1">Patrimônio: <%= computador.patrimonio %></h2>

      <p class="mb-1">
        Pertence à: <b><%= computador.empresa ? computador.empresa.nome : '-' %></b>
      </p>

      <p class="mb-1">Local: <b><%= computador.setor %></b></p>
      <small class="text-muted d-block" style="white-space: pre-line;"><%= (computador.specs_override || computador.specs || '-') %></small>

      <div class="mt-2">
        <small id="createdAtFormatted" class="text-muted"></small>
      </div>
    </div>

    <% if ((computador.specs_modo || 'LEGADO') !== 'ESTRUTURADO') { %>
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        Esta máquina ainda está em modo legado. Converta para estruturado para registrar componentes reais e usar troca de peça com consistência.
      </div>
      <button type="button" class="btn btn-sm btn-dark" id="btnConverterEstruturadoFromView">
        Converter para Estruturado
      </button>
    </div>
    <% } %>

    <div class="maintenance-">
      <div class="d-flex gap-2 justify-content-center flex-wrap">
        <button type="button" class="btn btn-outline-secondary btn-sm btn-verpcs" id="btnTransferPcFromView" data-bs-toggle="modal" data-bs-target="#modalTransferPc">
          <i class="fas fa-exchange-alt"></i> Transferir Unidade
        </button>
        <button type="button" class="btn btn-primary btn-sm btn-verpcs" id="btnEditPcFromView" data-bs-toggle="modal" data-bs-target="#modalEditPc">
          <i class="fas fa-pencil-alt"></i> Editar PC
        </button>
        <button type="button" id="btnRegisterManutFromView" class="btn btn-outline-secondary btn-sm btn-verpcs" data-bs-toggle="modal" data-bs-target="#modalRegisterManutencao">
          Registrar Manutenção
        </button>
      </div>
    </div>

    <h1 class="mt-4 mb-3">Histórico do Computador</h1>
    <div class="table-responsive" id="manutencoesTable"></div>
  </div>

  <%- include("../partials/modals/modal_edit_pc") %>
  <%- include("../partials/modals/modal_transfer_pc", { empresas: (typeof empresas !== 'undefined' ? empresas : []) }) %>
  <%- include("../partials/modals/modal_register_manutencao", { empresas: (typeof empresas !== 'undefined' ? empresas : []) }) %>

  <div class="modal fade" id="modalEscolhaEstruturadoPc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Converter máquina legado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Esta máquina ainda está em modo legado.</p>
          <p class="text-muted mb-0">Escolha se deseja converter por cadastro manual ou por CSV do HWiNFO.</p>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary" id="btnAbrirEstruturadoManualPc">
            Cadastro manual
          </button>
          <button type="button" class="btn btn-primary" id="btnAbrirEstruturadoCsvPc">
            Enviar CSV
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalEstruturadoCsvPc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" id="formEstruturadoCsvPc" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">Converter por CSV</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-light border text-start">
            O patrimônio, local e empresa atuais serão mantidos. O CSV será usado para montar os componentes reais desta máquina.
          </div>
          <label for="csvEstruturadoPc" class="form-label">Arquivo CSV do HWiNFO</label>
          <input type="file" class="form-control" id="csvEstruturadoPc" name="csvFile" accept=".csv" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Importar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal fade" id="modalEstruturadoManualPc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <form class="modal-content" id="formEstruturadoManualPc">
        <div class="modal-header">
          <h5 class="modal-title">Converter manualmente para estruturado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="manualNomeComputadorPc" class="form-label">Nome do computador</label>
              <input type="text" class="form-control" id="manualNomeComputadorPc" name="nomeComputador" placeholder="Ex: FELIPE-TI">
            </div>
            <div class="col-md-6">
              <label for="manualModeloComputadorPc" class="form-label">Modelo</label>
              <input type="text" class="form-control" id="manualModeloComputadorPc" name="modeloComputador" placeholder="Ex: DELL OptiPlex 7050" required>
            </div>
            <div class="col-12">
              <label for="manualProcessadorPc" class="form-label">Processador</label>
              <input type="text" class="form-control" id="manualProcessadorPc" name="processador" placeholder="Ex: Intel Core i5-6500" required>
            </div>
            <div class="col-md-6">
              <label for="manualMemoriaPc" class="form-label">Memória</label>
              <textarea class="form-control" id="manualMemoriaPc" name="memoria" rows="3" placeholder="Um item por linha&#10;Ex: 8 GB DDR4 2133 MT/s" required></textarea>
              <small class="text-muted">Use uma linha por módulo, se houver mais de um.</small>
            </div>
            <div class="col-md-6">
              <label for="manualArmazenamentoPc" class="form-label">Armazenamento</label>
              <textarea class="form-control" id="manualArmazenamentoPc" name="armazenamento" rows="3" placeholder="Um item por linha&#10;Ex: NVME SSD 256GB - 256 GB" required></textarea>
              <small class="text-muted">Use uma linha por unidade de armazenamento.</small>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Converter</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // @ts-nocheck
    document.addEventListener("DOMContentLoaded", function() {
      const createdAt = "<%= computador.createdAt %>";
      const createdAtFormatted = new Date(createdAt).toLocaleString("pt-BR", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
      document.getElementById("createdAtFormatted").textContent =
        "Registrado em: " + createdAtFormatted;

      const pcCtx = <%- JSON.stringify({
        id: computador.id,
        patrimonio: computador.patrimonio || "",
        setor: computador.setor || "",
        specs: (computador.specs_override || computador.specs || ""),
        specsModo: computador.specs_modo || "LEGADO",
        empresaId: computador.empresaId ?? ""
      }) %>;

      const btnRegisterManutFromView = document.getElementById("btnRegisterManutFromView");
      const btnAddManFromEdit = document.getElementById("btnAddManutencaoFromEdit");
      const btnTransferFromEdit = document.getElementById("btnTransferirFromEdit");
      const btnConverterEstruturadoFromView = document.getElementById("btnConverterEstruturadoFromView");
      const btnAbrirEstruturadoManualPc = document.getElementById("btnAbrirEstruturadoManualPc");
      const btnAbrirEstruturadoCsvPc = document.getElementById("btnAbrirEstruturadoCsvPc");
      const formEstruturadoManualPc = document.getElementById("formEstruturadoManualPc");
      const formEstruturadoCsvPc = document.getElementById("formEstruturadoCsvPc");

      if (btnAddManFromEdit) btnAddManFromEdit.style.display = "none";
      if (btnTransferFromEdit) btnTransferFromEdit.style.display = "none";

      function switchModal(fromId, toId, beforeOpen = null) {
        const fromEl = document.getElementById(fromId);
        const toEl = document.getElementById(toId);
        if (!fromEl || !toEl) return;

        const fromInst = bootstrap.Modal.getInstance(fromEl) || new bootstrap.Modal(fromEl);
        const toInst = bootstrap.Modal.getOrCreateInstance(toEl);

        fromEl.addEventListener(
          "hidden.bs.modal",
          () => {
            if (typeof beforeOpen === "function") beforeOpen();
            toInst.show();
          }, {
            once: true
          }
        );

        fromInst.hide();
      }

      async function fetchJson(url, opts) {
        const res = await fetch(url, opts);
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error || "Erro na requisição");
        return data;
      }

      const btnEdit = document.getElementById("btnEditPcFromView");
      if (btnEdit) {
        btnEdit.addEventListener("click", () => {
          const form = document.getElementById("formEditPc");
          const inPatrimonio = document.getElementById("editPatrimonio");
          const inSetor = document.getElementById("editSetor");
          const inSpecs = document.getElementById("editSpecs");
          const inSpecsModo = document.getElementById("specsModo");
          const inSpecsHelp = document.getElementById("editSpecsHelp");

          if (form) form.action = `/editar-pc?id=${pcCtx.id}`;
          if (inPatrimonio) inPatrimonio.value = pcCtx.patrimonio;
          if (inSetor) inSetor.value = pcCtx.setor;
          if (inSpecs) {
            inSpecs.value = pcCtx.specs;
            inSpecs.readOnly = pcCtx.specsModo === "ESTRUTURADO";
          }
          if (inSpecsModo) inSpecsModo.value = pcCtx.specsModo || "LEGADO";
          if (inSpecsHelp) {
            inSpecsHelp.textContent = pcCtx.specsModo === "ESTRUTURADO" ?
              "Este computador esta em modo estruturado. As specs sao recalculadas pelos componentes vinculados." :
              "Edite as specs livremente para computadores no modo legado.";
          }

          window.__editPcCtx = {
            computadorId: pcCtx.id,
            empresaId: pcCtx.empresaId ?? "",
          };
        });
      }

      const btnTransferView = document.getElementById("btnTransferPcFromView");
      if (btnTransferView) {
        btnTransferView.addEventListener("click", () => {
          const inputPc = document.getElementById("transferComputadorId");
          const inputOrigem = document.getElementById("transferEmpOrigemId");
          const selectDestino = document.getElementById("transferEmpDestinoId");

          if (inputPc) inputPc.value = pcCtx.id;
          if (inputOrigem) inputOrigem.value = pcCtx.empresaId ?? "";
          if (selectDestino) selectDestino.value = "";
        });
      }

      if (btnRegisterManutFromView) {
        btnRegisterManutFromView.addEventListener("click", () => {
          window.__prefManutencao = {
            empresaId: pcCtx.empresaId ?? "",
            computadorId: pcCtx.id,
          };
        });
      }

      if (btnConverterEstruturadoFromView) {
        btnConverterEstruturadoFromView.addEventListener("click", () => {
          const modal = document.getElementById("modalEscolhaEstruturadoPc");
          if (!modal) return;
          bootstrap.Modal.getOrCreateInstance(modal).show();
        });
      }

      if (btnAbrirEstruturadoManualPc) {
        btnAbrirEstruturadoManualPc.addEventListener("click", () => {
          switchModal("modalEscolhaEstruturadoPc", "modalEstruturadoManualPc");
        });
      }

      if (btnAbrirEstruturadoCsvPc) {
        btnAbrirEstruturadoCsvPc.addEventListener("click", () => {
          switchModal("modalEscolhaEstruturadoPc", "modalEstruturadoCsvPc");
        });
      }

      if (formEstruturadoManualPc) {
        formEstruturadoManualPc.addEventListener("submit", async (e) => {
          e.preventDefault();

          try {
            const payload = Object.fromEntries(new FormData(formEstruturadoManualPc).entries());
            await fetchJson(`/computadores/${pcCtx.id}/estruturado-manual`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify(payload),
            });

            window.location.reload();
          } catch (err) {
            alert(err.message || "Erro ao converter manualmente.");
          }
        });
      }

      if (formEstruturadoCsvPc) {
        formEstruturadoCsvPc.addEventListener("submit", async (e) => {
          e.preventDefault();

          try {
            const body = new FormData(formEstruturadoCsvPc);
            const res = await fetch(`/computadores/${pcCtx.id}/importar-hwinfo-csv`, {
              method: "POST",
              body,
            });

            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data?.error || "Erro ao importar CSV.");

            window.location.reload();
          } catch (err) {
            alert(err.message || "Erro ao importar CSV.");
          }
        });
      }

      let sortCol = null;
      let sortAsc = true;

      function ordenarTabela(index) {
        const table = document.getElementById("tabela-manutencoes");
        if (!table) return;
        const tbody = table.querySelector("tbody");
        if (!tbody) return;

        const rows = Array.from(tbody.querySelectorAll("tr"));
        const asc = (sortCol === index) ? !sortAsc : true;
        sortCol = index;
        sortAsc = asc;

        rows.sort((ra, rb) => {
          const aCell = ra.children[index];
          const bCell = rb.children[index];

          const aIso = aCell?.getAttribute("data-iso") || "";
          const bIso = bCell?.getAttribute("data-iso") || "";

          const aDate = aIso ? new Date(aIso) : null;
          const bDate = bIso ? new Date(bIso) : null;

          if (aDate && bDate && !Number.isNaN(aDate) && !Number.isNaN(bDate)) {
            return asc ? (aDate - bDate) : (bDate - aDate);
          }

          const a = (aCell?.textContent || "").trim().toLowerCase();
          const b = (bCell?.textContent || "").trim().toLowerCase();
          return asc ? a.localeCompare(b) : b.localeCompare(a);
        });

        rows.forEach((r) => tbody.appendChild(r));
      }

      window.ordenarTabela = ordenarTabela;

      function formatarData(iso, textoVazio = "-") {
        if (!iso) return textoVazio;

        return new Date(iso).toLocaleString("pt-BR", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      function carregarHistorico() {
        const computadorId = pcCtx.id;

        fetch(`/manutencoes-by-computador?id=${computadorId}`)
          .then((response) => response.json())
          .then((data) => {
            const historico = Array.isArray(data) ? data : [];
            const manutencaoAberta = historico.find(
              (item) => item.tipo === "MANUTENCAO" && !item.dataFim
            );

            if (btnRegisterManutFromView) {
              if (manutencaoAberta) {
                btnRegisterManutFromView.disabled = true;
                btnRegisterManutFromView.title = "Este computador já possui manutenção em aberto.";
              } else {
                btnRegisterManutFromView.disabled = false;
                btnRegisterManutFromView.title = "";
              }
            }

            const table = document.createElement("table");
            table.classList.add("table");
            table.id = "tabela-manutencoes";

            const thead = document.createElement("thead");
            const trHead = document.createElement("tr");

            const headers = [
              { label: "ID", index: 0 },
              { label: "Tipo", index: 1 },
              { label: "Data", index: 2 },
              { label: "Status / Destino", index: 3 },
              { label: "Descrição", index: 4 },
              { label: "Ação", index: null },
            ];

            headers.forEach((h) => {
              const th = document.createElement("th");
              th.textContent = h.label;

              if (h.index !== null) {
                th.style.cursor = "pointer";
                th.onclick = () => ordenarTabela(h.index);
              }

              trHead.appendChild(th);
            });

            thead.appendChild(trHead);
            table.appendChild(thead);

            const tbody = document.createElement("tbody");

            historico.forEach((item) => {
              const trBody = document.createElement("tr");
              const colunas = [
                { texto: item.id, iso: "" },
                {
                  texto: item.tipo === "TRANSFERENCIA" ? "Transferência" : "Manutenção",
                  iso: "",
                },
                {
                  texto: formatarData(item.dataReferencia),
                  iso: item.dataReferencia || "",
                },
                {
                  texto:
                    item.tipo === "TRANSFERENCIA"
                      ? `${item.origem || "-"} -> ${item.destino || "-"}`
                      : (item.dataFim ? formatarData(item.dataFim) : "Manutenção em andamento"),
                  iso: item.tipo === "TRANSFERENCIA" ? "" : (item.dataFim || ""),
                },
                {
                  texto: item.descricao || "-",
                  iso: "",
                },
              ];

              colunas.forEach((coluna) => {
                const td = document.createElement("td");
                td.textContent = coluna.texto;
                td.setAttribute("data-iso", coluna.iso || "");
                trBody.appendChild(td);
              });

              const tdAcao = document.createElement("td");

              if (item.tipo === "MANUTENCAO") {
                const linkVerManutencao = document.createElement("a");
                linkVerManutencao.href = `/ver-manutencao?id=${item.id}`;
                linkVerManutencao.innerHTML = '<i class="fas fa-eye"></i>';
                linkVerManutencao.className = "btn btn-primary btn-sm";
                tdAcao.appendChild(linkVerManutencao);
              } else {
                tdAcao.textContent = "-";
              }

              trBody.appendChild(tdAcao);
              tbody.appendChild(trBody);
            });

            table.appendChild(tbody);
            document.getElementById("manutencoesTable").innerHTML = "";
            document.getElementById("manutencoesTable").appendChild(table);
          })
          .catch((error) => console.error("Erro ao carregar histórico:", error));
      }

      carregarHistorico();
    });
  </script>
</body>

</html>
