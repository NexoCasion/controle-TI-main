<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cadastro de Manutenção</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>

<body>
  <header class="headerComponent">
    <%- include("./../partials/header.ejs") %>
  </header>

  <main>
    <div class="container mt-4 page-shell-sm">
      <div class="card soft-card">
        <div class="card-body text-center p-4">
          <%- include('../partials/forms/register_manutencao_form', { inModal: false }) %>
        </div>
      </div>
    </div>
  </main>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    $(document).ready(function() {
      const $empresa = $('#empresa');
      const $computador = $('#computador');
      const $computadorGroup = $('#computadorGroup');
      const $computadorFiltro = $('#computadorFiltro');
      const $computadorResumo = $('#computadorResumo');
      const $descricaoPreset = $('#descricaoPreset');
      const $descricao = $('#descricao');
      let computadoresDisponiveis = [];
      let computadoresEmManutencao = new Set();

      function formatarComputador(computador) {
        return [computador.id, computador.patrimonio || '-', computador.setor || '-'].join(' - ');
      }

      function resetComputadores() {
        $computador.empty().append('<option value="" selected disabled>Selecione o Computador</option>');
        $computadorResumo.text('Selecione uma empresa para carregar as máquinas.');
      }

      function renderizarComputadores(prefId = null) {
        const termo = String($computadorFiltro.val() || '').trim().toLowerCase();
        const disponiveis = computadoresDisponiveis.filter((computador) => !computadoresEmManutencao.has(Number(computador.id)));
        const filtrados = !termo
          ? disponiveis
          : disponiveis.filter((computador) => formatarComputador(computador).toLowerCase().includes(termo));

        resetComputadores();

        if (!filtrados.length) {
          $computador.append($('<option>', {
            value: '',
            text: disponiveis.length
              ? 'Nenhum computador encontrado com esse filtro'
              : 'Nenhum computador disponível para nova manutenção',
            disabled: true
          }));
        } else {
          filtrados.forEach(function(computador) {
            $computador.append($('<option>', {
              value: computador.id,
              text: formatarComputador(computador)
            }));
          });
        }

        $computadorResumo.text(`${filtrados.length} de ${disponiveis.length} computadores disponíveis para manutenção.`);

        if (prefId) {
          $computador.val(String(prefId));
        }

        $computadorGroup.show();
      }

      function carregarEmpresas() {
        $.get('/get-empresas', function(data) {
          $empresa.empty().append('<option value="" selected disabled>Selecione a Empresa</option>');
          data.forEach(function(empresa) {
            $empresa.append($('<option>', {
              value: empresa.id,
              text: empresa.nome
            }));
          });
        });
      }

      function carregarComputadores(empresaId) {
        resetComputadores();

        if (!empresaId) {
          $computadorFiltro.val('');
          $computadorGroup.hide();
          return;
        }

        $computadorResumo.text('Carregando computadores...');

        $.when(
          $.get(`/computadores-by-empresa?empresaId=${encodeURIComponent(empresaId)}&limit=all&sortBy=patrimonio&sortDir=ASC`),
          $.get('/manutencoes-open')
        ).done(function(resultadoResp, manutResp) {
          const resultado = resultadoResp[0];
          const manutencoes = manutResp[0];
          const lista = Array.isArray(resultado?.rows) ? resultado.rows : (Array.isArray(resultado) ? resultado : []);

          computadoresDisponiveis = lista;
          computadoresEmManutencao = new Set(
            (Array.isArray(manutencoes) ? manutencoes : [])
              .map((manutencao) => Number(manutencao.computadorId))
              .filter((id) => Number.isFinite(id))
          );

          renderizarComputadores();
        }).fail(function() {
          resetComputadores();
          $computadorResumo.text('Erro ao carregar os computadores desta empresa.');
          $computadorGroup.show();
        });
      }

      $empresa.on('change', function() {
        $computadorFiltro.val('');
        carregarComputadores($(this).val());
      });

      $computadorFiltro.on('input', function() {
        renderizarComputadores($computador.val());
      });

      $descricaoPreset.on('change', function() {
        const valor = String($(this).val() || '').trim();
        if (!valor) return;

        $descricao.val(valor).trigger('focus');
        const elemento = $descricao.get(0);
        if (elemento && typeof elemento.setSelectionRange === 'function') {
          elemento.setSelectionRange(elemento.value.length, elemento.value.length);
        }
      });

      carregarEmpresas();
    });
  </script>
</body>

</html>
