<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ver Manutenção</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>

  <% if (alert) { %>
  <script>
    alert('<%= alert %>');
  </script>
  <% } %>

  <div class="container maintenance-page">
    <a href="javascript:history.back()" class="btn btn-back">
      <i class="fas fa-arrow-left"></i>
    </a>

    <h1 class="mt-4 mb-4 text-center">Informações da Manutenção</h1>

    <div class="card p-3 mb-4" style="border:0;">
      <div class="row g-3 justify-content-center text-start">
        <div class="maint-titlebar mb-3">
          <h2 class="pc-title mb-0">
            Manutenção #<%= manutencao.id %>
            <% if (manutencao?.computador?.status) { %>
            <span class="badge bg-danger ms-2">PC CONDENADO</span>
            <% } %>
          </h2>

          <% if (manutencao.dataSaida) { %>
          <span class="maint-finalizada">
            <i class="fas fa-check-circle"></i> Finalizada
          </span>
          <% } %>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Computador</div>
          <div class="meta-value text-center">
            <% if (manutencao?.computador) { %>
            <%= manutencao.computador.patrimonio %>
            <% } else { %>
            Não possui número de Patrimônio
            <% } %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Entrada</div>
          <div class="meta-value text-center">
            <span class="js-dt" data-iso="<%= manutencao.dataEntrada || '' %>">
              <%= manutencao.dataEntrada ? manutencao.dataEntrada : '-' %>
            </span>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Saída</div>
          <div class="meta-value text-center">
            <% if (manutencao.dataSaida) { %>
            <span class="js-dt" data-iso="<%= manutencao.dataSaida || '' %>">
              <%= manutencao.dataSaida %>
            </span>
            <% } else { %>
            Em andamento
            <% } %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Local</div>
          <div class="meta-value text-center">
            <%= manutencao?.computador?.setor ? manutencao.computador.setor : '-' %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Pertence à</div>
          <div class="meta-value text-center">
            <%= manutencao?.computador?.empresa?.nome ? manutencao.computador.empresa.nome : '-' %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Descrição</div>
          <div class="meta-value text-center">
            <%= manutencao.descricao ? manutencao.descricao : '-' %>
          </div>
        </div>

        <div class="col-12">
          <div class="meta-label text-center">Specs</div>
          <div class="text-muted text-center">
            <%= (manutencao?.computador?.specs_override ? manutencao.computador.specs_override : (manutencao?.computador?.specs || '-')) %>
          </div>
        </div>
      </div>
    </div>

    <div class="maintenance-nav">
      <a class="btn btn-outline-secondary btn-sm" href="/manutencoes">
        <i class="fas fa-arrow-left"></i> Voltar para Manutenções
      </a>

      <% if (manutencao?.computador?.id) { %>
      <a class="btn btn-primary btn-sm" href="/ver-pc?id=<%= manutencao.computador.id %>">
        <i class="fas fa-desktop"></i> Ver PC
      </a>
      <% } %>
    </div>

    <h1 class="mt-4 mb-3">Histórico de Procedimentos</h1>

    <% if (!manutencao.dataSaida) { %>
    <div class="maintenance-actions mb-3 align-items-center justify-content-center">
      <a class="btn btn-secondary btn-sm" href="/encerrar-manutencao?id=<%= manutencao.id %>" onclick="return confirm('Tem certeza que deseja FECHAR esta manutenção?');">
        <i class="fas fa-check"></i> Fechar manutenção
      </a>

      <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddProcedimento">
        <i class="fas fa-plus"></i> Adicionar procedimento
      </button>

      <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalCondenarMaquina">
        <i class="fas fa-ban"></i> Condenar máquina
      </button>
    </div>
    <% } %>

    <% const itensSafe = (typeof manutencoes !== 'undefined' && manutencoes) ? manutencoes : []; %>
    <% if (itensSafe.length) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Descrição</th>
            <th>Material</th>
            <th>Data</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>

        <tbody>
          <% itensSafe.forEach((item) => { %>
          <tr>
            <td>
              <span class="badge bg-secondary"><%= item.tipo || '-' %></span>
            </td>

            <td><%= item.descricao || '-' %></td>

            <td style="max-width: 340px;">
              <small class="text-muted"><%= item.material_snapshot || '-' %></small>
            </td>

            <td>
              <span class="js-dt" data-iso="<%= (item.dataEntrada || item.createdAt || '') %>">
                <%= item.dataEntrada || item.createdAt || '-' %>
              </span>
            </td>

            <td>
              <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalDetalhesProcedimento" data-tipo="<%= (item.tipo || '') %>" data-desc="<%= (item.descricao || '').replace(/\"/g, '&quot;') %>" data-snap="<%= (item.material_snapshot || '').replace(/\"/g, '&quot;') %>" data-antes="<%= (item.specs_antes || '').replace(/\"/g, '&quot;') %>" data-depois="<%= (item.specs_depois || '').replace(/\"/g, '&quot;') %>">
                Detalhes
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-muted" style="padding:10px 0;">
      Nenhum item adicional para esta manutenção.
    </div>
    <% } %>
  </div>

  <!-- Modal: Adicionar Procedimento -->
  <div class="modal fade" id="modalAddProcedimento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <form class="modal-content" id="formAddProcedimento">
        <div class="modal-header">
          <h5 class="modal-title">Adicionar procedimento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="manutencaoId" value="<%= manutencao.id %>">

          <% const specsFinal = (manutencao?.computador?.specs_override ? manutencao.computador.specs_override : (manutencao?.computador?.specs || '')); %>
          <input type="hidden" id="specsBase" value="<%- (specsFinal || '').replace(/\"/g, '&quot;') %>">

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Tipo de procedimento</label>
              <select class="form-select" name="tipo" id="tipoProcedimento" required>
                <option value="" selected disabled>Selecione...</option>
                <option value="TROCA_PECA">Troca de peça</option>
                <option value="LIMPEZA">Limpeza</option>
                <option value="MANUT_SIMPLES">Manutenção simples</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label">Descrição</label>
              <textarea class="form-control" name="descricao" rows="3" required placeholder="Ex: Troca de fonte, limpeza, reinstalação do Windows..."></textarea>
              <small class="text-muted d-block mt-2">
                Isso vai aparecer no “Histórico de Procedimentos”.
              </small>
            </div>

            <div class="col-12" id="blocoTrocaPeca" style="display:none;">
              <div class="card p-3" style="border:1px solid #eee;">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">Tipo de peça</label>
                    <select class="form-select" id="tipoPeca" name="tipoPeca">
                      <option value="" selected disabled>Selecione...</option>
                    </select>
                    <small class="text-muted">Carregado de Materiais</small>
                  </div>

                  <div class="col-md-5">
                    <label class="form-label">Material disponível</label>
                    <select class="form-select" name="materialId" id="materialId">
                      <option value="" selected disabled>Selecione o tipo primeiro...</option>
                    </select>
                    <small class="text-muted" id="infoDisponivel"></small>
                  </div>

                  <div class="col-md-3">
                    <label class="form-label">Quantidade</label>
                    <input class="form-control" type="number" name="quantidade" id="quantidade" min="1" value="1">
                  </div>

                  <div class="col-12">
                    <label class="form-label">Editar Specs (vai salvar em specs_override)</label>
                    <textarea class="form-control" name="specs_depois" id="specsDepois" rows="3"></textarea>
                    <small class="text-muted">
                      Começa com as specs atuais (override se existir). Você edita a string livre.
                    </small>

                    <hr class="my-3">

                    <h6 class="mb-2">Peça removida (obrigatório)</h6>

                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="form-label">Tipo removido</label>
                        <select class="form-select" id="tipoRemovido">
                          <option value="" selected disabled>Selecione...</option>
                        </select>
                        <small class="text-muted">Carregado de Materiais</small>
                      </div>

                      <div class="col-md-5">
                        <label class="form-label">Material removido</label>
                        <select class="form-select" id="materialRemovidoId">
                          <option value="" selected disabled>Selecione o tipo removido primeiro...</option>
                        </select>
                        <small class="text-muted" id="infoRemovido"></small>
                      </div>

                      <div class="col-md-3">
                        <label class="form-label">Qtd removida</label>
                        <input class="form-control" type="number" id="qtdRemovida" min="1" value="1">
                      </div>

                      <div class="col-md-5">
                        <label class="form-label">Destino</label>
                        <select class="form-select" id="destinoRemovida">
                          <option value="RECUPERAR">Recuperar</option>
                          <option value="DEFEITO">Defeito (baixar)</option>
                        </select>
                      </div>

                      <div class="col-md-7">
                        <label class="form-label">Motivo (obrigatório se Defeito)</label>
                        <input class="form-control" id="motivoRemovida" placeholder="Ex: queimada, instável, sem vídeo...">
                      </div>

                      <div class="col-12">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCadastrarRemovida">
                          + Cadastrar item removido
                        </button>
                        <small class="text-muted ms-2">Use quando o modelo removido não existir no sistema.</small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btnSalvarProcedimento">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Condenar Máquina -->
  <div class="modal fade" id="modalCondenarMaquina" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formCondenarMaquina">
        <div class="modal-header">
          <h5 class="modal-title">Condenar máquina</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="manutencaoId" value="<%= manutencao.id %>">

          <div class="alert alert-warning mb-3">
            <b>Atenção:</b> condenar é irreversível. O PC será marcado como condenado e a manutenção será encerrada.
          </div>

          <label class="form-label">Motivo</label>
          <textarea class="form-control" name="motivo" rows="3" required placeholder="Ex: Placa-mãe queimada, custo inviável, sem peças..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-danger">Próximo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Recuperação de Componentes -->
  <div class="modal fade" id="modalRecuperacaoComponentes" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <form class="modal-content" id="formRecuperacaoComponentes">
        <div class="modal-header">
          <h5 class="modal-title">Recuperação de Componentes</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="recManutencaoId" value="<%= manutencao.id %>">
          <input type="hidden" id="recMotivoCondenacao" value="">

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <div class="meta-label text-center">Patrimônio</div>
              <div class="meta-value text-center">
                <%= manutencao?.computador?.patrimonio || '-' %>
              </div>
            </div>

            <div class="col-md-4">
              <div class="meta-label text-center">Local</div>
              <div class="meta-value text-center">
                <%= manutencao?.computador?.setor || '-' %>
              </div>
            </div>

            <div class="col-md-4">
              <div class="meta-label text-center">Empresa</div>
              <div class="meta-value text-center">
                <%= manutencao?.computador?.empresa?.nome || '-' %>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Componentes recuperados / condenados</h6>
            <button type="button" class="btn btn-sm btn-secondary" id="btnAdicionarLinhaRecuperacao">
              <i class="fas fa-plus"></i> Adicionar componente
            </button>
          </div>

          <div class="table-responsive">
            <table class="table table-bordered align-middle">
              <thead>
                <tr>
                  <th>Tipo</th>
                  <th>Material</th>
                  <th>Qtd</th>
                  <th>Destino</th>
                  <th>Motivo</th>
                  <th class="text-center">Ações</th>
                </tr>
              </thead>
              <tbody id="tbodyRecuperacao">
                <tr id="linhaVaziaRecuperacao">
                  <td colspan="6" class="text-muted text-center">
                    Nenhum componente adicionado ainda.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="alert alert-info mt-3 mb-0">
            <b>Recuperar</b> devolve a peça para o estoque disponível. <br>
            <b>Defeito</b> envia a peça para a quantidade baixada.
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar condenação e recuperação</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Detalhes do Procedimento -->
  <div class="modal fade" id="modalDetalhesProcedimento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Detalhes do procedimento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-2"><strong>Tipo:</strong> <span id="detTipo"></span></div>
          <div class="mb-2"><strong>Descrição:</strong> <span id="detDesc"></span></div>

          <div class="mb-3">
            <label class="form-label"><strong>Resumo da troca</strong></label>
            <textarea class="form-control" id="detSnap" rows="5" readonly></textarea>
          </div>

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Specs antes</label>
              <textarea class="form-control" id="detAntes" rows="3" readonly></textarea>
            </div>
            <div class="col-12">
              <label class="form-label">Specs depois</label>
              <textarea class="form-control" id="detDepois" rows="3" readonly></textarea>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Cadastrar item removido -->
  <div class="modal fade" id="modalCadastrarRemovida" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formCadastrarRemovida">
        <div class="modal-header">
          <h5 class="modal-title">Cadastrar item removido</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label">Tipo</label>
            <input class="form-control" id="cadRemTipo" required readonly>
            <small class="text-muted">Vem do “Tipo removido”.</small>
          </div>

          <div class="mb-2">
            <label class="form-label">Material</label>
            <input class="form-control" id="cadRemMaterial" required placeholder="Ex: Fonte ATX">
          </div>

          <div class="mb-2">
            <label class="form-label">Marca</label>
            <input class="form-control" id="cadRemMarca" placeholder="Ex: Razer">
          </div>

          <div class="mb-2">
            <label class="form-label">Especificação</label>
            <input class="form-control" id="cadRemEspecificacao" placeholder="Ex: 300W">
          </div>

          <div class="mb-2">
            <label class="form-label">NF (opcional)</label>
            <input class="form-control" id="cadRemNF">
          </div>

          <div class="alert alert-info mt-3 mb-0">
            Esse cadastro cria o material com <b>Qtd disponível = 0</b> e <b>Qtd em uso = 0</b>.
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
      </form>
    </div>
  </div>
  <div class="modal fade" id="modalCadastrarRecuperado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formCadastrarRecuperado">
        <div class="modal-header">
          <h5 class="modal-title">Cadastrar material recuperado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label">Tipo</label>
            <input class="form-control" id="cadRecTipo" required readonly>
            <small class="text-muted">Vem do tipo da linha da recuperação.</small>
          </div>

          <div class="mb-2">
            <label class="form-label">Material</label>
            <input class="form-control" id="cadRecMaterial" required placeholder="Ex: Fonte ATX">
          </div>

          <div class="mb-2">
            <label class="form-label">Marca</label>
            <input class="form-control" id="cadRecMarca" placeholder="Ex: Corsair">
          </div>

          <div class="mb-2">
            <label class="form-label">Especificação</label>
            <input class="form-control" id="cadRecEspecificacao" placeholder="Ex: 500W">
          </div>

          <div class="mb-2">
            <label class="form-label">NF (opcional)</label>
            <input class="form-control" id="cadRecNF">
          </div>

          <div class="alert alert-info mt-3 mb-0">
            Esse cadastro cria o material com <b>Qtd disponível = 0</b> e <b>Qtd em uso = 0</b>.
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    async function fetchJson(url, opts) {
      const res = await fetch(url, opts);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || 'Erro na requisição');
      return data;
    }

    function formatDateTimeBR(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return value;
      return d.toLocaleString('pt-BR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    document.addEventListener('DOMContentLoaded', async () => {
      document.querySelectorAll('.js-dt').forEach((el) => {
        const iso = (el.getAttribute('data-iso') || '').trim();
        if (!iso) return;
        el.textContent = formatDateTimeBR(iso);
      });

      const form = document.getElementById('formAddProcedimento');
      const tipoProcedimento = document.getElementById('tipoProcedimento');
      const blocoTrocaPeca = document.getElementById('blocoTrocaPeca');

      const tipoPeca = document.getElementById('tipoPeca');
      const materialId = document.getElementById('materialId');
      const quantidade = document.getElementById('quantidade');
      const specsDepois = document.getElementById('specsDepois');
      const specsBase = document.getElementById('specsBase');
      const infoDisponivel = document.getElementById('infoDisponivel');
      const btnSalvar = document.getElementById('btnSalvarProcedimento');

      const tipoRemovido = document.getElementById('tipoRemovido');
      const materialRemovidoId = document.getElementById('materialRemovidoId');
      const qtdRemovida = document.getElementById('qtdRemovida');
      const destinoRemovida = document.getElementById('destinoRemovida');
      const motivoRemovida = document.getElementById('motivoRemovida');
      const infoRemovido = document.getElementById('infoRemovido');

      const btnCadastrarRemovida = document.getElementById('btnCadastrarRemovida');
      const modalCadastrarRemovidaEl = document.getElementById('modalCadastrarRemovida');
      const formCadastrarRemovida = document.getElementById('formCadastrarRemovida');

      const formCondenarMaquina = document.getElementById('formCondenarMaquina');
      const modalCondenarMaquinaEl = document.getElementById('modalCondenarMaquina');
      const modalRecuperacaoComponentesEl = document.getElementById('modalRecuperacaoComponentes');
      const recMotivoCondenacao = document.getElementById('recMotivoCondenacao');

      const btnAdicionarLinhaRecuperacao = document.getElementById('btnAdicionarLinhaRecuperacao');
      const tbodyRecuperacao = document.getElementById('tbodyRecuperacao');
      const formRecuperacaoComponentes = document.getElementById('formRecuperacaoComponentes');

      let isSubmittingProcedimento = false;

      const modalCadastrarRecuperadoEl = document.getElementById('modalCadastrarRecuperado');
      const formCadastrarRecuperado = document.getElementById('formCadastrarRecuperado');
      let linhaRecuperacaoAtual = null;

      function setTrocaPecaEnabled(enabled) {
        blocoTrocaPeca.style.display = enabled ? 'block' : 'none';

        tipoPeca.disabled = !enabled;
        materialId.disabled = !enabled;
        quantidade.disabled = !enabled;
        specsDepois.disabled = !enabled;

        tipoRemovido.disabled = !enabled;
        materialRemovidoId.disabled = !enabled;
        qtdRemovida.disabled = !enabled;
        destinoRemovida.disabled = !enabled;
        motivoRemovida.disabled = !enabled;
        btnCadastrarRemovida.disabled = !enabled;

        tipoPeca.required = enabled;
        materialId.required = enabled;
        quantidade.required = enabled;

        tipoRemovido.required = enabled;
        materialRemovidoId.required = enabled;
        qtdRemovida.required = enabled;
        destinoRemovida.required = enabled;
      }

      setTrocaPecaEnabled(false);

      if (specsDepois && specsBase) {
        specsDepois.value = specsBase.value || '';
      }

      async function carregarTipos() {
        const tipos = await fetchJson('/materiais-tipos');

        tipoPeca.innerHTML = '<option value="" selected disabled>Selecione...</option>';
        tipoRemovido.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        tipos.forEach((t) => {
          const opt1 = document.createElement('option');
          opt1.value = t;
          opt1.textContent = t;
          tipoPeca.appendChild(opt1);

          const opt2 = document.createElement('option');
          opt2.value = t;
          opt2.textContent = t;
          tipoRemovido.appendChild(opt2);
        });
      }

      async function carregarMateriaisPorTipo(tipo) {
        materialId.innerHTML = '<option value="" selected disabled>Carregando...</option>';
        infoDisponivel.textContent = '';

        const list = await fetchJson(`/materiais?tipo=${encodeURIComponent(tipo)}&somenteDisponivel=1`);
        materialId.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Nenhum material disponível';
          opt.disabled = true;
          materialId.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'}) — Disp: ${m.quantidade_disponivel}`;
          opt.dataset.disponivel = m.quantidade_disponivel;
          materialId.appendChild(opt);
        });
      }

      async function carregarMateriaisRemovidosPorTipo(tipo) {
        materialRemovidoId.innerHTML = '<option value="" selected disabled>Carregando...</option>';
        infoRemovido.textContent = '';

        const list = await fetchJson(`/materiais?tipo=${encodeURIComponent(tipo)}`);
        materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Nenhum material cadastrado nesse tipo';
          opt.disabled = true;
          materialRemovidoId.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'}) — Disp:${m.quantidade_disponivel ?? 0} | Uso:${m.quantidade_em_uso ?? 0}`;
          opt.dataset.disponivel = m.quantidade_disponivel ?? 0;
          opt.dataset.uso = m.quantidade_em_uso ?? 0;
          materialRemovidoId.appendChild(opt);
        });
      }

      tipoProcedimento.addEventListener('change', async () => {
        const v = tipoProcedimento.value;

        if (v === 'TROCA_PECA') {
          setTrocaPecaEnabled(true);
          await carregarTipos();

          tipoPeca.value = '';
          materialId.innerHTML = '<option value="" selected disabled>Selecione o tipo primeiro...</option>';
          quantidade.value = 1;
          infoDisponivel.textContent = '';

          tipoRemovido.value = '';
          materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione o tipo removido primeiro...</option>';
          qtdRemovida.value = 1;
          destinoRemovida.value = 'RECUPERAR';
          motivoRemovida.value = '';
          infoRemovido.textContent = '';

          specsDepois.value = specsBase.value || '';
        } else {
          setTrocaPecaEnabled(false);

          tipoPeca.value = '';
          materialId.value = '';
          quantidade.value = 1;
          specsDepois.value = '';
          infoDisponivel.textContent = '';

          tipoRemovido.value = '';
          materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione o tipo removido primeiro...</option>';
          qtdRemovida.value = 1;
          destinoRemovida.value = 'RECUPERAR';
          motivoRemovida.value = '';
          infoRemovido.textContent = '';
        }
      });

      tipoRemovido.addEventListener('change', async () => {
        const tipo = tipoRemovido.value;
        if (!tipo) return;
        await carregarMateriaisRemovidosPorTipo(tipo);
      });

      tipoPeca.addEventListener('change', async () => {
        const tipo = tipoPeca.value;
        if (!tipo) return;

        await carregarMateriaisPorTipo(tipo);

        tipoRemovido.value = tipo;
        await carregarMateriaisRemovidosPorTipo(tipo);
      });

      materialId.addEventListener('change', () => {
        const opt = materialId.options[materialId.selectedIndex];
        const disp = Number(opt?.dataset?.disponivel || 0);
        infoDisponivel.textContent = disp ? `Disponível: ${disp}` : '';

        if (disp > 0) {
          quantidade.max = disp;
          if (Number(quantidade.value) > disp) quantidade.value = disp;
        }
      });

      materialRemovidoId.addEventListener('change', () => {
        const opt = materialRemovidoId.options[materialRemovidoId.selectedIndex];
        const disp = Number(opt?.dataset?.disponivel || 0);
        const uso = Number(opt?.dataset?.uso || 0);
        infoRemovido.textContent = `Disp: ${disp} | Em uso: ${uso}`;
      });

      btnCadastrarRemovida.addEventListener('click', () => {
        const tipo = tipoRemovido.value;
        if (!tipo) {
          alert('Selecione primeiro o Tipo removido.');
          return;
        }

        document.getElementById('cadRemTipo').value = tipo;
        document.getElementById('cadRemMaterial').value = '';
        document.getElementById('cadRemMarca').value = '';
        document.getElementById('cadRemEspecificacao').value = '';
        document.getElementById('cadRemNF').value = '';

        new bootstrap.Modal(modalCadastrarRemovidaEl).show();
      });

      formCadastrarRemovida.addEventListener('submit', async (e) => {
        e.preventDefault();

        const payload = {
          tipo: document.getElementById('cadRemTipo').value,
          material: document.getElementById('cadRemMaterial').value,
          marca: document.getElementById('cadRemMarca').value,
          especificacao: document.getElementById('cadRemEspecificacao').value,
          nf: document.getElementById('cadRemNF').value,
          quantidade_disponivel: 0,
          quantidade_em_uso: 0,
        };

        if (!payload.tipo || !payload.material) {
          alert('Tipo e Material são obrigatórios.');
          return;
        }

        try {
          await fetchJson('/materiais', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          bootstrap.Modal.getInstance(modalCadastrarRemovidaEl).hide();

          await carregarMateriaisRemovidosPorTipo(payload.tipo);
          const opts = [...materialRemovidoId.options];
          const found = opts.find(o => (o.textContent || '').includes(payload.material));
          if (found) materialRemovidoId.value = found.value;
        } catch (err) {
          alert(err.message || 'Erro ao cadastrar removida.');
        }
      });
      formCadastrarRecuperado.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!linhaRecuperacaoAtual) {
          alert('Linha da recuperação não identificada.');
          return;
        }

        const payload = {
          tipo: document.getElementById('cadRecTipo').value,
          material: document.getElementById('cadRecMaterial').value,
          marca: document.getElementById('cadRecMarca').value,
          especificacao: document.getElementById('cadRecEspecificacao').value,
          nf: document.getElementById('cadRecNF').value,
          quantidade_disponivel: 0,
          quantidade_em_uso: 0,
        };

        if (!payload.tipo || !payload.material) {
          alert('Tipo e Material são obrigatórios.');
          return;
        }

        try {
          await fetchJson('/materiais', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          bootstrap.Modal.getInstance(modalCadastrarRecuperadoEl).hide();

          const selectTipo = linhaRecuperacaoAtual.querySelector('.rec-tipo');
          const selectMaterial = linhaRecuperacaoAtual.querySelector('.rec-material');

          if (selectTipo) {
            selectTipo.value = payload.tipo;
          }

          await carregarMateriaisRecuperacaoPorTipo(payload.tipo, selectMaterial);

          const opts = [...selectMaterial.options];
          const found = opts.find(o => (o.textContent || '').includes(payload.material));
          if (found) selectMaterial.value = found.value;

          linhaRecuperacaoAtual = null;
        } catch (err) {
          alert(err.message || 'Erro ao cadastrar material recuperado.');
        }
      });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (isSubmittingProcedimento) return;
        isSubmittingProcedimento = true;
        btnSalvar.disabled = true;

        try {
          const fd = new FormData(form);
          const payload = Object.fromEntries(fd.entries());

          if (payload.tipo === 'TROCA_PECA') {
            if (!payload.materialId) throw new Error('Selecione um material.');

            const qtd = Number(payload.quantidade || 1);
            if (!qtd || qtd <= 0) throw new Error('Quantidade inválida.');
            payload.quantidade = qtd;
            payload.specs_depois = payload.specs_depois || '';

            if (!tipoRemovido.value) throw new Error('Selecione o tipo removido.');
            if (!materialRemovidoId.value) throw new Error('Selecione o material removido.');

            const remQtd = Number(qtdRemovida.value || 1);
            if (!remQtd || remQtd <= 0) throw new Error('Qtd removida inválida.');

            const dest = destinoRemovida.value;
            if (dest === 'DEFEITO' && (!motivoRemovida.value || !motivoRemovida.value.trim())) {
              throw new Error('Motivo é obrigatório quando destino = Defeito.');
            }

            payload.materialRemovidoId = Number(materialRemovidoId.value);
            payload.qtdRemovida = remQtd;
            payload.destinoRemovida = dest;
            payload.motivoRemovida = dest === 'DEFEITO' ? motivoRemovida.value.trim() : '';
          } else {
            delete payload.materialId;
            delete payload.quantidade;
            delete payload.specs_depois;
          }

          await fetchJson('/add-item-manutencao', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          window.location.reload();
        } catch (err) {
          alert(err.message || 'Erro ao salvar procedimento.');
        } finally {
          btnSalvar.disabled = false;
          isSubmittingProcedimento = false;
        }
      });

      formCondenarMaquina.addEventListener('submit', async (e) => {
        e.preventDefault();

        const motivoField = formCondenarMaquina.querySelector('textarea[name="motivo"]');
        const motivo = (motivoField?.value || '').trim();

        if (!motivo) {
          alert('Informe o motivo da condenação.');
          return;
        }

        recMotivoCondenacao.value = motivo;

        const modalCondenar = bootstrap.Modal.getInstance(modalCondenarMaquinaEl);
        if (modalCondenar) modalCondenar.hide();

        const modalRec = new bootstrap.Modal(modalRecuperacaoComponentesEl);
        modalRec.show();
      });

      async function carregarTiposRecuperacao(selectTipo) {
        const tipos = await fetchJson('/materiais-tipos');

        selectTipo.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        tipos.forEach((t) => {
          const opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          selectTipo.appendChild(opt);
        });
      }

      async function carregarMateriaisRecuperacaoPorTipo(tipo, selectMaterial) {
        selectMaterial.innerHTML = '<option value="" selected disabled>Carregando...</option>';

        const list = await fetchJson(`/materiais?tipo=${encodeURIComponent(tipo)}`);
        selectMaterial.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Nenhum material cadastrado nesse tipo';
          opt.disabled = true;
          selectMaterial.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'}) — Disp:${m.quantidade_disponivel ?? 0} | Uso:${m.quantidade_em_uso ?? 0}`;
          opt.dataset.disponivel = m.quantidade_disponivel ?? 0;
          opt.dataset.uso = m.quantidade_em_uso ?? 0;
          selectMaterial.appendChild(opt);
        });
      }

      async function adicionarLinhaRecuperacao() {
        const linhaVazia = document.getElementById('linhaVaziaRecuperacao');
        if (linhaVazia) linhaVazia.remove();

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <select class="form-select rec-tipo">
              <option value="" selected disabled>Selecione...</option>
            </select>
          </td>
          <td>
            <select class="form-select rec-material">
              <option value="" selected disabled>Selecione o tipo primeiro...</option>
            </select>
          </td>
          <td style="width:110px;">
            <input type="number" class="form-control rec-qtd" min="1" value="1">
          </td>
          <td style="width:180px;">
            <select class="form-select rec-destino">
              <option value="RECUPERAR">Recuperar</option>
              <option value="DEFEITO">Defeito</option>
            </select>
          </td>
          <td>
            <input type="text" class="form-control rec-motivo" placeholder="Obrigatório se defeito">
          </td>
          <td style="width:180px;" class="text-center">
          <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-sm btn-outline-secondary rec-cadastrar">
              + Registrar
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger rec-remover">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
        `;

        tbodyRecuperacao.appendChild(tr);

        const selectTipo = tr.querySelector('.rec-tipo');
        const selectMaterial = tr.querySelector('.rec-material');
        const selectDestino = tr.querySelector('.rec-destino');
        const inputMotivo = tr.querySelector('.rec-motivo');
        const btnRemover = tr.querySelector('.rec-remover');
        const btnCadastrar = tr.querySelector('.rec-cadastrar');

        await carregarTiposRecuperacao(selectTipo);

        selectTipo.addEventListener('change', async () => {
          const tipo = selectTipo.value;
          if (!tipo) return;
          await carregarMateriaisRecuperacaoPorTipo(tipo, selectMaterial);
        });

        selectDestino.addEventListener('change', () => {
          if (selectDestino.value === 'DEFEITO') {
            inputMotivo.placeholder = 'Motivo obrigatório';
          } else {
            inputMotivo.placeholder = 'Opcional';
            inputMotivo.value = '';
          }
        });
        btnCadastrar.addEventListener('click', () => {
          const tipo = selectTipo.value;

          if (!tipo) {
            alert('Selecione primeiro o tipo da linha.');
            return;
          }

          linhaRecuperacaoAtual = tr;

          document.getElementById('cadRecTipo').value = tipo;
          document.getElementById('cadRecMaterial').value = '';
          document.getElementById('cadRecMarca').value = '';
          document.getElementById('cadRecEspecificacao').value = '';
          document.getElementById('cadRecNF').value = '';

          new bootstrap.Modal(modalCadastrarRecuperadoEl).show();
        });
        btnRemover.addEventListener('click', () => {
          tr.remove();

          if (!tbodyRecuperacao.querySelector('tr')) {
            const trVazia = document.createElement('tr');
            trVazia.id = 'linhaVaziaRecuperacao';
            trVazia.innerHTML = `
              <td colspan="6" class="text-muted text-center">
                Nenhum componente adicionado ainda.
              </td>
            `;
            tbodyRecuperacao.appendChild(trVazia);
          }
        });
      }

      btnAdicionarLinhaRecuperacao.addEventListener('click', async () => {
        await adicionarLinhaRecuperacao();
      });

      formRecuperacaoComponentes.addEventListener('submit', async (e) => {
        e.preventDefault();

        const linhas = [...tbodyRecuperacao.querySelectorAll('tr')].filter(tr => !tr.id);

        if (!linhas.length) {
          alert('Adicione pelo menos um componente para continuar.');
          return;
        }

        const componentes = [];

        for (const tr of linhas) {
          const tipo = tr.querySelector('.rec-tipo')?.value || '';
          const matId = tr.querySelector('.rec-material')?.value || '';
          const qtd = Number(tr.querySelector('.rec-qtd')?.value || 0);
          const destino = tr.querySelector('.rec-destino')?.value || '';
          const motivo = (tr.querySelector('.rec-motivo')?.value || '').trim();

          if (!tipo) {
            alert('Selecione o tipo do componente.');
            return;
          }

          if (!matId) {
            alert('Selecione o material do componente.');
            return;
          }

          if (!qtd || qtd <= 0) {
            alert('Informe uma quantidade válida.');
            return;
          }

          if (!destino) {
            alert('Selecione o destino do componente.');
            return;
          }

          if (destino === 'DEFEITO' && !motivo) {
            alert('Informe o motivo para os itens marcados como defeito.');
            return;
          }

          componentes.push({
            tipo,
            materialId: Number(matId),
            quantidade: qtd,
            destino,
            motivo,
          });
        }

        const payload = {
          manutencaoId: Number(document.getElementById('recManutencaoId').value),
          motivoCondenacao: (document.getElementById('recMotivoCondenacao').value || '').trim(),
          componentes,
        };

        try {
          await fetchJson('/condenar-maquina-com-recuperacao', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          window.location.href = `/ver-manutencao?id=${payload.manutencaoId}`;
        } catch (err) {
          alert(err.message || 'Erro ao salvar condenação com recuperação.');
        }
      });
    });
  </script>

  <script>
    const modalDet = document.getElementById('modalDetalhesProcedimento');

    if (modalDet) {
      modalDet.addEventListener('show.bs.modal', function(event) {
        const btn = event.relatedTarget;
        if (!btn) return;

        document.getElementById('detTipo').textContent = btn.getAttribute('data-tipo') || '-';
        document.getElementById('detDesc').textContent = btn.getAttribute('data-desc') || '-';
        document.getElementById('detSnap').value =
          (btn.getAttribute('data-snap') || '-').replaceAll(' || ', '\n\n');
        document.getElementById('detAntes').value = btn.getAttribute('data-antes') || '';
        document.getElementById('detDepois').value = btn.getAttribute('data-depois') || '';
      });
    }
  </script>
</body>

</html>
