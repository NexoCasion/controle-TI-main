<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ver Manutenção</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    #modalAddProcedimento.modal,
    #modalRecuperacaoComponentes.modal {
      overflow-y: hidden;
    }

    #modalAddProcedimento .modal-dialog {
      height: calc(100vh - 1rem);
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
    }

    #modalAddProcedimento .modal-content {
      height: 100%;
    }

    #modalAddProcedimento .modal-body {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    #modalRecuperacaoComponentes .modal-dialog {
      height: calc(100vh - 1rem);
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
    }

    #modalRecuperacaoComponentes .modal-content {
      height: 100%;
    }

    #modalRecuperacaoComponentes .modal-body {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  </style>
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>

  <% if (alert) { %>
  <div class="container mt-3">
    <div class="alert alert-warning mb-0"><%= alert %></div>
  </div>
  <% } %>

  <div class="container maintenance-page">
    <a href="javascript:history.back()" class="btn btn-back">
      <i class="fas fa-arrow-left"></i>
    </a>

    <h1 class="mt-4 mb-4 text-center">Informações da Manutenção</h1>

    <div class="card p-3 mb-4 border-0">
      <div class="row g-3 justify-content-center text-start">
        <div class="maint-titlebar mb-3">
          <h2 class="pc-title mb-0">
            Manutenção #<%= manutencao.id %>
            <% if (manutencao?.computador?.status) { %>
            <span class="badge bg-danger ms-2">PC CONDENADO</span>
            <% } %>
          </h2>

          <% if (manutencao.dataSaida) { %>
          <span class="maint-finalizada">
            <i class="fas fa-check-circle"></i> Finalizada
          </span>
          <% } %>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Computador</div>
          <div class="meta-value text-center">
            <% if (manutencao?.computador) { %>
            <%= manutencao.computador.patrimonio %>
            <% } else { %>
            Não possui número de Patrimônio
            <% } %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Entrada</div>
          <div class="meta-value text-center">
            <span class="js-dt" data-iso="<%= manutencao.dataEntrada || '' %>">
              <%= manutencao.dataEntrada ? manutencao.dataEntrada : '-' %>
            </span>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Saída</div>
          <div class="meta-value text-center">
            <% if (manutencao.dataSaida) { %>
            <span class="js-dt" data-iso="<%= manutencao.dataSaida || '' %>">
              <%= manutencao.dataSaida %>
            </span>
            <% } else { %>
            Em andamento
            <% } %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Local</div>
          <div class="meta-value text-center">
            <%= manutencao?.computador?.setor ? manutencao.computador.setor : '-' %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Pertence à</div>
          <div class="meta-value text-center">
            <%= manutencao?.computador?.empresa?.nome ? manutencao.computador.empresa.nome : '-' %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="meta-label text-center">Descrição</div>
          <div class="meta-value text-center">
            <%= manutencao.descricao ? manutencao.descricao : '-' %>
          </div>
        </div>

        <div class="col-12">
          <div class="meta-label text-center">Configuração da máquina</div>
          <% if (structuredSpecsView && structuredSpecsView.sections && structuredSpecsView.sections.length) { %>
          <div class="specs-clean-shell mt-2 text-start">
            <div class="specs-clean-toolbar">
              <div>
                <div class="specs-clean-title">Componentes vinculados</div>
                <small class="text-muted">Separação automática dos materiais da máquina estruturada.</small>
              </div>
              <span class="specs-clean-badge">Estruturado</span>
            </div>

            <div class="specs-clean-grid mt-3">
              <% structuredSpecsView.sections.forEach((section) => { %>
              <div class="specs-clean-block">
                <div class="specs-clean-label"><%= section.title %></div>
                <ul class="specs-clean-items">
                  <% section.items.forEach((item) => { %>
                  <li class="specs-clean-item"><%= item %></li>
                  <% }) %>
                </ul>
              </div>
              <% }) %>
            </div>
          </div>
          <% } else { %>
          <div class="specs-legacy-box mt-2 text-start">
            <%= (manutencao?.computador?.specs_override ? manutencao.computador.specs_override : (manutencao?.computador?.specs || '-')) %>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="maintenance-nav">
      <a class="btn btn-outline-secondary btn-sm" href="/manutencoes">
        <i class="fas fa-arrow-left"></i> Voltar para Manutenções
      </a>

      <% if (manutencao?.computador?.id) { %>
      <a class="btn btn-primary btn-sm" href="/ver-pc?id=<%= manutencao.computador.id %>">
        <i class="fas fa-desktop"></i> Ver PC
      </a>
      <% } %>
    </div>

    <% if (!manutencao.dataSaida && (manutencao?.computador?.specs_modo || 'LEGADO') !== 'ESTRUTURADO') { %>
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 mb-3">
      <div>
        Esta manutenção está vinculada a uma máquina em modo legado. Antes de continuar, converta esta mesma máquina para estruturado.
      </div>
      <button type="button" class="btn btn-dark btn-sm" id="btnConverterEstruturadoFromManutencao">
        Converter agora
      </button>
    </div>
    <% } %>

    <h1 class="mt-4 mb-3">Histórico de Procedimentos</h1>

    <% if (!manutencao.dataSaida) { %>
    <div class="maintenance-actions mb-3 align-items-center justify-content-center">
      <form action="/encerrar-manutencao" method="post" class="d-inline-block m-0" onsubmit="return confirm('Tem certeza que deseja FECHAR esta manutenção?');">
        <input type="hidden" name="id" value="<%= manutencao.id %>">
        <button type="submit" class="btn btn-secondary btn-sm">
          <i class="fas fa-check"></i> Fechar manutenção
        </button>
      </form>

      <button
        type="button"
        class="btn btn-secondary btn-sm"
        id="btnOpenProcedimento"
        <% if ((manutencao.computador.specs_modo || 'LEGADO') === 'ESTRUTURADO') { %>
        data-bs-toggle="modal" data-bs-target="#modalAddProcedimento"
        <% } else { %>
        data-bs-toggle="modal" data-bs-target="#modalEscolhaEstruturado"
        <% } %>>
        <i class="fas fa-plus"></i> Adicionar procedimento
      </button>

      <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalCondenarMaquina">
        <i class="fas fa-ban"></i> Condenar máquina
      </button>
    </div>
    <% } %>

    <% const itensSafe = (typeof manutencoes !== 'undefined' && manutencoes) ? manutencoes : []; %>
    <% if (itensSafe.length) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Descrição</th>
            <th>Material</th>
            <th>Data</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>

        <tbody>
          <% itensSafe.forEach((item) => { %>
          <tr>
            <td>
              <span class="badge bg-secondary"><%= item.tipo || '-' %></span>
            </td>

            <td><%= item.descricao || '-' %></td>

            <td style="max-width: 340px;">
              <small class="text-muted"><%= item.material_snapshot || '-' %></small>
            </td>

            <td>
              <span class="js-dt" data-iso="<%= (item.dataEntrada || item.createdAt || '') %>">
                <%= item.dataEntrada || item.createdAt || '-' %>
              </span>
            </td>

            <td>
              <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalDetalhesProcedimento" data-tipo="<%= (item.tipo || '') %>" data-desc="<%= (item.descricao || '').replace(/\"/g, '&quot;') %>" data-snap="<%= (item.material_snapshot || '').replace(/\"/g, '&quot;') %>" data-antes="<%= (item.specs_antes || '').replace(/\"/g, '&quot;') %>" data-depois="<%= (item.specs_depois || '').replace(/\"/g, '&quot;') %>">
                Detalhes
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-muted" style="padding:10px 0;">
      Nenhum item adicional para esta manutenção.
    </div>
    <% } %>
  </div>

  <!-- Modal: Adicionar Procedimento -->
  <div class="modal fade" id="modalAddProcedimento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <form class="modal-content" id="formAddProcedimento">
        <div class="modal-header">
          <h5 class="modal-title">Adicionar procedimento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="manutencaoId" value="<%= manutencao.id %>">

          <% const specsFinal = (manutencao?.computador?.specs_override ? manutencao.computador.specs_override : (manutencao?.computador?.specs || '')); %>
          <input type="hidden" id="specsBase" value="<%- (specsFinal || '').replace(/\"/g, '&quot;') %>">
          <input type="hidden" id="specsModo" value="<%= manutencao?.computador?.specs_modo || 'LEGADO' %>">
          <div class="alert alert-warning mb-3" id="alertLegadoEstruturado" style="display:none;">
            Esta máquina ainda está em modo legado. Para trocar peça, converta primeiro para estruturado pelo fluxo de CSV ou cadastro manual.
          </div>

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Tipo de procedimento</label>
              <select class="form-select" name="tipo" id="tipoProcedimento" required>
                <option value="" selected disabled>Selecione...</option>
                <option value="TROCA_PECA">Troca de peça</option>
                <option value="LIMPEZA">Limpeza</option>
                <option value="MANUT_SIMPLES">Manutenção simples</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label">Descrição</label>
              <textarea class="form-control" name="descricao" rows="3" required placeholder="Ex: Troca de fonte, limpeza, reinstalação do Windows..."></textarea>
              <small class="text-muted d-block mt-2">
                Isso vai aparecer no "Histórico de Procedimentos".
              </small>
            </div>

            <div class="col-12" id="blocoTrocaPeca" style="display:none;">
              <div class="card p-3 border">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">Tipo de peça</label>
                    <select class="form-select" id="tipoPeca" name="tipoPeca">
                      <option value="" selected disabled>Selecione...</option>
                    </select>
                    <small class="text-muted">Carregado de Materiais</small>
                  </div>

                  <div class="col-md-5">
                    <label class="form-label">Material disponível</label>
                    <select class="form-select" name="materialId" id="materialId">
                      <option value="" selected disabled>Selecione o tipo primeiro...</option>
                    </select>
                    <small class="text-muted" id="infoDisponivel"></small>
                  </div>

                  <div class="col-md-3">
                    <label class="form-label">Quantidade</label>
                    <input class="form-control" type="number" name="quantidade" id="quantidade" min="1" value="1">
                  </div>

                  <div class="col-12">
                    <label class="form-label">Specs depois da troca</label>
                    <textarea class="form-control" name="specs_depois" id="specsDepois" rows="3"></textarea>
                    <small class="text-muted" id="specsDepoisHelp">
                      Começa com as specs atuais (override se existir). Você edita a string livre.
                    </small>

                    <hr class="my-3">

                    <h6 class="mb-2">Peça removida (obrigatório)</h6>

                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="form-label">Tipo removido</label>
                        <select class="form-select" id="tipoRemovido" disabled>
                          <option value="" selected disabled>Selecione o tipo da peça nova primeiro...</option>
                        </select>
                        <small class="text-muted">O tipo removido acompanha o tipo escolhido para a troca.</small>
                      </div>

                      <div class="col-md-5">
                        <label class="form-label">Material removido da máquina</label>
                        <select class="form-select" id="materialRemovidoId">
                          <option value="" selected disabled>Selecione o tipo removido primeiro...</option>
                        </select>
                        <small class="text-muted" id="infoRemovido">Somente componentes vinculados a esta máquina aparecem aqui.</small>
                      </div>

                      <div class="col-md-3">
                        <label class="form-label">Qtd removida</label>
                        <input class="form-control" type="number" id="qtdRemovida" min="1" value="1">
                      </div>

                      <div class="col-md-5">
                        <label class="form-label">Destino</label>
                        <select class="form-select" id="destinoRemovida">
                          <option value="RECUPERAR">Recuperar</option>
                          <option value="DEFEITO">Defeito (baixar)</option>
                        </select>
                      </div>

                      <div class="col-md-7">
                        <label class="form-label">Motivo (obrigatório se Defeito)</label>
                        <input class="form-control" id="motivoRemovida" placeholder="Ex: queimada, instável, sem vídeo...">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btnSalvarProcedimento">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Condenar Máquina -->
  <div class="modal fade" id="modalCondenarMaquina" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formCondenarMaquina">
        <div class="modal-header">
          <h5 class="modal-title">Condenar máquina</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="manutencaoId" value="<%= manutencao.id %>">

          <div class="alert alert-warning mb-3">
            <b>Atenção:</b> condenar é irreversível. O PC será marcado como condenado e a manutenção será encerrada.
          </div>

          <label class="form-label">Motivo</label>
          <textarea class="form-control" name="motivo" rows="3" required placeholder="Ex: Placa-mãe queimada, custo inviável, sem peças..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-danger">Próximo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Recuperação de Componentes -->
  <div class="modal fade" id="modalRecuperacaoComponentes" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <form class="modal-content" id="formRecuperacaoComponentes">
        <div class="modal-header">
          <h5 class="modal-title">Recuperação de Componentes</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="recManutencaoId" value="<%= manutencao.id %>">
          <input type="hidden" id="recMotivoCondenacao" value="">

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <div class="meta-label text-center">Patrimônio</div>
              <div class="meta-value text-center">
                <%= manutencao.computador.patrimonio || '-' %>
              </div>
            </div>

            <div class="col-md-4">
              <div class="meta-label text-center">Local</div>
              <div class="meta-value text-center">
                <%= manutencao.computador.setor || '-' %>
              </div>
            </div>

            <div class="col-md-4">
              <div class="meta-label text-center">Empresa</div>
              <div class="meta-value text-center">
                <%= manutencao.computador.empresa.nome || '-' %>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Componentes da maquina para recuperar ou condenar</h6>
            <button type="button" class="btn btn-sm btn-secondary" id="btnAdicionarLinhaRecuperacao">
              <i class="fas fa-plus"></i> Adicionar componente
            </button>
          </div>

          <div class="alert alert-light border mb-3">
            Somente componentes realmente vinculados a esta maquina aparecem nas listas abaixo.
          </div>

          <div class="table-responsive">
            <table class="table table-bordered align-middle">
              <thead>
                <tr>
                  <th>Tipo</th>
                  <th>Componente da maquina</th>
                  <th>Qtd</th>
                  <th>Destino</th>
                  <th>Motivo</th>
                  <th class="text-center">Ações</th>
                </tr>
              </thead>
              <tbody id="tbodyRecuperacao">
                <tr id="linhaVaziaRecuperacao">
                  <td colspan="6" class="text-muted text-center">
                    Nenhum componente adicionado ainda.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="alert alert-info mt-3 mb-0">
            <b>Recuperar</b> devolve a peça para o estoque disponível. <br>
            <b>Defeito</b> envia a peça para a quantidade baixada.
          </div>
          <div class="alert alert-warning mt-3 mb-0">
            Se voce nao adicionar nenhum componente:
            <br>
            - em maquina estruturada, todos os componentes vinculados serao marcados como defeito pelo motivo da condenacao
            <br>
            - em maquina legado, nenhum material sera movimentado
            <br><br>
            Se voce recuperar apenas alguns componentes em uma maquina estruturada:
            <br>
            - todo o restante da maquina sera marcado automaticamente como defeito pelo motivo da condenacao
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar condenação e recuperação</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Detalhes do Procedimento -->
  <div class="modal fade" id="modalDetalhesProcedimento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Detalhes do procedimento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-2"><strong>Tipo:</strong> <span id="detTipo"></span></div>
          <div class="mb-2"><strong>Descrição:</strong> <span id="detDesc"></span></div>

          <div class="mb-3">
            <label class="form-label"><strong>Resumo da troca</strong></label>
            <div class="specs-detail-panel specs-detail-panel-compact" id="detSnap"></div>
          </div>

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Specs antes</label>
              <div class="specs-detail-panel" id="detAntes"></div>
            </div>
            <div class="col-12">
              <label class="form-label">Specs depois</label>
              <div class="specs-detail-panel" id="detDepois"></div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalEscolhaEstruturado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Converter máquina legado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">
            Esta máquina ainda está em modo legado.
          </p>
          <p class="text-muted mb-0">
            Antes de usar troca de peça, escolha como deseja converter para o modo estruturado.
          </p>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary" id="btnAbrirEstruturadoManual">
            Cadastro manual
          </button>
          <button type="button" class="btn btn-primary" id="btnAbrirEstruturadoCsv">
            Enviar CSV
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalEstruturadoCsvExistente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" id="formEstruturadoCsvExistente" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">Converter por CSV</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-light border text-start">
            O patrimônio, setor e empresa atuais serão mantidos. O CSV será usado para montar os componentes reais da máquina. Se o arquivo vier como patrimonio-setor-fonte.csv, a fonte também será identificada pelo nome.
          </div>

          <label for="csvLegadoExistente" class="form-label">Arquivo CSV do HWiNFO</label>
          <input type="file" class="form-control" id="csvLegadoExistente" name="csvFile" accept=".csv" required>
          <div class="mt-3">
            <label for="fonteLegadoExistente" class="form-label">Indique a fonte da maquina</label>
            <input type="text" class="form-control" id="fonteLegadoExistente" name="fonte" placeholder="Ex: ATX 500W, Micro ATX 300W ou Dell proprietaria">
            <small class="text-muted">Opcional. Se a fonte vier no nome do arquivo, este campo pode ficar em branco.</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Importar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal fade" id="modalEstruturadoManualExistente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <form class="modal-content" id="formEstruturadoManualExistente">
        <div class="modal-header">
          <h5 class="modal-title">Converter manualmente para estruturado</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="manualModeloComputadorExistente" class="form-label">Modelo</label>
              <input type="text" class="form-control" id="manualModeloComputadorExistente" name="modeloComputador" placeholder="Ex: DELL OptiPlex 7050" required>
            </div>
            <div class="col-12">
              <label for="manualProcessadorExistente" class="form-label">Processador</label>
              <input type="text" class="form-control" id="manualProcessadorExistente" name="processador" placeholder="Ex: Intel Core i5-6500" required>
            </div>
            <div class="col-md-6">
              <label for="manualMemoriaExistente" class="form-label">Memória</label>
              <textarea class="form-control" id="manualMemoriaExistente" name="memoria" rows="3" placeholder="Um item por linha&#10;Ex: 8 GB DDR4 2133 MT/s" required></textarea>
              <small class="text-muted">Use uma linha por módulo, se houver mais de um.</small>
            </div>
            <div class="col-md-6">
              <label for="manualArmazenamentoExistente" class="form-label">Armazenamento</label>
              <textarea class="form-control" id="manualArmazenamentoExistente" name="armazenamento" rows="3" placeholder="Um item por linha&#10;Ex: NVME SSD 256GB - 256 GB" required></textarea>
              <small class="text-muted">Use uma linha por unidade de armazenamento.</small>
            </div>
            <div class="col-12">
              <label for="manualFonteExistente" class="form-label">Indique a fonte da maquina</label>
              <input type="text" class="form-control" id="manualFonteExistente" name="fonte" placeholder="Ex: ATX 500W, Micro ATX 300W ou Dell proprietaria">
              <small class="text-muted">Opcional. O tipo sera salvo como Fonte e o detalhe informado ficara na especificacao.</small>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Converter</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    async function fetchJson(url, opts) {
      const res = await fetch(url, opts);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || 'Erro na requisição');
      return data;
    }

    function formatDateTimeBR(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return value;
      return d.toLocaleString('pt-BR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    document.addEventListener('DOMContentLoaded', async () => {
      document.querySelectorAll('.js-dt').forEach((el) => {
        const iso = (el.getAttribute('data-iso') || '').trim();
        if (!iso) return;
        el.textContent = formatDateTimeBR(iso);
      });

      const form = document.getElementById('formAddProcedimento');
      const tipoProcedimento = document.getElementById('tipoProcedimento');
      const blocoTrocaPeca = document.getElementById('blocoTrocaPeca');

      const tipoPeca = document.getElementById('tipoPeca');
      const materialId = document.getElementById('materialId');
      const quantidade = document.getElementById('quantidade');
      const specsDepois = document.getElementById('specsDepois');
      const specsBase = document.getElementById('specsBase');
      const specsModo = document.getElementById('specsModo');
      const specsDepoisHelp = document.getElementById('specsDepoisHelp');
      const alertLegadoEstruturado = document.getElementById('alertLegadoEstruturado');
      const infoDisponivel = document.getElementById('infoDisponivel');
      const btnSalvar = document.getElementById('btnSalvarProcedimento');
      const btnOpenProcedimento = document.getElementById('btnOpenProcedimento');
      const btnConverterEstruturadoFromManutencao = document.getElementById('btnConverterEstruturadoFromManutencao');
      const modalAddProcedimentoEl = document.getElementById('modalAddProcedimento');
      const modalEscolhaEstruturadoEl = document.getElementById('modalEscolhaEstruturado');
      const modalEstruturadoCsvExistenteEl = document.getElementById('modalEstruturadoCsvExistente');
      const modalEstruturadoManualExistenteEl = document.getElementById('modalEstruturadoManualExistente');
      const btnAbrirEstruturadoManual = document.getElementById('btnAbrirEstruturadoManual');
      const btnAbrirEstruturadoCsv = document.getElementById('btnAbrirEstruturadoCsv');
      const formEstruturadoCsvExistente = document.getElementById('formEstruturadoCsvExistente');
      const formEstruturadoManualExistente = document.getElementById('formEstruturadoManualExistente');

      const tipoRemovido = document.getElementById('tipoRemovido');
      const materialRemovidoId = document.getElementById('materialRemovidoId');
      const qtdRemovida = document.getElementById('qtdRemovida');
      const destinoRemovida = document.getElementById('destinoRemovida');
      const motivoRemovida = document.getElementById('motivoRemovida');
      const infoRemovido = document.getElementById('infoRemovido');
      const computadorIdAtual = Number('<%= manutencao.computador.id %>');

      const formCondenarMaquina = document.getElementById('formCondenarMaquina');
      const modalCondenarMaquinaEl = document.getElementById('modalCondenarMaquina');
      const modalRecuperacaoComponentesEl = document.getElementById('modalRecuperacaoComponentes');
      const recManutencaoId = document.getElementById('recManutencaoId');
      const recMotivoCondenacao = document.getElementById('recMotivoCondenacao');

      const btnAdicionarLinhaRecuperacao = document.getElementById('btnAdicionarLinhaRecuperacao');
      const tbodyRecuperacao = document.getElementById('tbodyRecuperacao');
      const formRecuperacaoComponentes = document.getElementById('formRecuperacaoComponentes');

      let isSubmittingProcedimento = false;
      let modalLegadoJaExibido = false;

      let componentesEstruturadosCache = [];

      function isEstruturado() {
        return (specsModo.value || 'LEGADO').toUpperCase() === 'ESTRUTURADO';
      }

      function getModalInstance(modalEl) {
        if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return null;

        if (typeof bootstrap.Modal.getOrCreateInstance === 'function') {
          return bootstrap.Modal.getOrCreateInstance(modalEl);
        }

        return bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      }

      function switchModal(fromEl, toEl) {
        if (!fromEl || !toEl) return;

        const fromInst = getModalInstance(fromEl);
        const toInst = getModalInstance(toEl);
        if (!fromInst || !toInst) return;

        fromEl.addEventListener('hidden.bs.modal', function() {
          toInst.show();
        }, { once: true });

        fromInst.hide();
      }

      function abrirFluxoEstruturado(force = false) {
        if (isEstruturado() || !modalEscolhaEstruturadoEl) return;
        if (!force && modalLegadoJaExibido) return;

        modalLegadoJaExibido = true;
        const modal = getModalInstance(modalEscolhaEstruturadoEl);
        if (modal) modal.show();
      }

      function setTrocaPecaEnabled(enabled) {
        blocoTrocaPeca.style.display = enabled ? 'block' : 'none';
        const estruturado = (specsModo.value || 'LEGADO').toUpperCase() === 'ESTRUTURADO';
        const legado = !estruturado;

        tipoPeca.disabled = !enabled;
        materialId.disabled = !enabled;
        quantidade.disabled = !enabled;
        specsDepois.disabled = !enabled;
        specsDepois.readOnly = enabled && estruturado;

        tipoRemovido.disabled = true;
        materialRemovidoId.disabled = !enabled;
        qtdRemovida.disabled = !enabled;
        destinoRemovida.disabled = !enabled;
        motivoRemovida.disabled = !enabled;

        tipoPeca.required = enabled;
        materialId.required = enabled;
        quantidade.required = enabled;

        tipoRemovido.required = enabled;
        materialRemovidoId.required = enabled;
        qtdRemovida.required = enabled;
        destinoRemovida.required = enabled;

        if (specsDepoisHelp) {
          specsDepoisHelp.textContent = estruturado
            ? 'Este computador esta em modo estruturado. As specs serao recalculadas automaticamente pelos componentes vinculados.'
            : 'Comeca com as specs atuais (override se existir). Voce edita a string livre.';
        }

        if (alertLegadoEstruturado) {
          alertLegadoEstruturado.style.display = enabled && legado ? 'block' : 'none';
        }
      }

      setTrocaPecaEnabled(false);

      if (modalAddProcedimentoEl) {
        modalAddProcedimentoEl.addEventListener('show.bs.modal', (ev) => {
          if (isEstruturado()) return;
          ev.preventDefault();
          abrirFluxoEstruturado(true);
        });
      }

      if (specsDepois && specsBase) {
        specsDepois.value = specsBase.value || '';
      }

      if (btnAbrirEstruturadoCsv) {
        btnAbrirEstruturadoCsv.addEventListener('click', () => {
          switchModal(modalEscolhaEstruturadoEl, modalEstruturadoCsvExistenteEl);
        });
      }

      if (btnConverterEstruturadoFromManutencao) {
        btnConverterEstruturadoFromManutencao.addEventListener('click', (ev) => {
          ev.preventDefault();
          abrirFluxoEstruturado(true);
        });
      }

      if (btnAbrirEstruturadoManual) {
        btnAbrirEstruturadoManual.addEventListener('click', () => {
          switchModal(modalEscolhaEstruturadoEl, modalEstruturadoManualExistenteEl);
        });
      }

      if (formEstruturadoCsvExistente) {
        formEstruturadoCsvExistente.addEventListener('submit', async (e) => {
          e.preventDefault();

          try {
            const body = new FormData(formEstruturadoCsvExistente);
            const res = await fetch(`/computadores/<%= manutencao.computador.id %>/importar-hwinfo-csv`, {
              method: 'POST',
              body,
            });

            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Erro ao importar CSV.');

            window.location.reload();
          } catch (err) {
            alert(err.message || 'Erro ao importar CSV.');
          }
        });
      }

      if (formEstruturadoManualExistente) {
        formEstruturadoManualExistente.addEventListener('submit', async (e) => {
          e.preventDefault();

          try {
            const payload = Object.fromEntries(new FormData(formEstruturadoManualExistente).entries());
            await fetchJson(`/computadores/<%= manutencao.computador.id %>/estruturado-manual`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload),
            });

            window.location.reload();
          } catch (err) {
            alert(err.message || 'Erro ao converter manualmente.');
          }
        });
      }

      async function carregarTipos() {
        if (!componentesEstruturadosCache.length) {
          await carregarComponentesEstruturados();
        }

        const tipos = [...new Set(componentesEstruturadosCache.map((item) => item.tipo).filter(Boolean))];

        tipoPeca.innerHTML = '<option value="" selected disabled>Selecione...</option>';
        tipoRemovido.innerHTML = '<option value="" selected disabled>Selecione o tipo da peça nova primeiro...</option>';

        if (!tipos.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Esta máquina não possui componentes trocáveis';
          opt.disabled = true;
          tipoPeca.appendChild(opt);
          return;
        }

        tipos.forEach((t) => {
          const opt1 = document.createElement('option');
          opt1.value = t;
          opt1.textContent = t;
          tipoPeca.appendChild(opt1);
        });
      }

      async function carregarComponentesEstruturados() {
        componentesEstruturadosCache = await fetchJson(`/computadores/${computadorIdAtual}/componentes-estruturados`);
        return componentesEstruturadosCache;
      }

      function renderLinhaVaziaRecuperacao(message = 'Nenhum componente adicionado ainda.') {
        tbodyRecuperacao.innerHTML = `
          <tr id="linhaVaziaRecuperacao">
            <td colspan="6" class="text-muted text-center">
              ${message}
            </td>
          </tr>
        `;
      }

      function definirTipoRemovido(tipo) {
        tipoRemovido.innerHTML = '';

        if (!tipo) {
          tipoRemovido.innerHTML = '<option value="" selected disabled>Selecione o tipo da peça nova primeiro...</option>';
          return;
        }

        const opt = document.createElement('option');
        opt.value = tipo;
        opt.textContent = tipo;
        opt.selected = true;
        tipoRemovido.appendChild(opt);
      }

      async function carregarMateriaisPorTipo(tipo) {
        materialId.innerHTML = '<option value="" selected disabled>Carregando...</option>';
        infoDisponivel.textContent = '';

        const list = await fetchJson(`/materiais?tipo=${encodeURIComponent(tipo)}&somenteDisponivel=1`);
        materialId.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Nenhum material disponível';
          opt.disabled = true;
          materialId.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'})${m.especificacao ? ` - ${m.especificacao}` : ''} - Disp: ${m.quantidade_disponivel}`;
          opt.dataset.disponivel = m.quantidade_disponivel;
          materialId.appendChild(opt);
        });
      }

      async function carregarMateriaisRemovidosPorTipo(tipo) {
        materialRemovidoId.innerHTML = '<option value="" selected disabled>Carregando...</option>';
        infoRemovido.textContent = 'Somente componentes vinculados a esta máquina aparecem aqui.';

        if (!componentesEstruturadosCache.length) {
          await carregarComponentesEstruturados();
        }

        const list = componentesEstruturadosCache.filter((item) => item.tipo === tipo);
        materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Esta máquina não possui componente desse tipo';
          opt.disabled = true;
          materialRemovidoId.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'}) - Na máquina: ${m.quantidade_no_computador ?? 0}`;
          opt.dataset.disponivel = m.quantidade_disponivel ?? 0;
          opt.dataset.uso = m.quantidade_em_uso ?? 0;
          opt.dataset.qtdNoComputador = m.quantidade_no_computador ?? 0;
          materialRemovidoId.appendChild(opt);
        });
      }

      tipoProcedimento.addEventListener('change', async () => {
        const v = tipoProcedimento.value;
        const estruturado = isEstruturado();

        if (v === 'TROCA_PECA') {
          if (!estruturado) {
            setTrocaPecaEnabled(false);
            tipoProcedimento.value = '';
            abrirFluxoEstruturado(true);
            return;
          }

          setTrocaPecaEnabled(true);
          await carregarTipos();
          await carregarComponentesEstruturados();

          tipoPeca.value = '';
          materialId.innerHTML = '<option value="" selected disabled>Selecione o tipo primeiro...</option>';
          quantidade.value = 1;
          infoDisponivel.textContent = '';

          definirTipoRemovido('');
          materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione o tipo removido primeiro...</option>';
          qtdRemovida.value = 1;
          destinoRemovida.value = 'RECUPERAR';
          motivoRemovida.value = '';
          infoRemovido.textContent = '';

          specsDepois.value = specsBase.value || '';
        } else {
          setTrocaPecaEnabled(false);

          tipoPeca.value = '';
          materialId.value = '';
          quantidade.value = 1;
          specsDepois.value = '';
          infoDisponivel.textContent = '';

          definirTipoRemovido('');
          materialRemovidoId.innerHTML = '<option value="" selected disabled>Selecione o tipo removido primeiro...</option>';
          qtdRemovida.value = 1;
          destinoRemovida.value = 'RECUPERAR';
          motivoRemovida.value = '';
          infoRemovido.textContent = '';
        }
      });

      tipoPeca.addEventListener('change', async () => {
        const tipo = tipoPeca.value;
        if (!tipo) return;

        await carregarMateriaisPorTipo(tipo);

        definirTipoRemovido(tipo);
        await carregarMateriaisRemovidosPorTipo(tipo);
      });

      materialId.addEventListener('change', () => {
        const opt = materialId.options[materialId.selectedIndex];
        const disp = Number(opt.dataset.disponivel || 0);
        infoDisponivel.textContent = disp ? `Disponível: ${disp}` : '';

        if (disp > 0) {
          quantidade.max = disp;
          if (Number(quantidade.value) > disp) quantidade.value = disp;
        }
      });

      materialRemovidoId.addEventListener('change', () => {
        const opt = materialRemovidoId.options[materialRemovidoId.selectedIndex];
        const disp = Number(opt.dataset.disponivel || 0);
        const uso = Number(opt.dataset.uso || 0);
        const qtdNoComputador = Number(opt.dataset.qtdNoComputador || 0);
        infoRemovido.textContent = `Na máquina: ${qtdNoComputador} | Em uso sist.: ${uso} | Disponível sist.: ${disp}`;

        if (qtdNoComputador > 0) {
          qtdRemovida.max = qtdNoComputador;
          if (Number(qtdRemovida.value) > qtdNoComputador) qtdRemovida.value = qtdNoComputador;
        } else {
          qtdRemovida.removeAttribute('max');
        }
      });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (isSubmittingProcedimento) return;
        isSubmittingProcedimento = true;
        btnSalvar.disabled = true;

        try {
          const fd = new FormData(form);
          const payload = Object.fromEntries(fd.entries());

          if (payload.tipo === 'TROCA_PECA') {
            if ((specsModo.value || 'LEGADO').toUpperCase() !== 'ESTRUTURADO') {
              throw new Error('Esta máquina ainda está em modo legado. Converta para estruturado antes de usar troca de peça.');
            }

            if (!payload.materialId) throw new Error('Selecione um material.');

            const qtd = Number(payload.quantidade || 1);
            if (!qtd || qtd <= 0) throw new Error('Quantidade inválida.');
            payload.quantidade = qtd;
            payload.specs_depois = payload.specs_depois || '';

            if (!tipoRemovido.value) throw new Error('Selecione o tipo removido.');
            if (!materialRemovidoId.value) throw new Error('Selecione o material removido.');

            const remQtd = Number(qtdRemovida.value || 1);
            if (!remQtd || remQtd <= 0) throw new Error('Qtd removida inválida.');

            const optRemovido = materialRemovidoId.options[materialRemovidoId.selectedIndex];
            const qtdNoComputador = Number(optRemovido.dataset.qtdNoComputador || 0);
            if (qtdNoComputador <= 0) {
              throw new Error('Selecione um componente realmente vinculado a esta máquina.');
            }
            if (remQtd > qtdNoComputador) {
              throw new Error(`Qtd removida maior que a quantidade vinculada à máquina. Vinculado: ${qtdNoComputador}.`);
            }

            const dest = destinoRemovida.value;
            if (dest === 'DEFEITO' && (!motivoRemovida.value || !motivoRemovida.value.trim())) {
              throw new Error('Motivo é obrigatório quando destino = Defeito.');
            }

            payload.materialRemovidoId = Number(materialRemovidoId.value);
            payload.qtdRemovida = remQtd;
            payload.destinoRemovida = dest;
            payload.motivoRemovida = dest === 'DEFEITO' ? motivoRemovida.value.trim() : '';
          } else {
            delete payload.materialId;
            delete payload.quantidade;
            delete payload.specs_depois;
          }

          await fetchJson('/add-item-manutencao', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          window.location.reload();
        } catch (err) {
          alert(err.message || 'Erro ao salvar procedimento.');
        } finally {
          btnSalvar.disabled = false;
          isSubmittingProcedimento = false;
        }
      });

      formCondenarMaquina.addEventListener('submit', async (e) => {
        e.preventDefault();

        const motivoField = formCondenarMaquina.querySelector('textarea[name="motivo"]');
        const motivo = (motivoField.value || '').trim();

        if (!motivo) {
          alert('Informe o motivo da condenação.');
          return;
        }

        if (recManutencaoId) {
          recManutencaoId.value = '<%= manutencao.id %>';
        }
        recMotivoCondenacao.value = motivo;

        const modalCondenar = bootstrap.Modal.getInstance(modalCondenarMaquinaEl);
        if (modalCondenar) modalCondenar.hide();

        const modalRec = new bootstrap.Modal(modalRecuperacaoComponentesEl);
        modalRec.show();
      });

      modalRecuperacaoComponentesEl.addEventListener('show.bs.modal', async () => {
        renderLinhaVaziaRecuperacao();
        btnAdicionarLinhaRecuperacao.disabled = true;

        if (!isEstruturado()) {
          componentesEstruturadosCache = [];
          renderLinhaVaziaRecuperacao('Maquina legado: nenhum componente sera movimentado. Se salvar sem adicionar linhas, apenas a condenacao da maquina sera registrada.');
          return;
        }

        try {
          await carregarComponentesEstruturados();

          if (!componentesEstruturadosCache.length) {
            renderLinhaVaziaRecuperacao('Esta maquina nao possui componentes estruturados vinculados para recuperacao.');
            return;
          }

          btnAdicionarLinhaRecuperacao.disabled = false;
        } catch (err) {
          renderLinhaVaziaRecuperacao('Nao foi possivel carregar os componentes estruturados desta maquina.');
          alert(err.message || 'Erro ao carregar componentes da maquina.');
        }
      });

      async function carregarTiposRecuperacao(selectTipo) {
        if (!componentesEstruturadosCache.length) {
          await carregarComponentesEstruturados();
        }

        const tipos = [...new Set(componentesEstruturadosCache.map((item) => item.tipo).filter(Boolean))];

        selectTipo.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!tipos.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Nenhum tipo disponivel nesta maquina';
          opt.disabled = true;
          selectTipo.appendChild(opt);
          return false;
        }

        tipos.forEach((t) => {
          const opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          selectTipo.appendChild(opt);
        });

        return true;
      }

      async function carregarMateriaisRecuperacaoPorTipo(tipo, selectMaterial, qtdInput = null) {
        selectMaterial.innerHTML = '<option value="" selected disabled>Carregando...</option>';

        if (!componentesEstruturadosCache.length) {
          await carregarComponentesEstruturados();
        }

        const list = componentesEstruturadosCache.filter((item) => item.tipo === tipo);
        selectMaterial.innerHTML = '<option value="" selected disabled>Selecione...</option>';

        if (!list.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Esta maquina nao possui componente desse tipo';
          opt.disabled = true;
          selectMaterial.appendChild(opt);
          return;
        }

        list.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = `${m.material} (${m.marca || '-'}) - Na maquina: ${m.quantidade_no_computador ?? 0}`;
          opt.dataset.qtdNoComputador = m.quantidade_no_computador ?? 0;
          selectMaterial.appendChild(opt);
        });

        if (qtdInput) {
          qtdInput.value = 1;
          qtdInput.removeAttribute('max');
        }
      }

      async function adicionarLinhaRecuperacao() {
        const linhaVazia = document.getElementById('linhaVaziaRecuperacao');
        if (linhaVazia) linhaVazia.remove();

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <select class="form-select rec-tipo">
              <option value="" selected disabled>Selecione...</option>
            </select>
          </td>
          <td>
            <select class="form-select rec-material">
              <option value="" selected disabled>Selecione o tipo primeiro...</option>
            </select>
          </td>
          <td style="width:110px;">
            <input type="number" class="form-control rec-qtd" min="1" value="1">
          </td>
          <td style="width:180px;">
            <select class="form-select rec-destino">
              <option value="RECUPERAR">Recuperar</option>
              <option value="DEFEITO">Defeito</option>
            </select>
          </td>
          <td>
            <input type="text" class="form-control rec-motivo" placeholder="Obrigatório se defeito">
          </td>
          <td style="width:100px;" class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger rec-remover">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;

        tbodyRecuperacao.appendChild(tr);

        const selectTipo = tr.querySelector('.rec-tipo');
        const selectMaterial = tr.querySelector('.rec-material');
        const selectDestino = tr.querySelector('.rec-destino');
        const inputMotivo = tr.querySelector('.rec-motivo');
        const inputQtd = tr.querySelector('.rec-qtd');
        const btnRemover = tr.querySelector('.rec-remover');

        const possuiTipos = await carregarTiposRecuperacao(selectTipo);
        if (!possuiTipos) {
          selectMaterial.disabled = true;
          inputQtd.disabled = true;
          selectDestino.disabled = true;
          inputMotivo.disabled = true;
        }

        selectTipo.addEventListener('change', async () => {
          const tipo = selectTipo.value;
          if (!tipo) return;
          await carregarMateriaisRecuperacaoPorTipo(tipo, selectMaterial, inputQtd);
        });
        selectMaterial.addEventListener('change', () => {
          const opt = selectMaterial.options[selectMaterial.selectedIndex];
          const qtdNoComputador = Number(opt.dataset.qtdNoComputador || 0);
          if (qtdNoComputador > 0) {
            inputQtd.max = qtdNoComputador;
            if (Number(inputQtd.value) > qtdNoComputador) inputQtd.value = qtdNoComputador;
          } else {
            inputQtd.removeAttribute('max');
          }
        });

        selectDestino.addEventListener('change', () => {
          if (selectDestino.value === 'DEFEITO') {
            inputMotivo.placeholder = 'Motivo obrigatório';
          } else {
            inputMotivo.placeholder = 'Opcional';
            inputMotivo.value = '';
          }
        });
        btnRemover.addEventListener('click', () => {
          tr.remove();

          if (!tbodyRecuperacao.querySelector('tr')) {
            renderLinhaVaziaRecuperacao();
          }
        });
      }

      btnAdicionarLinhaRecuperacao.addEventListener('click', async () => {
        if (!isEstruturado()) {
          alert('Esta maquina esta em modo legado. Nenhum componente pode ser recuperado por este fluxo.');
          return;
        }

        if (!componentesEstruturadosCache.length) {
          await carregarComponentesEstruturados();
        }

        if (!componentesEstruturadosCache.length) {
          alert('Esta maquina nao possui componentes estruturados disponiveis para recuperacao.');
          return;
        }

        await adicionarLinhaRecuperacao();
      });

      formRecuperacaoComponentes.addEventListener('submit', async (e) => {
        e.preventDefault();

        const linhas = [...tbodyRecuperacao.querySelectorAll('tr')].filter(tr => !tr.id);

        const componentes = [];

        for (const tr of linhas) {
          const tipo = tr.querySelector('.rec-tipo').value || '';
          const matId = tr.querySelector('.rec-material').value || '';
          const qtdInput = tr.querySelector('.rec-qtd');
          const qtd = Number(qtdInput.value || 0);
          const destino = tr.querySelector('.rec-destino').value || '';
          const motivo = (tr.querySelector('.rec-motivo').value || '').trim();
          const optMat = tr.querySelector('.rec-material').options[tr.querySelector('.rec-material').selectedIndex];
          const qtdNoComputador = Number(optMat.dataset.qtdNoComputador || 0);

          if (!tipo) {
            alert('Selecione o tipo do componente.');
            return;
          }

          if (!matId) {
            alert('Selecione o material do componente.');
            return;
          }

          if (!qtd || qtd <= 0) {
            alert('Informe uma quantidade válida.');
            return;
          }

          if (!destino) {
            alert('Selecione o destino do componente.');
            return;
          }

          if (!qtdNoComputador || qtdNoComputador <= 0) {
            alert('Selecione um componente realmente presente na máquina.');
            return;
          }

          if (qtd > qtdNoComputador) {
            alert(`Quantidade maior que a vinculada na máquina. Vinculado: ${qtdNoComputador}.`);
            return;
          }

          if (destino === 'DEFEITO' && !motivo) {
            alert('Informe o motivo para os itens marcados como defeito.');
            return;
          }

          componentes.push({
            tipo,
            materialId: Number(matId),
            quantidade: qtd,
            destino,
            motivo,
          });
        }

        const totaisPorMaterial = componentes.reduce((acc, item) => {
          const key = Number(item.materialId);
          acc[key] = (acc[key] || 0) + Number(item.quantidade || 0);
          return acc;
        }, {});
        for (const [materialId, totalSelecionado] of Object.entries(totaisPorMaterial)) {
          const componenteBase = componentesEstruturadosCache.find((item) => Number(item.id) === Number(materialId));
          const qtdNoComputador = Number(componenteBase.quantidade_no_computador || 0);
          if (totalSelecionado > qtdNoComputador) {
            alert(`A soma das quantidades para o componente ${componenteBase?.material || materialId} excede o que existe na máquina.`);
            return;
          }
        }
        const payload = {
          manutencaoId: Number(recManutencaoId?.value || '<%= manutencao.id %>'),
          motivoCondenacao: (recMotivoCondenacao?.value || '').trim(),
          componentes,
        };

        if (!payload.manutencaoId) {
          alert('Não foi possível identificar a manutenção atual.');
          return;
        }

        try {
          await fetchJson('/condenar-maquina-com-recuperacao', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          window.location.href = `/ver-manutencao?id=${payload.manutencaoId}`;
        } catch (err) {
          alert(err.message || 'Erro ao salvar condenação com recuperação.');
        }
      });
    });
  </script>

  <script>
    const modalDet = document.getElementById('modalDetalhesProcedimento');

    if (modalDet) {
      modalDet.addEventListener('show.bs.modal', function(event) {
        const btn = event.relatedTarget;
        if (!btn) return;

        document.getElementById('detTipo').textContent = btn.getAttribute('data-tipo') || '-';
        document.getElementById('detDesc').textContent = btn.getAttribute('data-desc') || '-';
        document.getElementById('detSnap').textContent =
          (btn.getAttribute('data-snap') || '-').replaceAll(' || ', '\n\n');
        document.getElementById('detAntes').textContent = btn.getAttribute('data-antes') || '-';
        document.getElementById('detDepois').textContent = btn.getAttribute('data-depois') || '-';
      });
    }
  </script>
</body>

</html>

