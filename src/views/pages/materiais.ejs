<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Materiais do Departamento de T.I</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>
  <main>
    <div class="container mt-4">
      <a href="javascript:history.back()" class="btn btn-back">
        <i class="fas fa-arrow-left"></i>
      </a>

      <div class="text-center align-items-center">
        <h1 class="mt-4 mb-4">Materiais do Departamento de T.I</h1>
      </div>

      <div class="card p-3 mb-3">
        <div class="row g-3 align-items-end">
          <div class="col-lg-6">
            <label for="q" class="form-label">Buscar</label>
            <input class="form-control" id="q" placeholder="Buscar por material, tipo, marca, especificação ou NF">
          </div>

          <div class="col-md-6 col-lg-3">
            <label for="filtroTipo" class="form-label">Tipo</label>
            <select class="form-select" id="filtroTipo">
              <option value="">Todos os tipos</option>
            </select>
          </div>

          <div class="col-md-6 col-lg-3">
            <label for="pageSizeSelect" class="form-label">Máximo por página</label>
            <select class="form-select" id="pageSizeSelect">
              <option value="10">10 por página</option>
              <option value="20" selected>20 por página</option>
              <option value="50">50 por página</option>
              <option value="100">100 por página</option>
            </select>
          </div>
        </div>

        <div class="row g-3 align-items-center mt-1">
          <div class="col-md-6">
            <div class="form-check pt-md-4">
              <input class="form-check-input" type="checkbox" id="somenteDisponivel">
              <label class="form-check-label" for="somenteDisponivel">Somente disponíveis</label>
            </div>
          </div>

          <div class="col-md-6 d-flex justify-content-md-end">
            <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#modalAddMaterial">
              Adicionar material
            </button>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th scope="col" style="cursor:pointer" onclick="ordenarPor('material')" data-sort-col="material">Material <span class="sort-indicator"></span></th>
                <th scope="col" style="cursor:pointer" onclick="ordenarPor('tipo')" data-sort-col="tipo">Tipo <span class="sort-indicator"></span></th>
                <th>Especificação</th>
                <th>Disponível</th>
                <th scope="col" style="cursor:pointer" onclick="ordenarPor('quantidade_em_uso')" data-sort-col="quantidade_em_uso">Em uso <span class="sort-indicator"></span></th>
                <th scope="col" style="cursor:pointer" onclick="ordenarPor('nf')" data-sort-col="nf">NF <span class="sort-indicator"></span></th>
                <th style="width: 170px;" class="text-center">Ações</th>
              </tr>
            </thead>
            <tbody id="tbodyMateriais">
              <tr>
                <td colspan="7" class="text-muted p-3">Carregando...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <small class="text-muted" id="totalMateriais">Materiais exibidos: 0 / Total: 0</small>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <small class="text-muted" id="pageInfo">Página 1 de 1</small>
          <div class="d-flex align-items-center gap-2 flex-wrap" id="paginationControls"></div>
        </div>
      </div>
    </div>
  </main>
  <!-- Modal: Adicionar Material -->
  <div class="modal fade" id="modalAddMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formAddMaterial">
        <div class="modal-header">
          <h5 class="modal-title">Adicionar material</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label">Material</label>
            <input class="form-control" name="material" required>
          </div>

          <div class="mb-2">
            <label class="form-label d-flex align-items-center justify-content-between">
              <span>Tipo</span>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNovoTipo" title="Adicionar tipo">+</button>
            </label>

            <select class="form-select" name="tipo" id="addTipoSelect" required>
              <option value="" selected disabled>Selecione...</option>
            </select>

            <div class="mt-2" id="novoTipoBox" style="display:none;">
              <div class="input-group">
                <input class="form-control" id="novoTipoInput" placeholder="Novo tipo (ex: Fonte, Memória...)">
                <button class="btn btn-outline-primary" type="button" id="btnSalvarNovoTipo">OK</button>
                <button class="btn btn-outline-secondary" type="button" id="btnCancelarNovoTipo">Cancelar</button>
              </div>
              <small class="text-muted">Ao salvar um material com esse tipo, ele passa a aparecer em todo o
                sistema.</small>
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label">Marca</label>
            <input class="form-control" name="marca">
          </div>

          <div class="mb-2">
            <label class="form-label">Especificação</label>
            <input class="form-control" name="especificacao" placeholder="Ex: 300W, DDR4 8GB, SSD 240GB...">
          </div>

          <div class="row g-2">
            <div class="col-12">
              <label class="form-label">Qtd disponível</label>
              <input class="form-control" type="number" name="quantidade_disponivel" min="0" value="0" required>
              <small class="text-muted">Qtd em uso é ajustada automaticamente por procedimentos e recuperações.</small>
            </div>
          </div>

          <div class="mt-2">
            <label class="form-label">NF</label>
            <input class="form-control" name="nf">
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary" type="submit" id="btnSalvarMaterial">Salvar</button>
        </div>
      </form>
    </div>
  </div>
  <!-- Modal: Detalhes do Material (consulta) -->
  <div class="modal fade" id="modalDetalhesMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Detalhes do material</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <div><strong>Material:</strong> <span id="detMatNome">-</span></div>
            <div class="text-muted"><span id="detMatLinha">-</span></div>
            <div class="row g-3 mt-2">
              <div class="col-md-3">
                <div><strong>Em uso:</strong> <span id="detMatTotalUso">0</span></div>
              </div>
              <div class="col-md-3">
                <div><strong>Disponível:</strong> <span id="detMatTotalDisponivel">0</span></div>
              </div>
              <div class="col-md-3">
                <div><strong>Baixado:</strong> <span id="detMatTotalBaixado">0</span></div>
              </div>
              <div class="col-md-3">
                <div><strong>Recuperado:</strong> <span id="detMatTotalRecuperado">0</span></div>
              </div>
            </div>
          </div>

          <h6 class="mb-2">Em uso nas máquinas</h6>
          <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
              <thead>
                <tr>
                  <th style="width: 160px;">Patrimônio</th>
                  <th>Specs</th>
                  <th style="width: 120px;">Unidade</th>
                </tr>
              </thead>
              <tbody id="tbodyUsoMaquinas">
                <tr>
                  <td colspan="3" class="text-muted p-2">Carregando...</td>
                </tr>
              </tbody>

            </table>
          </div>
          <hr class="my-4">

          <h6 class="mb-2">Itens recuperados</h6>
          <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
              <thead>
                <tr>
                  <th style="width: 160px;">Origem</th>
                  <th style="width: 100px;">Qtd</th>
                  <th style="width: 180px;">Data</th>
                  <th style="width: 140px;">Manutenção</th>
                </tr>
              </thead>
              <tbody id="tbodyRecuperados">
                <tr>
                  <td colspan="4" class="text-muted p-2">Carregando...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <hr class="my-4">
          <h6 class="mb-2">Itens baixados</h6>
          <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
              <thead>
                <tr>
                  <th style="width: 160px;">Patrimônio</th>
                  <th>Motivo</th>
                  <th style="width: 100px;">Qtd</th>
                  <th style="width: 180px;">Data</th>
                  <th style="width: 140px;">Manutenção</th>
                </tr>
              </thead>
              <tbody id="tbodyBaixados">
                <tr>
                  <td colspan="5" class="text-muted p-2">Carregando...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal: Editar Material -->
  <div class="modal fade" id="modalEditMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="formEditMaterial">
        <div class="modal-header">
          <h5 class="modal-title">Editar material</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="id" id="editId">

          <div class="mb-2">
            <label class="form-label">Material</label>
            <input class="form-control" name="material" id="editMaterial" required>
          </div>

          <div class="mb-2">
            <label class="form-label">Tipo</label>
            <input class="form-control" name="tipo" id="editTipo" required>
          </div>

          <div class="mb-2">
            <label class="form-label">Marca</label>
            <input class="form-control" name="marca" id="editMarca">
          </div>

          <div class="mb-2">
            <label class="form-label">Especificação</label>
            <input class="form-control" name="especificacao" id="editEspecificacao">
          </div>

          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">Qtd disponível</label>
              <input class="form-control" type="number" id="editQtdDisp" min="0" readonly>
              <small class="text-muted">Controlado automaticamente por entradas, baixas e recuperações.</small>
            </div>
            <div class="col-6">
              <label class="form-label">Qtd em uso</label>
              <input class="form-control" type="number" id="editQtdUso" readonly>
              <small class="text-muted">Controlado automaticamente por procedimentos e recuperações.</small>
            </div>
          </div>

          <div class="mt-2">
            <label class="form-label">NF</label>
            <input class="form-control" name="nf" id="editNF">
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary" type="submit" id="btnAtualizarMaterial">Atualizar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function fetchJson(url, opts) {
      const res = await fetch(url, opts);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || 'Erro na requisição');
      return data;
    }

    const tbody = document.getElementById('tbodyMateriais');
    const filtroTipo = document.getElementById('filtroTipo');
    const q = document.getElementById('q');
    const somenteDisponivel = document.getElementById('somenteDisponivel');
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    const totalMateriais = document.getElementById('totalMateriais');
    const pageInfo = document.getElementById('pageInfo');
    const paginationControls = document.getElementById('paginationControls');
    let currentMeta = {
      total: 0,
      page: 1,
      totalPages: 1,
      limit: 20,
    };
    let currentOrder = {
      coluna: 'tipo',
      asc: true,
    };

    function debounce(fn, wait = 300) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn(...args), wait);
      };
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    const carregarMateriaisDebounced = debounce(() => carregarMateriais(1), 300);
    async function carregarTipos() {
      const tipos = await fetchJson('/materiais-tipos');

      // filtro do topo
      filtroTipo.innerHTML = '<option value="">Todos os tipos</option>';
      tipos.forEach((t) => {
        const opt = document.createElement('option');
        opt.value = t;
        opt.textContent = t;
        filtroTipo.appendChild(opt);
      });

      // select do modal adicionar
      const addTipoSelect = document.getElementById('addTipoSelect');
      if (addTipoSelect) {
        const current = addTipoSelect.value;
        addTipoSelect.innerHTML = '<option value="" selected disabled>Selecione...</option>';
        tipos.forEach((t) => {
          const opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          addTipoSelect.appendChild(opt);
        });
        if (current) addTipoSelect.value = current; // tenta manter seleção
      }
    }

    function atualizarContadores(total, visiveis) {
      totalMateriais.textContent = `Materiais exibidos: ${visiveis} / Total: ${total}`;
    }

    function atualizarInfoPaginacao() {
      pageInfo.textContent = `Página ${currentMeta.page} de ${currentMeta.totalPages}`;
    }

    function criarBotaoPagina(label, page, disabled = false, active = false) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `btn btn-sm ${active ? 'btn-primary' : 'btn-outline-secondary'}`;
      btn.textContent = label;
      btn.disabled = disabled;
      btn.addEventListener('click', () => {
        if (!disabled) carregarMateriais(page);
      });
      return btn;
    }

    function renderizarPaginacao() {
      paginationControls.innerHTML = '';

      const totalPages = currentMeta.totalPages || 1;
      const currentPage = currentMeta.page || 1;

      paginationControls.appendChild(
        criarBotaoPagina('Anterior', currentPage - 1, currentPage <= 1)
      );

      const startPage = Math.max(1, currentPage - 2);
      const endPage = Math.min(totalPages, currentPage + 2);

      for (let page = startPage; page <= endPage; page++) {
        paginationControls.appendChild(
          criarBotaoPagina(String(page), page, false, page === currentPage)
        );
      }

      paginationControls.appendChild(
        criarBotaoPagina('Próxima', currentPage + 1, currentPage >= totalPages)
      );

      atualizarInfoPaginacao();
    }

    async function carregarMateriais(page = 1) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-muted p-3">Carregando...</td></tr>';

      const params = new URLSearchParams();
      if (filtroTipo.value) params.set('tipo', filtroTipo.value);
      if (somenteDisponivel.checked) params.set('somenteDisponivel', '1');
      if (q.value && q.value.trim()) params.set('q', q.value.trim());
      params.set('page', String(page));
      params.set('limit', String(pageSizeSelect.value || 20));
      params.set('sortBy', currentOrder.coluna || 'tipo');
      params.set('sortDir', currentOrder.asc ? 'ASC' : 'DESC');

      const resultado = await fetchJson('/materiais-data?' + params.toString());
      const list = Array.isArray(resultado.rows) ? resultado.rows : [];
      currentMeta = {
        total: Number(resultado.total || 0),
        page: Number(resultado.page || 1),
        totalPages: Number(resultado.totalPages || 1),
        limit: Number(resultado.limit || pageSizeSelect.value || 20),
      };

      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-muted p-3">Nenhum material encontrado.</td></tr>';
        atualizarContadores(currentMeta.total, 0);
        renderizarPaginacao();
        atualizarSetasOrdenacao();
        return;
      }

      tbody.innerHTML = '';
      list.forEach((m) => {
        const tr = document.createElement('tr');
        const materialLabel = escapeHtml(m.material || '-');
        const tipoLabel = escapeHtml(m.tipo || '-');
        const especificacaoLabel = escapeHtml(m.especificacao || '-');
        const nfLabel = escapeHtml(m.nf || '-');
        tr.innerHTML = `
        <td>${materialLabel}</td>
        <td>${tipoLabel}</td>
        <td>${especificacaoLabel}</td>
        <td><strong>${m.quantidade_disponivel ?? 0}</strong></td>
        <td>${m.quantidade_em_uso ?? 0}</td>
        <td>${nfLabel}</td>
        <td>
        <div class="btn-group m-2 align-items-center" role="group">
          <button class="btn btn-primary btn-sm btn-edit" data-action="edit">
            <i class="fas fa-pencil-alt"></i> Editar
          </button>
          <button class="btn m-1 btn-info btn-sm" data-action="detalhes">
            <i class="fas fa-eye"></i> Detalhes
          </button>
        </div>
        </td>
      `;
        tr.dataset.json = JSON.stringify(m);
        tbody.appendChild(tr);
      });

      atualizarContadores(currentMeta.total, list.length);
      renderizarPaginacao();
      atualizarSetasOrdenacao();
    }

    function ordenarTabela(coluna) {
      if (currentOrder.coluna === coluna) {
        currentOrder.asc = !currentOrder.asc;
      } else {
        currentOrder.coluna = coluna;
        currentOrder.asc = true;
      }

      carregarMateriais(1);
    }

    function atualizarSetasOrdenacao() {
      const ths = document.querySelectorAll('th[data-sort-col]');
      ths.forEach((th) => {
        const span = th.querySelector('.sort-indicator');
        if (!span) return;

        span.innerHTML = '';
        const col = th.getAttribute('data-sort-col');
        if (col === currentOrder.coluna) {
          span.innerHTML = currentOrder.asc
            ? '<i class="fas fa-sort-up" style="margin-left:6px;"></i>'
            : '<i class="fas fa-sort-down" style="margin-left:6px;"></i>';
        }
      });
    }

    // criar
    document.getElementById('formAddMaterial').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnSalvarMaterial');
      btn.disabled = true;

      try {
        const fd = new FormData(e.target);
        const payload = Object.fromEntries(fd.entries());

        payload.quantidade_disponivel = Number(payload.quantidade_disponivel || 0);
        payload.quantidade_em_uso = 0; // ✅ fixo no adicionar

        await fetchJson('/materiais', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload),
        });

        bootstrap.Modal.getInstance(document.getElementById('modalAddMaterial')).hide();
        e.target.reset();
        await carregarTipos();
        await carregarMateriais(currentMeta.page);
      } catch (err) {
        alert(err.message || 'Erro ao criar material.');
      } finally {
        btn.disabled = false;
      }
    });

    // abrir modal editar
    tbody?.addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-action]');
      if (!btn) return;

      const tr = btn.closest('tr');
      const m = JSON.parse(tr.dataset.json);
      const action = btn.getAttribute('data-action');

      if (action === 'edit') {
        document.getElementById('editId').value = m.id;
        document.getElementById('editMaterial').value = m.material || '';
        document.getElementById('editTipo').value = m.tipo || '';
        document.getElementById('editMarca').value = m.marca || '';
        document.getElementById('editEspecificacao').value = m.especificacao || '';
        document.getElementById('editQtdDisp').value = m.quantidade_disponivel ?? 0;
        document.getElementById('editQtdUso').value = m.quantidade_em_uso ?? 0;
        document.getElementById('editNF').value = m.nf || '';
        new bootstrap.Modal(document.getElementById('modalEditMaterial')).show();
        return;
      }

      if (action === 'detalhes') {
        // cabeçalho do modal
        document.getElementById('detMatNome').textContent = m.material || '-';
        document.getElementById('detMatLinha').textContent = [m.tipo, m.marca, m.especificacao, m.nf ? `NF: ${m.nf}` : null]
          .filter(Boolean)
          .join(' | ') || '-';

        const tbodyUso = document.getElementById('tbodyUsoMaquinas');
        const tbodyRecuperados = document.getElementById('tbodyRecuperados');

        document.getElementById('detMatTotalUso').textContent = String(m.quantidade_em_uso ?? 0);
        document.getElementById('detMatTotalDisponivel').textContent = String(m.quantidade_disponivel ?? 0);
        document.getElementById('detMatTotalBaixado').textContent = String(m.quantidade_baixada ?? 0);
        document.getElementById('detMatTotalRecuperado').textContent = '0';

        tbodyRecuperados.innerHTML = `<tr><td colspan="3" class="text-muted p-2">Carregando...</td></tr>`;
        tbodyBaixados.innerHTML = `<tr><td colspan="4" class="text-muted p-2">Carregando...</td></tr>`;

        // abre modal imediatamente e carrega dados
        new bootstrap.Modal(document.getElementById('modalDetalhesMaterial')).show();

        try {
          const data = await fetchJson(`/materiais/${m.id}/uso-por-maquina`);
          document.getElementById('detMatTotalUso').textContent = String(data.totalEmUso ?? 0);

          if (!data.porMaquina || !data.porMaquina.length) {
            tbodyUso.innerHTML = `<tr><td colspan="3" class="text-muted p-2">Nenhuma máquina encontrada.</td></tr>`;
          } else {
            tbodyUso.innerHTML = '';

            data.porMaquina.forEach((row) => {
              const patrimonio = row.patrimonio || `ID ${row.computadorId}`;
              const specs = row.specs || '-';
              const unidade = row.unidade ?? 0;

              const tr2 = document.createElement('tr');
              tr2.innerHTML = `
                <td>${patrimonio}</td>
                <td style="white-space: pre-wrap;">${specs}</td>
                <td><strong>${unidade}</strong></td>
              `;
              tbodyUso.appendChild(tr2);
            });
          }
        } catch (err) {
          tbodyUso.innerHTML = `<tr><td colspan="3" class="text-danger p-2">Erro: ${err.message}</td></tr>`;
        }

        try {
          const recuperados = await fetchJson(`/materiais/${m.id}/recuperados`);

          const totalRecuperado = recuperados.reduce((acc, row) => acc + Number(row.quantidade || 0), 0);
          document.getElementById('detMatTotalRecuperado').textContent = String(totalRecuperado);

          if (!recuperados.length) {
            tbodyRecuperados.innerHTML = `<tr><td colspan="5" class="text-muted p-2">Nenhum item recuperado.</td></tr>`;
          } else {
            tbodyRecuperados.innerHTML = '';

            recuperados.forEach((row) => {
              const tr = document.createElement('tr');

              const data = row.createdAt ?
                new Date(row.createdAt).toLocaleString('pt-BR') :
                '-';

              const linkManut = row.manutencaoId ?
                `<a href="/ver-manutencao?id=${row.manutencaoId}" class="btn btn-sm btn-outline-primary">Abrir</a>` :
                '-';

              tr.innerHTML = `
                <td>${row.origem || '-'}</td>
                <td><strong>${row.quantidade ?? 0}</strong></td>
                <td>${data}</td>
                <td>${linkManut}</td>
              `;

              tbodyRecuperados.appendChild(tr);
            });
          }
        } catch (err) {
          tbodyRecuperados.innerHTML = `<tr><td colspan="5" class="text-danger p-2">Erro: ${err.message}</td></tr>`;
        }

        try {
          const baixados = await fetchJson(`/materiais/${m.id}/baixados`);

          if (!baixados.length) {
            tbodyBaixados.innerHTML = `<tr><td colspan="5" class="text-muted p-2">Nenhum item baixado.</td></tr>`;
          } else {
            tbodyBaixados.innerHTML = '';

            baixados.forEach((row) => {
              const tr3 = document.createElement('tr');

              const data = row.createdAt ?
                new Date(row.createdAt).toLocaleString('pt-BR') :
                '-';
              const linkManut = row.manutencaoId ?
                `<a href="/ver-manutencao?id=${row.manutencaoId}" class="btn btn-sm btn-outline-primary">Abrir</a>` :
                '-';
              tr3.innerHTML = `
                <td>${row.patrimonio || '-'}</td>
                <td style="white-space: pre-wrap;">${row.motivo || '-'}</td>
                <td><strong>${row.quantidade ?? 0}</strong></td>
                <td>${data}</td>
                <td>${linkManut}</td>
             
              `;

              tbodyBaixados.appendChild(tr3);
            });
          }
        } catch (err) {
          tbodyBaixados.innerHTML = `<tr><td colspan="5" class="text-danger p-2">Erro: ${err.message}</td></tr>`;
        }
      }
    });

    // atualizar
    document.getElementById('formEditMaterial').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnAtualizarMaterial');
      btn.disabled = true;

      try {
        const id = document.getElementById('editId').value;
        const payload = {
          material: document.getElementById('editMaterial').value,
          tipo: document.getElementById('editTipo').value,
          marca: document.getElementById('editMarca').value,
          especificacao: document.getElementById('editEspecificacao').value,
          nf: document.getElementById('editNF').value,
        };

        await fetchJson('/materiais/' + id, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload),
        });

        bootstrap.Modal.getInstance(document.getElementById('modalEditMaterial')).hide();
        await carregarTipos();
        await carregarMateriais(currentMeta.page);
      } catch (err) {
        alert(err.message || 'Erro ao atualizar material.');
      } finally {
        btn.disabled = false;
      }
    });

    q.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        await carregarMateriais(1);
      }
    });

    document.addEventListener('DOMContentLoaded', async () => {
      const sortableHeaders = [
        { index: 0, sortBy: 'material' },
        { index: 1, sortBy: 'tipo' },
        { index: 2, sortBy: 'especificacao' },
        { index: 3, sortBy: 'quantidade_disponivel' },
        { index: 4, sortBy: 'quantidade_em_uso' },
        { index: 5, sortBy: 'nf' },
      ];
      const btnNovoTipo = document.getElementById('btnNovoTipo');
      const novoTipoBox = document.getElementById('novoTipoBox');
      const novoTipoInput = document.getElementById('novoTipoInput');
      const btnSalvarNovoTipo = document.getElementById('btnSalvarNovoTipo');
      const btnCancelarNovoTipo = document.getElementById('btnCancelarNovoTipo');
      const addTipoSelect = document.getElementById('addTipoSelect');
      const ths = document.querySelectorAll('table thead th');

      sortableHeaders.forEach(({ index, sortBy }) => {
        const th = ths[index];
        if (!th) return;

        th.style.cursor = 'pointer';
        th.dataset.sortCol = sortBy;

        if (!th.querySelector('.sort-indicator')) {
          const span = document.createElement('span');
          span.className = 'sort-indicator';
          th.appendChild(document.createTextNode(' '));
          th.appendChild(span);
        }

        th.onclick = () => ordenarTabela(sortBy);
      });

      btnNovoTipo?.addEventListener('click', () => {
        novoTipoBox.style.display = 'block';
        novoTipoInput.value = '';
        novoTipoInput.focus();
      });

      btnCancelarNovoTipo?.addEventListener('click', () => {
        novoTipoBox.style.display = 'none';
      });

      btnSalvarNovoTipo?.addEventListener('click', () => {
        const v = (novoTipoInput.value || '').trim();
        if (!v) return;

        // cria option no select e seleciona
        const exists = Array.from(addTipoSelect.options).some(o => (o.value || '').toLowerCase() === v.toLowerCase());
        if (!exists) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          addTipoSelect.appendChild(opt);
        }

        addTipoSelect.value = v;
        novoTipoBox.style.display = 'none';
      });
      await carregarTipos();
      await carregarMateriais(1);
    });
    window.ordenarTabela = ordenarTabela;
    window.ordenarPor = ordenarTabela;
    q.addEventListener('input', () => carregarMateriaisDebounced());
    filtroTipo.addEventListener('change', () => carregarMateriaisDebounced());
    somenteDisponivel.addEventListener('change', () => carregarMateriaisDebounced());
    pageSizeSelect.addEventListener('change', () => carregarMateriais(1));
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
