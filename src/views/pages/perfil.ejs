<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Perfil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>

  <main class="container mt-4 page-shell-sm">
    <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="card soft-card mb-4">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Perfil</h1>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="mb-2"><strong>Nome:</strong> <%= user?.nome || '-' %></div>
            <div class="mb-2"><strong>Email:</strong> <%= user?.email || '-' %></div>
          </div>
          <div class="col-md-6">
            <div class="mb-2"><strong>Perfil:</strong> <%= user?.role || '-' %></div>
            <div class="mb-0"><strong>Status:</strong> <%= user?.ativo ? 'Ativo' : 'Inativo' %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card soft-card mb-4">
      <div class="card-body p-4">
        <h2 class="h4 mb-4">Preferencias</h2>

        <form action="/perfil/preferencias" method="post">
          <div class="row g-4">
            <div class="col-lg-6">
              <label for="addComputerDefaultModal" class="form-label">Ao clicar em "Adicionar Computador"</label>
              <select class="form-select" id="addComputerDefaultModal" name="addComputerDefaultModal">
                <option value="structured" <%= user?.add_computer_default_modal === 'structured' ? 'selected' : '' %>>Abrir cadastro manual</option>
                <option value="single" <%= user?.add_computer_default_modal === 'single' ? 'selected' : '' %>>Abrir importacao unica</option>
                <option value="batch" <%= user?.add_computer_default_modal === 'batch' ? 'selected' : '' %>>Abrir importar grupo</option>
              </select>
              <small class="text-muted">Define qual modal abre primeiro na tela de computadores.</small>
            </div>

            <div class="col-12">
              <hr class="my-0">
            </div>

            <div class="col-12">
              <h3 class="h5 mb-3">Home</h3>
              <p class="text-muted mb-0">Essas mesmas configuracoes continuam editaveis no filtro da home e agora tambem ficam salvas aqui no perfil.</p>
            </div>

            <div class="col-md-6">
              <div class="home-filter-card h-100">
                <div class="home-filter-head">
                  <h6 class="mb-0">Empresas com Mais Manutencoes</h6>
                  <div class="home-filter-actions">
                    <button type="button" class="btn btn-link btn-sm p-0" data-profile-filter-check-all="ranking">Marcar todas</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-profile-filter-clear-all="ranking">Limpar</button>
                  </div>
                </div>
                <div class="home-filter-list">
                  <% (empresasFiltro || []).forEach(function(empresa) { %>
                  <label class="home-filter-option">
                    <input
                      class="form-check-input me-2"
                      type="checkbox"
                      value="<%= empresa.id %>"
                      name="homeRankingEmpresaIds"
                      data-profile-filter-chart="ranking"
                      <%= (homeDashboardPreferences?.ranking || []).includes(Number(empresa.id)) ? 'checked' : '' %>>
                    <span><%= empresa.nome %></span>
                    <small><%= empresa.nomeCompleto %></small>
                  </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="home-filter-card h-100">
                <div class="home-filter-head">
                  <h6 class="mb-0">Maquinas Ativas por Empresa</h6>
                  <div class="home-filter-actions">
                    <button type="button" class="btn btn-link btn-sm p-0" data-profile-filter-check-all="maquinas">Marcar todas</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-profile-filter-clear-all="maquinas">Limpar</button>
                  </div>
                </div>
                <div class="home-filter-list">
                  <% (empresasFiltro || []).forEach(function(empresa) { %>
                  <label class="home-filter-option">
                    <input
                      class="form-check-input me-2"
                      type="checkbox"
                      value="<%= empresa.id %>"
                      name="homeMaquinasEmpresaIds"
                      data-profile-filter-chart="maquinas"
                      <%= (homeDashboardPreferences?.maquinas || []).includes(Number(empresa.id)) ? 'checked' : '' %>>
                    <span><%= empresa.nome %></span>
                    <small><%= empresa.nomeCompleto %></small>
                  </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Ignorar descricoes no ranking de manutencoes</h6>
                </div>
                <p class="text-muted mb-3">
                  Uma linha por termo. O grafico principal da home ignora manutencoes cuja descricao contenha esses textos.
                </p>
                <textarea
                  class="form-control"
                  id="perfilHomeRankingIgnoredDescriptions"
                  name="homeRankingIgnoredDescriptions"
                  rows="4"
                  placeholder="Um termo por linha&#10;teste&#10;erro"><%= (homeDashboardPreferences?.rankingIgnoredDescriptions || []).join('\n') %></textarea>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Templates de descricao da manutencao</h6>
                </div>
                <p class="text-muted mb-3">
                  Uma linha por template. Essas opcoes aparecem no campo "Descricao pronta" ao abrir uma manutencao.
                </p>
                <textarea
                  class="form-control"
                  id="perfilHomeMaintenanceDescriptionTemplates"
                  name="homeMaintenanceDescriptionTemplates"
                  rows="6"
                  placeholder="Um template por linha&#10;Limpeza preventiva&#10;Erro de funcionamento"><%= (homeDashboardPreferences?.maintenanceDescriptionTemplates || []).join('\n') %></textarea>
              </div>
            </div>

            <div class="col-12">
              <div class="home-filter-card">
                <div class="home-filter-head">
                  <h6 class="mb-0">Ordem dos graficos da home</h6>
                </div>
                <p class="text-muted mb-3">A ordem salva aqui e a mesma usada no carrossel da home.</p>
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label" for="perfilHomeChartOrderFirst">Primeiro grafico</label>
                    <select class="form-select" id="perfilHomeChartOrderFirst" name="homeChartOrderFirst">
                      <option value="ranking" <%= (homeDashboardPreferences?.order || [])[0] === 'ranking' ? 'selected' : '' %>>Empresas com Mais Manutencoes</option>
                      <option value="maquinas" <%= (homeDashboardPreferences?.order || [])[0] === 'maquinas' ? 'selected' : '' %>>Maquinas Ativas por Empresa</option>
                      <option value="materiais" <%= (homeDashboardPreferences?.order || [])[0] === 'materiais' ? 'selected' : '' %>>Materiais Disponiveis por Tipo</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label" for="perfilHomeChartOrderSecond">Segundo grafico</label>
                    <select class="form-select" id="perfilHomeChartOrderSecond" name="homeChartOrderSecond">
                      <option value="ranking" <%= (homeDashboardPreferences?.order || [])[1] === 'ranking' ? 'selected' : '' %>>Empresas com Mais Manutencoes</option>
                      <option value="maquinas" <%= (homeDashboardPreferences?.order || [])[1] === 'maquinas' ? 'selected' : '' %>>Maquinas Ativas por Empresa</option>
                      <option value="materiais" <%= (homeDashboardPreferences?.order || [])[1] === 'materiais' ? 'selected' : '' %>>Materiais Disponiveis por Tipo</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label" for="perfilHomeChartOrderThird">Terceiro grafico</label>
                    <select class="form-select" id="perfilHomeChartOrderThird" name="homeChartOrderThird">
                      <option value="ranking" <%= (homeDashboardPreferences?.order || [])[2] === 'ranking' ? 'selected' : '' %>>Empresas com Mais Manutencoes</option>
                      <option value="maquinas" <%= (homeDashboardPreferences?.order || [])[2] === 'maquinas' ? 'selected' : '' %>>Maquinas Ativas por Empresa</option>
                      <option value="materiais" <%= (homeDashboardPreferences?.order || [])[2] === 'materiais' ? 'selected' : '' %>>Materiais Disponiveis por Tipo</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 d-flex justify-content-end">
              <button type="submit" class="btn btn-primary">Salvar preferencias</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <% if (isAdmin) { %>
    <div class="card soft-card mb-4">
      <div class="card-body p-4">
        <h2 class="h4 mb-4">Cadastrar novo usuario</h2>

        <form action="/perfil/usuarios" method="post">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="novoUsuarioNome" class="form-label">Login / nome</label>
              <input type="text" class="form-control" id="novoUsuarioNome" name="nome" required>
            </div>

            <div class="col-md-4">
              <label for="novoUsuarioEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="novoUsuarioEmail" name="email" required>
            </div>

            <div class="col-md-4">
              <label for="novoUsuarioPassword" class="form-label">Senha inicial</label>
              <input type="password" class="form-control" id="novoUsuarioPassword" name="password" minlength="6" required>
            </div>

            <div class="col-md-4">
              <label for="novoUsuarioRole" class="form-label">Perfil</label>
              <select class="form-select" id="novoUsuarioRole" name="role">
                <option value="tecnico" selected>Tecnico</option>
                <option value="admin">Admin</option>
              </select>
            </div>

            <div class="col-md-4">
              <label for="novoUsuarioAtivo" class="form-label">Status</label>
              <select class="form-select" id="novoUsuarioAtivo" name="ativo">
                <option value="1" selected>Ativo</option>
                <option value="0">Inativo</option>
              </select>
            </div>

            <div class="col-12 d-flex justify-content-end">
              <button type="submit" class="btn btn-primary">Cadastrar usuario</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="card soft-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
          <h2 class="h4 mb-0">Usuarios cadastrados</h2>
          <span class="text-muted"><%= users.length %> usuario(s)</span>
        </div>

        <% if (!users.length) { %>
        <div class="alert alert-light border mb-0">Nenhum usuario cadastrado.</div>
        <% } %>

        <% users.forEach((item) => { %>
        <form action="/perfil/usuarios/<%= item.id %>" method="post" class="border rounded-3 p-3 mb-3">
          <div class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
              <label class="form-label">Login / nome</label>
              <input type="text" class="form-control" name="nome" value="<%= item.nome %>" required>
            </div>

            <div class="col-lg-3 col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" value="<%= item.email %>" required>
            </div>

            <div class="col-lg-2 col-md-4">
              <label class="form-label">Perfil</label>
              <select class="form-select" name="role">
                <option value="tecnico" <%= item.role === 'tecnico' ? 'selected' : '' %>>Tecnico</option>
                <option value="admin" <%= item.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select>
            </div>

            <div class="col-lg-2 col-md-4">
              <label class="form-label">Status</label>
              <select class="form-select" name="ativo">
                <option value="1" <%= item.ativo ? 'selected' : '' %>>Ativo</option>
                <option value="0" <%= !item.ativo ? 'selected' : '' %>>Inativo</option>
              </select>
            </div>

            <div class="col-lg-2 col-md-4">
              <label class="form-label">Nova senha</label>
              <input type="password" class="form-control" name="password" minlength="6" placeholder="Opcional">
            </div>

            <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <small class="text-muted">ID <%= item.id %> • <%= item.ativo ? 'Usuario ativo' : 'Usuario inativo' %></small>
              <button type="submit" class="btn btn-outline-dark">Salvar alteracoes</button>
            </div>
          </div>
        </form>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div class="card soft-card">
      <div class="card-body p-4">
        <h2 class="h5 mb-2">Gestao de usuarios</h2>
        <p class="mb-0 text-muted">Somente administradores podem cadastrar ou editar usuarios.</p>
      </div>
    </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('[data-profile-filter-check-all]').forEach((btn) => {
        btn.addEventListener('click', function() {
          const chartKey = this.getAttribute('data-profile-filter-check-all');
          document.querySelectorAll(`input[data-profile-filter-chart="${chartKey}"]`).forEach((input) => {
            input.checked = true;
          });
        });
      });

      document.querySelectorAll('[data-profile-filter-clear-all]').forEach((btn) => {
        btn.addEventListener('click', function() {
          const chartKey = this.getAttribute('data-profile-filter-clear-all');
          document.querySelectorAll(`input[data-profile-filter-chart="${chartKey}"]`).forEach((input) => {
            input.checked = false;
          });
        });
      });
    });
  </script>
</body>

</html>
