<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lista de Manutenções</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>

<body>
  <header class="headerComponent">
    <%- include("../partials/header.ejs") %>
  </header>
  <main>
    <div class="container mt-4">
      <a href="javascript:history.back()" class="btn btn-back">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div class="text-center align-items-center">
        <h1 class="mt-4 mb-4">Lista de Manutenções</h1>

        <button type="button" style="font-size: 0.75rem" class="btn btn-secondary btn-lg btn-block mb-2" data-bs-toggle="modal" data-bs-target="#modalRegisterManutencao">
          Registrar Manutenção
        </button>

        <div class="mt-3 mb-2">
          <small class="text-muted" id="totalManutencoes">Manutenções exibidas: 0 / Total: 0</small>
        </div>

        <div class="row mb-4">
          <div class="col-md-4">
            <label for="statusFiltro" class="form-label">Filtrar por Status:</label>
            <select id="statusFiltro" class="form-select">
              <option value="todas">Todas as manutenções</option>
              <option value="todas_sem_condenados" selected>Todas sem condenados</option>
              <option value="em_manutencao">Em manutenção</option>
              <option value="finalizadas_sem_condenacao">Já finalizadas</option>
              <option value="condenados">Condenados</option>
            </select>
          </div>

          <div class="col-md-4">
            <label for="empresaFiltro" class="form-label">Filtrar por Empresa:</label>
            <select id="empresaFiltro" class="form-select">
              <option value="todas" selected>Todas as Empresas</option>
              <% empresas.forEach(function(empresa) { %>
              <option value="<%= empresa.nome %>"><%= empresa.nome %></option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4">
            <label for="pageSizeSelect" class="form-label">Máximo por página:</label>
            <select id="pageSizeSelect" class="form-select">
              <option value="10">10</option>
              <option value="20" selected>20</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-12">
            <label for="pesquisaFiltro" class="form-label">Pesquisar:</label>
            <input id="pesquisaFiltro" type="text" class="form-control" placeholder="Patrimônio, empresa, local ou descrição..." />
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-md-6">
            <label for="dataInicioFiltro" class="form-label">Data da manutenção (de):</label>
            <input id="dataInicioFiltro" type="date" class="form-control" />
          </div>

          <div class="col-md-6">
            <label for="dataFimFiltro" class="form-label">Data da manutenção (até):</label>
            <div class="input-group">
              <input id="dataFimFiltro" type="date" class="form-control" />
              <button id="limparDataBtn" class="btn btn-outline-secondary" type="button" title="Limpar datas">
                <i class="fas fa-eraser"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th scope="col" style="cursor: pointer" onclick="ordenarPor('patrimonio')" data-sort-col="1">
                  Número de patrimônio <span class="sort-indicator"></span>
                </th>
                <th scope="col" style="cursor: pointer" onclick="ordenarPor('empresa')" data-sort-col="2">
                  Empresa <span class="sort-indicator"></span>
                </th>
                <th scope="col">Setor</th>
                <th scope="col" style="cursor: pointer" onclick="ordenarPor('descricao')" data-sort-col="4">
                  Descrição <span class="sort-indicator"></span>
                </th>
                <th scope="col" style="cursor: pointer" onclick="ordenarPor('status')" data-sort-col="5">
                  Status <span class="sort-indicator"></span>
                </th>
                <th scope="col" style="cursor: pointer" onclick="ordenarPor('data')" data-sort-col="6">
                  Data da manutenção <span class="sort-indicator"></span>
                </th>
                <th scope="col" class="text-center">Ações</th>
              </tr>
            </thead>

            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
          <small class="text-muted" id="pageInfo">Página 1 de 1</small>
          <div class="d-flex align-items-center gap-2 flex-wrap" id="paginationControls"></div>
        </div>
      </div>
    </div>
  </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/08793a0919.js" crossorigin="anonymous"></script>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const statusFiltro = document.getElementById("statusFiltro");
        const empresaFiltro = document.getElementById("empresaFiltro");
        const searchInput = document.getElementById("pesquisaFiltro");
        const dataDeInput = document.getElementById("dataInicioFiltro");
        const dataAteInput = document.getElementById("dataFimFiltro");
        const limparDataBtn = document.getElementById("limparDataBtn");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const tbody = document.getElementById("tableBody");
        const totalManutencoesEl = document.getElementById("totalManutencoes");
        const pageInfoEl = document.getElementById("pageInfo");
        const paginationControls = document.getElementById("paginationControls");

        let currentMeta = {
          total: 0,
          page: 1,
          totalPages: 1,
          limit: 20,
        };
        let searchDebounce = null;
        let currentOrder = {
          sortBy: 'data',
          sortDir: 'ASC',
          coluna: 6,
        };

        function formatDT(iso) {
          if (!iso) return "-";
          const d = new Date(iso);
          if (Number.isNaN(d.getTime())) return iso;

          const data = d.toLocaleDateString("pt-BR");
          const hora = d.toLocaleTimeString("pt-BR", {
            hour: "2-digit",
            minute: "2-digit"
          });
          return `${data} ${hora}`;
        }

        function atualizarContadores(total, visiveis) {
          totalManutencoesEl.textContent = `Manutenções exibidas: ${visiveis} / Total: ${total}`;
        }

        function atualizarInfoPaginacao() {
          pageInfoEl.textContent = `Página ${currentMeta.page} de ${currentMeta.totalPages}`;
        }

        function criarBotaoPagina(label, page, disabled = false, active = false) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `btn btn-sm ${active ? 'btn-primary' : 'btn-outline-secondary'}`;
          btn.textContent = label;
          btn.disabled = disabled;
          btn.addEventListener("click", () => {
            if (!disabled) carregarManutencoes(page);
          });
          return btn;
        }

        function renderizarPaginacao() {
          paginationControls.innerHTML = "";

          const totalPages = currentMeta.totalPages || 1;
          const currentPage = currentMeta.page || 1;

          paginationControls.appendChild(
            criarBotaoPagina("Anterior", currentPage - 1, currentPage <= 1)
          );

          const startPage = Math.max(1, currentPage - 2);
          const endPage = Math.min(totalPages, currentPage + 2);

          for (let page = startPage; page <= endPage; page++) {
            paginationControls.appendChild(
              criarBotaoPagina(String(page), page, false, page === currentPage)
            );
          }

          paginationControls.appendChild(
            criarBotaoPagina("Próxima", currentPage + 1, currentPage >= totalPages)
          );

          atualizarInfoPaginacao();
        }

        function renderizarLinhas(rows) {
          tbody.innerHTML = "";

          rows.forEach((manutencao) => {
            const statusHtml = manutencao.pcCondenado ?
              '<span class="badge bg-danger">PC CONDENADO</span><span class="visually-hidden">condenado</span>' :
              (manutencao.dataSaida ?
                '<i class="fas fa-square-check text-success"></i><span class="visually-hidden">finalizada</span>' :
                '<i class="fas fa-clock text-warning"></i><span class="visually-hidden">em andamento</span>');

            const row = `
              <tr>
                <td>${manutencao.computadorId} - ${manutencao.pcName ?? "-"}</td>
                <td>${manutencao.empresa ?? "-"}</td>
                <td>${manutencao.local ?? manutencao.setor ?? "-"}</td>
                <td>${manutencao.descricao || "Sem descrição"}</td>
                <td class="align-middle">${statusHtml}</td>
                <td class="align-middle">${formatDT(manutencao.dataManutencao)}</td>
                <td class="align-middle">
                  <div class="btn-group" role="group" aria-label="Ações">
                    <a class="btn btn-outline-info btn-sm" href="/ver-manutencao?id=${manutencao.id}">
                      <i class="fas fa-eye"></i> Ver
                    </a>
                  </div>
                </td>
              </tr>
            `;

            tbody.innerHTML += row;
          });
        }

        function atualizarSetasOrdenacaoManutencoes() {
          const ths = document.querySelectorAll("th[data-sort-col]");
          ths.forEach((th) => {
            const span = th.querySelector(".sort-indicator");
            if (!span) return;

            span.innerHTML = "";
            const col = parseInt(th.getAttribute("data-sort-col"), 10);

            if (col === currentOrder.coluna) {
              span.innerHTML = currentOrder.sortDir === "ASC" ?
                '<i class="fas fa-sort-up" style="margin-left:6px;"></i>' :
                '<i class="fas fa-sort-down" style="margin-left:6px;"></i>';
            }
          });
        }

        async function carregarManutencoes(page = 1) {
          try {
            const params = new URLSearchParams({
              page: String(page),
              limit: String(pageSizeSelect.value || 20),
              q: searchInput.value || "",
              empresa: empresaFiltro.value || "todas",
              status: statusFiltro.value || "todas_sem_condenados",
              dataInicio: dataDeInput.value || "",
              dataFim: dataAteInput.value || "",
              sortBy: currentOrder.sortBy,
              sortDir: currentOrder.sortDir,
            });

            const response = await fetch(`/manutencoes-data?${params.toString()}`);
            const resultado = await response.json();

            const rows = Array.isArray(resultado.rows) ? resultado.rows : [];
            currentMeta = {
              total: Number(resultado.total || 0),
              page: Number(resultado.page || 1),
              totalPages: Number(resultado.totalPages || 1),
              limit: Number(resultado.limit || pageSizeSelect.value || 20),
            };

            renderizarLinhas(rows);
            atualizarContadores(currentMeta.total, rows.length);
            renderizarPaginacao();
            atualizarSetasOrdenacaoManutencoes();
          } catch (error) {
            console.error("Erro ao carregar manutenções:", error);
          }
        }

        function ordenarPor(tipo) {
          const map = {
            patrimonio: 1,
            empresa: 2,
            descricao: 4,
            status: 5,
            data: 6,
          };

          if (currentOrder.sortBy === tipo) {
            currentOrder.sortDir = currentOrder.sortDir === "ASC" ? "DESC" : "ASC";
          } else {
            currentOrder.sortBy = tipo;
            currentOrder.sortDir = "ASC";
          }

          currentOrder.coluna = map[tipo];
          carregarManutencoes(1);
        }

        window.ordenarPor = ordenarPor;
        window.ordenarTabela = () => {};

        statusFiltro.addEventListener("change", () => carregarManutencoes(1));
        empresaFiltro.addEventListener("change", () => carregarManutencoes(1));
        pageSizeSelect.addEventListener("change", () => carregarManutencoes(1));
        dataDeInput.addEventListener("change", () => carregarManutencoes(1));
        dataAteInput.addEventListener("change", () => carregarManutencoes(1));
        limparDataBtn.addEventListener("click", () => {
          dataDeInput.value = "";
          dataAteInput.value = "";
          carregarManutencoes(1);
        });

        searchInput.addEventListener("input", () => {
          clearTimeout(searchDebounce);
          searchDebounce = setTimeout(() => carregarManutencoes(1), 250);
        });

        statusFiltro.value = "todas_sem_condenados";
        carregarManutencoes(1);
      });
    </script>

    <%- include("../partials/modals/modal_register_manutencao") %>
</body>

</html>
